@{
    ViewData["Title"] = "راه‌اندازی مدیر سیستم";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>🔧 راه‌اندازی کاربر مدیر</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Messages != null)
                    {
                        @foreach (var msg in ViewBag.Messages)
                        {
                            if (msg.StartsWith("✅"))
                            {
                                <div class="alert alert-success">@msg</div>
                            }
                            else if (msg.StartsWith("⚠️"))
                            {
                                <div class="alert alert-warning">@msg</div>
                            }
                            else if (msg.StartsWith("❌"))
                            {
                                <div class="alert alert-danger">@msg</div>
                            }
                            else if (msg.StartsWith("🔐"))
                            {
                                <div class="alert alert-info">@msg</div>
                            }
                            else
                            {
                                <div class="alert alert-secondary">@msg</div>
                            }
                        }
                    }
                    <a href="/Setup/CreateAdmin" class="btn btn-primary w-100">🔄 ایجاد مجدد کاربر Admin</a>
                    <hr />
                    <a href="/Account/Login" class="btn btn-success w-100">🔐 رفتن به صفحه ورود</a>
                </div>
            </div>
        </div>
    </div>
</div>
