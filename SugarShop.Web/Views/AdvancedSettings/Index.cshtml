@{
    ViewData["Title"] = "تنظیمات پیشرفته";
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-header">
        <h4>🔧 تنظیمات پیشرفته</h4>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">🌐 تنظیمات عمومی</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="social-tab" data-bs-toggle="tab" data-bs-target="#social" type="button" role="tab">📱 شبکه‌های اجتماعی و گواهینامه‌ها</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="footer-tab" data-bs-toggle="tab" data-bs-target="#footer" type="button" role="tab">📄 فوتر و محتوا</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="theme-tab" data-bs-toggle="tab" data-bs-target="#theme" type="button" role="tab">🎨 تنظیمات ظاهری</button>
            </li>
        </ul>
        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="general" role="tabpanel">
                <iframe src="/SiteSettings#general" style="width:100%; min-height:600px; border:none;"></iframe>
            </div>
            <div class="tab-pane fade" id="social" role="tabpanel">
                <iframe src="/SiteSettings#social" style="width:100%; min-height:600px; border:none;"></iframe>
            </div>
            <div class="tab-pane fade" id="footer" role="tabpanel">
                <iframe src="/SiteSettings#footerContent" style="width:100%; min-height:600px; border:none;"></iframe>
            </div>
            <div class="tab-pane fade" id="theme" role="tabpanel">
                <iframe src="/Admin/Theme" style="width:100%; min-height:600px; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>
