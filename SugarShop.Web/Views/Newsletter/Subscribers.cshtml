@using MD.PersianDateTime
@{
    ViewData["Title"] = "مدیریت مشترکین خبرنامه";
    Layout = "_AdminLayout";
}
@model List<SugarShop.Domain.Entities.Newsletter.Subscriber>
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h4 class="mb-0">📧 لیست مشترکین خبرنامه</h4>
        <a asp-action="Send" class="btn btn-primary">
            <i class="fa fa-paper-plane"></i> ارسال خبرنامه
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ایمیل</th>
                        <th>تاریخ اشتراک</th>
                        <th>وضعیت</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var sub in Model)
                        {
                            <tr>
                                <td>@sub.Email</td>
                                <td>@(new PersianDateTime(sub.CreatedAt).ToString("yyyy/MM/dd HH:mm").ToPersianNumber())</td>
                                <td>
                                    @if (sub.IsActive)
                                    {
                                        <span class="badge bg-success">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">غیرفعال</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="DeleteSubscriber" method="post" onsubmit="return confirm('آیا از حذف این مشترک اطمینان دارید؟');">
                                        <input type="hidden" name="id" value="@sub.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fa fa-trash"></i> حذف
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">مشترکی یافت نشد.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

