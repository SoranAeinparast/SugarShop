@using Microsoft.AspNetCore.Identity
@using SugarShop.Domain.Entities
@{
    ViewData["Title"] = "مدیریت کاربران";
    Layout = "_AdminLayout";
}
@model List<ApplicationUser>
<div class="card">
    <div class="card-header d-flex justify-content-between">
        <h4>👥 لیست کاربران</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>نام کاربری</th>
                        <th>ایمیل</th>
                        <th>نقش‌ها</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="align-middle">@user.UserName</td>
                            <td class="align-middle">@user.Email</td>
                            <td class="align-middle">
                                @{
                                    var roles = ViewBag.UserRoles != null && ViewBag.UserRoles.ContainsKey(user.Id)
                                        ? ((Dictionary<string, List<string>>)ViewBag.UserRoles)[user.Id]
                                        : new List<string>();
                                }
                                @if (roles.Any())
                                {
                                    foreach (var role in roles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">بدون نقش</span>
                                }
                            </td>
                            <td class="align-middle">
                                <a href="@Url.Action("Edit", new { id = user.Id })" class="btn btn-sm btn-warning">✏️ ویرایش نقش</a>
                                <form asp-action="Delete" method="post" style="display:inline-block;" onsubmit="return confirm('حذف شود؟')">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">🗑️ حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
