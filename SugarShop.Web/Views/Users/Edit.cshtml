@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "ویرایش نقش کاربر";
    Layout = "_AdminLayout";
}
@{
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
    var userRoles = ViewBag.UserRoles as IEnumerable<string> ?? new List<string>();
    var userId = ViewBag.UserId as string;
    var userName = ViewBag.UserName as string;
}
<div class="card">
    <div class="card-header">
        <h4>✏️ ویرایش نقش‌های کاربر: @userName</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="id" value="@userId" />
            @foreach (var role in allRoles)
            {
                var isChecked = userRoles.Contains(role);
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="selectedRoles" value="@role" id="role_@role" @(isChecked ? "checked" : "") />
                    <label class="form-check-label" for="role_@role">@role</label>
                </div>
            }
            <div class="mt-3">
                <button type="submit" class="btn btn-success">💾 ذخیره تغییرات</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ انصراف</a>
            </div>
        </form>
    </div>
</div>
