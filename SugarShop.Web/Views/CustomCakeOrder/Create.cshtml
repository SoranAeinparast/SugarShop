@model SugarShop.Domain.Entities.Sales.CustomCakeOrder
@{
    ViewData["Title"] = "سفارش کیک سفارشی";
    Layout = "_Layout";
}
<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h4 class="mb-0">🎂 سفارش کیک سفارشی</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="orderForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">وزن تقریبی (گرم)</label>
                        <input asp-for="WeightGrams" class="form-control" type="number" min="500"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">تعداد نفرات</label>
                        <input asp-for="Servings" class="form-control" type="number" min="1" max="200" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">طعم کیک</label>
                        <input asp-for="Flavor" class="form-control" placeholder="مثال: شکلاتی، وانیلی، میوه‌ای" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">شکل کیک</label>
                        <input asp-for="Shape" class="form-control" placeholder="مثال: گرد، مربع، قلب" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">مواد به کار رفته (اختیاری)</label>
                        <textarea asp-for="Ingredients" class="form-control" rows="2" placeholder="مثلاً: پسته، گردو، خامه، شکلات"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">نوع مراسم</label>
                        <select asp-for="Occasion" class="form-select">
                            <option value="">انتخاب کنید</option>
                            <option>تولد</option>
                            <option>سالگرد ازدواج</option>
                            <option>عروسی</option>
                            <option>نامزدی</option>
                            <option>جشن تولد کودک</option>
                            <option>سایر</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">تاریخ تحویل دلخواه (شمسی)</label>
                        <input type="text" id="deliveryDatePersian" class="form-control persian-date" placeholder="مثال: ۱۴۰۴/۰۳/۱۵" />
                        <input type="hidden" name="desiredDeliveryDatePersian" id="deliveryDatePersianHidden" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">ساعت تحویل</label>
                        <input type="time" name="desiredDeliveryTime" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">توضیحات اضافی</label>
                        <textarea asp-for="SpecialRequests" class="form-control" rows="3" placeholder="هر نکته دیگری که باید بدانیم..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">تصویر نمونه کیک (اختیاری)</label>
                        <input type="hidden" name="SampleImagePath" id="SampleImagePath" value="" />
                        <img id="sampleImagePreview" src="" class="img-thumbnail mb-1" style="max-height:120px; display:none;" />
                        <button type="button" class="btn btn-sm btn-outline-primary open-media-picker" data-target="#SampleImagePath" data-preview="#sampleImagePreview"><i class="bi bi-image"></i> انتخاب از کتابخانه</button>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">تصویر برای چاپ روی کیک (اختیاری)</label>
                        <input type="hidden" name="PrintImagePath" id="PrintImagePath" value="" />
                        <img id="printImagePreview" src="" class="img-thumbnail mb-1" style="max-height:120px; display:none;" />
                        <button type="button" class="btn btn-sm btn-outline-primary open-media-picker" data-target="#PrintImagePath" data-preview="#printImagePreview"><i class="bi bi-image"></i> انتخاب از کتابخانه</button>
                    </div>
                </div>
                <div class="mt-4 d-flex justify-content-between">
                    <button type="submit" class="btn btn-success px-4 rounded-pill">✅ ثبت سفارش</button>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-secondary rounded-pill">🔙 بازگشت</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function() {
            $('#deliveryDatePersian').persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                observer: true,
                onSelect: function() {
                    $('#deliveryDatePersianHidden').val($('#deliveryDatePersian').val());
                }
            });
        });
        $('#orderForm').on('submit', function(e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.includes('orderSuccessModal')) {
                        $('body').append(response);
                    } else {
                        $('#orderForm').html(response);
                    }
                },
                error: function(xhr) {
                    alert('خطایی رخ داد. لطفاً دوباره تلاش کنید.');
                }
            });
        });
    </script>
}
