@model SugarShop.Domain.Entities.Sales.CustomCakeOrder
@{
    ViewData["Title"] = "سفارش کیک سفارشی";
    Layout = "_Layout";
}
<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h4 class="mb-0">🎂 سفارش کیک سفارشی</h4>
        </div>
        <div class="card-body p-4">
            @await Html.PartialAsync("_CreateForm", Model)
        </div>
    </div>
</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    // راه‌اندازی بخش روش دریافت کیک (در محل / پیک + آدرس)
    function initCakeDeliverySection() {
        var pickup = document.getElementById('dmPickup');
        var courier = document.getElementById('dmCourier');
        if (!pickup || !courier) return;

        function refresh() {
            var section = document.getElementById('cakeAddressSection');
            if (section) section.classList.toggle('d-none', !courier.checked);
            document.querySelectorAll('.cake-dm-card').forEach(function(c) { c.classList.remove('bg-light', 'border-primary'); });
            var active = (pickup.checked ? pickup : courier).closest('.cake-dm-card');
            if (active) active.classList.add('bg-light', 'border-primary');
        }

        [pickup, courier].forEach(function(r) { r.addEventListener('change', refresh); });

        var useNew = document.getElementById('cakeUseNewAddress');
        if (useNew) {
            useNew.addEventListener('change', function() {
                var fields = document.getElementById('cakeNewAddressFields');
                if (fields) fields.classList.toggle('d-none', !this.checked);
                if (this.checked) {
                    document.querySelectorAll('.cake-addr-radio').forEach(function(r) { r.checked = false; });
                }
            });
        }
        refresh();
    }

    // راه‌اندازی فیلدهای فرم سفارش کیک (پیکر تاریخ شمسی + پیش‌نمایش تصاویر)
    function initCakeOrderForm() {
        initCakeDeliverySection();
        var $dateInput = $('#deliveryDatePersian');
        if ($dateInput.length && !$dateInput.data('datepicker')) {
            $dateInput.persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                observer: true,
                onSelect: function() {
                    $('#deliveryDatePersianHidden').val($('#deliveryDatePersian').val());
                }
            });
        }

        function setupImagePreview(inputId, previewId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            if (input && preview) {
                input.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            preview.src = e.target.result;
                            preview.style.display = 'block';
                        }
                        reader.readAsDataURL(file);
                    } else {
                        preview.style.display = 'none';
                    }
                });
            }
        }
        setupImagePreview('sampleImageInput', 'sampleImagePreview');
        setupImagePreview('printImageInput', 'printImagePreview');
    }

    // ارسال فرم با AJAX — با event delegation تا پس از جایگزینی فرم (خطای اعتبارسنجی) نیز کار کند
    $(document).on('submit', '#orderForm', function(e) {
        e.preventDefault();
        var $form = $(this);
        var $btn = $form.find('button[type="submit"]');
        $btn.prop('disabled', true).html('⏳ در حال ثبت...');
        var formData = new FormData(this);
        $.ajax({
            url: $form.attr('action'),
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response && typeof response === 'string' && response.indexOf('orderSuccessModal') !== -1) {
                    $('body').append(response);
                    $('#orderSuccessModal').modal('show');
                } else if (response && typeof response === 'string'
                        && response.indexOf('<html') === -1 && response.indexOf('<body') === -1) {
                    // پاسخ اعتبارسنجی: فقط فرم جایگزین می‌شود (بدون layout و بدون تکرار اسکریپت‌ها)
                    $('#orderForm').replaceWith(response);
                    initCakeOrderForm();
                } else {
                    // پاسخ غیرمنتظره (مثلاً ریدایرکت به صفحه ورود): صفحه تازه‌سازی می‌شود
                    window.location.reload();
                }
            },
            error: function(xhr) {
                alert('خطایی رخ داد. لطفاً دوباره تلاش کنید.');
            }
        });
    });

    $(function() {
        initCakeOrderForm();
    });
</script>
}