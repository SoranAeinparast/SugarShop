@using SugarShop.Web.ViewModels
@model CategoryProductsViewModel
@using SugarShop.Web.Extensions
@using MD.PersianDateTime
@{
    ViewData["Title"] = Model.CategoryTitle;
    
    // ✅ خواندن تنظیمات هدر (فقط یک بار)
    var headerSettings = ViewBag.HeaderSettings as SugarShop.Domain.Entities.CategoryHeaderSetting;
}

<partial name="_BoxModal" />

@if (headerSettings != null && headerSettings.IsEnabled)
{
    var displayTitle = !string.IsNullOrEmpty(headerSettings.DefaultTitle) ? headerSettings.DefaultTitle : Model.CategoryTitle;
    // ✅ زیرعنوان هوشمند: اول زیرعنوان مخصوص همان نوع دسته، بعد زیرعنوان عمومی، بعد متن پیش‌فرض
    var displaySubtitle = (Model.RequiresBoxSelection
        ? (headerSettings.BoxSelectionSubtitle ?? headerSettings.DefaultSubtitle)
        : (headerSettings.DefaultSubtitle ?? headerSettings.BoxSelectionSubtitle))
        ?? (Model.RequiresBoxSelection
            ? "✨ روی جعبه‌ای که می‌خوای کلیک کن | می‌توانی تو هر ردیف شیرینی دلخواهت رو بچینی ✨"
            : "🍰 بهترین محصولات با قیمت ثابت و کیفیت تضمینی");
    
    // منطق هوشمند پس‌زمینه: اگر تصویر فعال بود، تصویر + رنگ به عنوان fallback، در غیر این صورت فقط رنگ
    string bgStyle = headerSettings.BackgroundColor;
    if (headerSettings.UseBackgroundImage && !string.IsNullOrEmpty(headerSettings.BackgroundImagePath))
    {
        bgStyle = $"url('{headerSettings.BackgroundImagePath}') center/cover no-repeat, {headerSettings.BackgroundColor}";
    }

    <div class="category-header" style="width: 100vw; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); position: relative; overflow: hidden; min-height: @(headerSettings.Height)px; background: @bgStyle;">
        <div class="container" style="position: relative; z-index: 2;">
            <div class="text-center py-4 py-md-5">
                <h1 class="display-5 fw-bold mb-2" style="color: @headerSettings.TextColor;">@displayTitle</h1>
                @if (!string.IsNullOrEmpty(displaySubtitle))
                {
                    <p class="mb-0" style="font-size: 1.05rem; color: @headerSettings.TextColor; opacity: 0.85;">
                        <span>@displaySubtitle</span>
                    </p>
                }
            </div>
        </div>
    </div>
}
else
{
    @* ✅ هدر پیش‌فرض *@
    <div class="category-header bg-white shadow-sm" style="width: 100vw; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); border-bottom: 1px solid #f0f0f0;">
        <div class="container">
            <div class="text-center py-4 py-md-5">
                <h1 class="display-5 fw-bold mb-2" style="color: #2c3e50;">@Model.CategoryTitle</h1>
                <p class="text-muted mb-0" style="font-size: 1.05rem;">
                    @if (Model.RequiresBoxSelection)
                    { <span>✨ روی جعبه‌ای که می‌خوای کلیک کن | می‌توانی تو هر ردیف شیرینی دلخواهت رو بچینی ✨</span> }
                    else
                    { <span>🍰 بهترین محصولات با قیمت ثابت و کیفیت تضمینی</span> }
                </p>
            </div>
        </div>
    </div>
}
@* ============================================================
   بخش ۲: محتوای اصلی (محصولات) - ادامه فایل بدون تغییر
   ============================================================ *@
<div class="container mt-4 mb-5">
    @if (!Model.Products.Any())
    {
        <div class="alert alert-warning text-center py-5 rounded-4">
            <h4>به زودی محصولات جدید و با کیفیت در این بخش قرار میگیرند</h4>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* ----------------- محصولات ----------------- *@
            @foreach (var product in Model.Products)
            {
                bool isInStock = product.Inventory > 0;
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        @* بخش تصویر *@
                        <div class="product-img-wrapper position-relative"
                             data-product-id="@(product.IsSweet ? null : product.Id)"
                             data-sweet-id="@(product.IsSweet ? product.Id : null)">
                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@product.ImagePath" class="card-img-top product-img" alt="@product.Title" loading="lazy" style="cursor: pointer;">
                            }
                            else
                            {
                                <div class="product-img-placeholder d-flex align-items-center justify-content-center" style="cursor: pointer;">
                                    <span style="font-size: 3rem;">🍪</span>
                                </div>
                            }
                            <div class="position-absolute top-0 end-0 m-2">
                                @if (isInStock)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">موجود</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">قابل سفارش</span>
                                }
                            </div>
                        </div>
                        @* بخش اطلاعات محصول *@
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold mb-2 product-title">@product.Title</h5>
                            @if (product.IsSweet)
                            {
                                <div class="product-meta small text-secondary mb-2">
                                    <div>⚖️ ~@product.ApproxWeightGrams.ToPersianNumber() گرم/عدد</div>
                                    <div>💰 @product.PricePerKg.ToString("N0").ToPersianNumber() تومان/کیلو</div>
                                </div>
                                <div class="mt-1 mb-2">
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">نیازمند جعبه</span>
                                </div>
                            }
                            else
                            {
                                <div class="product-meta small text-secondary mb-2">
                                    @if (product.WeightGrams.HasValue)
                                    {
                                        <div>️ @product.WeightGrams.Value.ToPersianNumber() گرم</div>
                                    }
                                    <div class="price fw-bold text-success fs-5">@product.UnitPrice.ToString("N0").ToPersianNumber() <small class="fw-normal">تومان</small></div>
                                </div>
                                <div class="mt-1 mb-2">
                                    <span class="badge bg-success px-3 py-1 rounded-pill">قیمت ثابت</span>
                                </div>
                            }
                            <div class="mt-auto pt-3">
                                @if (product.IsSweet)
                                {
                                    <button class="btn btn-success w-100 add-to-box-btn rounded-pill py-2" data-sweet-id="@product.Id">
                                        افزودن به جعبه
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-primary w-100 add-to-cart-simple rounded-pill py-2" data-product-id="@product.Id">
                                        🛒 افزودن به سبد خرید
                                    </button>
                                }
                            </div>
                        </div>
                        @* بخش توضیحات *@
                        @if (!string.IsNullOrEmpty(product.Description) || true)
                        {
                            <div class="card-footer bg-transparent border-0 text-center pb-3 pt-0">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill description-btn px-3"
                                        data-desc="@product.Description"
                                        data-img="@product.ImagePath"
                                        data-title="@product.Title"
                                        @(string.IsNullOrEmpty(product.Description) ? "disabled style=opacity:0.5" : "")>
                                    📖 توضیحات
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            @* ----------------- کارت ویژه کیک سفارشی ----------------- *@
            @if (Model.CategorySlug == "cakes")
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card h-100 border-0 shadow-sm rounded-4 overflow-hidden special-cake-card">
                        <div class="product-img-wrapper position-relative" style="background: linear-gradient(135deg, #fff9e6, #ffe6cc);">
                            <div class="d-flex align-items-center justify-content-center h-100">
                                <div class="display-1">🎂✨</div>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold mb-2 product-title">درخواست کیک سفارشی</h5>
                            <div class="product-meta small text-secondary mb-2">
                                <div> با هر طرح و طعمی که دوست داری</div>
                                <div> پخته شده توسط بهترین قنادان</div>
                            </div>
                            <div class="mt-1 mb-2">
                                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">سفارشی</span>
                            </div>
                            <div class="mt-auto pt-3">
                                <a asp-controller="CustomCakeOrder" asp-action="Create" class="btn btn-warning w-100 rounded-pill py-2">
                                    🎂 سفارش دهید
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <div class="text-center mt-5">
        <a href="/" class="btn btn-secondary rounded-pill px-4">↩️ بازگشت به صفحه اصلی</a>
    </div>
</div>

@* پنل شناور جعبه در _BoxModal تعریف شده است (جایگزین دکمه شناور قبلی) *@

<!-- مودال توضیحات محصول -->
<div class="modal fade" id="descModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-0 pb-0 pt-3 px-4">
                <h5 class="modal-title fw-bold" id="descModalTitle">توضیحات محصول</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <img id="descModalImage" src="" alt="تصویر محصول" loading="lazy" class="img-fluid rounded-3" style="max-height: 200px; object-fit: contain;">
                </div>
                <div id="descModalBody" class="text-justify lh-base" style="font-size: 1rem; line-height: 1.6;"></div>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* ==================== هدر دسته‌بندی ==================== */
    .category-header {
        position: relative;
        z-index: 1;
    }
    

    /* ==================== استایل کارت محصولات ==================== */
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: white;
        border-radius: 1rem !important;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 420px;
    }
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,0.12) !important;
    }
    .product-img-wrapper {
        overflow: hidden;
        background-color: #f8f9fa;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        flex-shrink: 0;
        height: 220px;
    }
    .product-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .product-card:hover .product-img {
        transform: scale(1.05);
    }
    .product-img-placeholder {
        height: 220px;
        background: #fef9e6;
        color: #d4a056;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-title {
        min-height: 48px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 1rem;
        line-height: 1.4;
    }
    .product-meta div {
        margin-bottom: 4px;
    }
    .price {
        font-size: 1.25rem;
    }
    .badge {
        font-weight: 500;
        font-size: 0.75rem;
    }
    .card-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }
    .mt-auto {
        margin-top: auto !important;
    }
    
    /* ==================== استایل دکمه‌ها ==================== */
    .btn {
        transition: all 0.2s;
    }
    .btn-primary {
        background-color: #d4a056;
        border-color: #d4a056;
    }
    .btn-primary:hover {
        background-color: #b8860b;
        border-color: #b8860b;
        transform: scale(0.98);
    }
    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }
    .btn-success:hover {
        transform: scale(0.98);
    }
    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }
    .btn-warning:hover {
        background-color: #e0a800;
        border-color: #d39e00;
        transform: scale(0.98);
    }
    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        color: #6c757d;
    }
    
    /* ==================== کارت ویژه کیک ==================== */
    .special-cake-card {
        background: white !important;
    }
    .special-cake-card .product-img-wrapper {
        background: linear-gradient(135deg, #fff9e6, #ffe6cc);
    }
    .special-cake-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,0.12) !important;
    }
    
    /* ==================== مودال توضیحات ==================== */
    .modal-content {
        backdrop-filter: blur(2px);
        transition: transform 0.2s;
    }
    .modal-header {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .modal-footer {
        background: #f8f9fa;
    }
    #descModalBody {
        color: #2c3e50;
        text-align: justify;
    }
    #descModalImage {
        max-width: 100%;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }
    
    /* ==================== ریسپانسیو ==================== */
    @@media (max-width: 768px) {
        .product-img-wrapper,
        .product-img,
        .product-img-placeholder {
            height: 180px !important;
        }
        .product-card {
            min-height: 380px;
        }
        .card-body {
            padding: 0.75rem !important;
        }
        .product-title {
            font-size: 0.9rem;
            min-height: 40px;
        }
        .product-meta div {
            font-size: 0.7rem;
        }
        .price {
            font-size: 1rem !important;
        }
        .badge {
            font-size: 0.65rem;
            padding: 0.2rem 0.5rem;
        }
        .btn {
            font-size: 0.7rem;
            padding: 0.3rem 0.5rem;
        }
        .description-btn {
            font-size: 0.65rem;
        }
        .row.g-4 {
            --bs-gutter-x: 0.75rem;
        }
        .col-sm-6 {
            margin-bottom: 0.8rem;
        }
    }
    @@media (max-width: 576px) {
        .product-img-wrapper,
        .product-img,
        .product-img-placeholder {
            height: 160px !important;
        }
        .product-card {
            min-height: 360px;
        }
        .card-body {
            padding: 0.6rem !important;
        }
        .product-title {
            font-size: 0.85rem;
            min-height: 36px;
        }
        .price {
            font-size: 0.9rem !important;
        }
        .btn {
            font-size: 0.65rem;
        }
    }
</style>

@section Scripts {
<script>
function toPersianNumber(str) {
    if (!str) return str;
    const persianDigits = '۰۱۲۴۵۶۷۸۹';
    return str.toString().replace(/\d/g, function(d) {
        return persianDigits[parseInt(d)];
    });
}

// ============================================================
// 🛒 محصولات عادی - افزودن به سبد خرید
// ============================================================
$(document).on('click', '.add-to-cart-simple', function () {
    var productId = $(this).data('product-id');
    var $btn = $(this);
    $btn.prop('disabled', true).text('در حال افزودن...');
    const csrfToken = $('input[name="__RequestVerificationToken"]').val();
    $.ajax({
        url: '/Cart/AddProductToCart',
        type: 'POST',
        headers: { 'RequestVerificationToken': csrfToken },
        data: { productId: productId, quantity: 1 },
        success: function(response) {
            if (response.success) {
                Swal.fire({
                    icon: 'success',
                    title: response.title || '✅ افزوده شد',
                    text: response.message,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'رفتن به سبد خرید',
                    showCancelButton: true,
                    cancelButtonColor: '#6c757d',
                    cancelButtonText: 'ادامه خرید'
                }).then((result) => {
                    if (result.isConfirmed) window.location.href = '/Cart';
                    else $btn.prop('disabled', false).text('🛒 افزودن به سبد خرید');
                });
            } else {
                Swal.fire({ icon: 'error', title: response.title || 'خطا', text: response.message, confirmButtonText: 'باشه' });
                $btn.prop('disabled', false).text('🛒 افزودن به سبد خرید');
            }
        },
        error: function() {
            Swal.fire({ icon: 'error', title: 'خطا', text: 'خطا در ارتباط با سرور', confirmButtonText: 'باشه' });
            $btn.prop('disabled', false).text('🛒 افزودن به سبد خرید');
        }
    });
});

// ============================================================
// 📦 جعبه شیرینی — انتخاب جعبه (مودال مرکزی) + پنل شناور ردیف‌ها
// ============================================================
var BoxFlow = (function () {
    var selectedBoxId = null;
    var pendingSweetId = null;   // شیرینی‌ای که پس از انتخاب جعبه باید اضافه شود
    var modalAction = 'add';     // 'add' | 'change'
    var pickerCommitted = false; // مودال به دلیل انتخاب جعبه بسته شده است (نه انصراف)
    var panelCollapsed = false;

    function csrf() {
        return $('input[name="__RequestVerificationToken"]').first().val();
    }

    function applyPanelState() {
        $('#bxPanelBody').toggleClass('bx-collapsed', panelCollapsed);
        $('#boxMiniPanelCard').toggleClass('bx-mini', panelCollapsed);
    }

    // بارگذاری پنل شناور
    function refreshPanel(callback) {
        $.ajax({
            url: '/Box/GetMiniPanel',
            type: 'GET',
            success: function (html) {
                $('#boxMiniPanelBody').html(html);
                $('#boxMiniPanel').show();
                // ═══ موبایل: پنل بعد از هر افزودن خودکار جمع می‌شود (دایره‌ی کوچک)
                // تا دید کاربر برای انتخاب شیرینی بعدی آزاد بماند؛ با لمس دایره باز می‌شود.
                // فقط وقتی جعبه کامل شد، پنل باز می‌ماند تا دکمه‌ی «تأیید و رفتن به سبد» دیده شود.
                var isMobile = window.matchMedia('(max-width: 576px)').matches;
                var isFull = $('#boxMiniPanelCard').attr('data-full') === 'true';
                if (isMobile) panelCollapsed = !isFull;
                applyPanelState();
                if (callback) callback();
            },
            error: function () {
                $('#boxMiniPanel').hide();
            }
        });
    }

    // باز کردن مودال انتخاب جعبه
    function openSelectModal(action, sweetId) {
        modalAction = action || 'add';
        pickerCommitted = false;
        pendingSweetId = (modalAction === 'add') ? (sweetId || null) : null;
        $('#boxSelectBody').html('<div class="text-center py-5"><div class="spinner-border" style="color: #b8860b; width: 2.6rem; height: 2.6rem;"></div><p class="mt-3 text-muted mb-0">در حال بارگذاری جعبه‌ها...</p></div>');
        $('#boxSelectModal').modal('show');
        $.ajax({
            url: '/Box/GetBoxSelectContent',
            type: 'GET',
            success: function (html) { $('#boxSelectBody').html(html); },
            error: function () {
                $('#boxSelectBody').html('<div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle-fill"></i> خطا در بارگذاری جعبه‌ها.</div>');
            }
        });
    }

    // انصراف از انتخاب جعبه در مودال — شیرینیِ در انتظار، اضافه نمی‌شود و خرید عادی ادامه می‌یابد
    function cancelPicker() {
        pendingSweetId = null;
        if ($('#boxSelectModal').hasClass('show')) {
            $('#boxSelectModal').modal('hide');
        }
    }

    // انصراف کامل از فرآیند چیدن جعبه: جعبه و همه ردیف‌ها کنسل و پنل بسته می‌شود
    function abandonBox() {
        Swal.fire({
            icon: 'warning',
            title: 'انصراف از جعبه',
            text: 'همه ردیف‌های چیده‌شده و جعبه فعلی کنسل شوند؟',
            showCancelButton: true,
            confirmButtonText: 'بله، انصراف',
            cancelButtonText: 'ادامه چیدن',
            confirmButtonColor: '#e2574c'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '/Box/CancelBox',
                type: 'POST',
                headers: { 'RequestVerificationToken': csrf() },
                success: function () {
                    selectedBoxId = null;
                    pendingSweetId = null;
                    modalAction = 'add';
                    $('#boxMiniPanel').hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'جعبه لغو شد',
                        text: 'هر وقت خواستی دوباره می‌توانی شروع کنی 🎁',
                        timer: 1800,
                        showConfirmButton: false
                    });
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'خطا', text: 'خطا در لغو جعبه', confirmButtonText: 'باشه' });
                }
            });
        });
    }

    // افزودن ردیف شیرینی
    function addRow(sweetId, btn) {
        var $btn = btn ? $(btn) : null;
        if ($btn) { $btn.prop('disabled', true).text('در حال افزودن...'); }
        $.ajax({
            url: '/Box/AddRow',
            type: 'POST',
            headers: { 'RequestVerificationToken': csrf() },
            data: { sweetItemId: sweetId },
            success: function (response) {
                if ($btn) $btn.prop('disabled', false).text('📦 افزودن به جعبه');
                if (response && response.success) {
                    refreshPanel(function () {
                        if (response.isFull) {
                            Swal.fire({
                                icon: 'success',
                                title: '🎉 جعبه کامل شد!',
                                text: 'جعبه‌ات پر شد. برای رفتن به سبد خرید، دکمه «تأیید و رفتن به سبد» را بزن.',
                                timer: 2600,
                                showConfirmButton: false
                            });
                        } else if (response.type === 'warning') {
                            Swal.fire({ icon: 'warning', title: response.title, text: response.message, confirmButtonText: 'باشه' });
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: (response && response.title) || 'خطا',
                        text: (response && response.message) || 'خطا در افزودن به جعبه',
                        confirmButtonText: 'باشه'
                    });
                }
            },
            error: function () {
                if ($btn) $btn.prop('disabled', false).text('📦 افزودن به جعبه');
                Swal.fire({ icon: 'error', title: 'خطا', text: 'خطا در ارتباط با سرور', confirmButtonText: 'باشه' });
            }
        });
    }

    // انتخاب جعبه از مودال
    function pickBox(boxId) {
        var hasItems = $('#boxSelectContent').attr('data-has-items') === 'true';
        var url = hasItems ? '/Box/ChangeBoxType' : '/Box/SelectBoxType';
        var payload = hasItems ? { newBoxTypeId: boxId } : { boxTypeId: boxId };
        $.ajax({
            url: url,
            type: 'POST',
            headers: { 'RequestVerificationToken': csrf() },
            data: payload,
            success: function () {
                selectedBoxId = boxId;
                pickerCommitted = true; // بستن به دلیل انتخاب جعبه (نه انصراف)
                $('#boxSelectModal').modal('hide');
                refreshPanel(function () {
                    if (modalAction === 'add' && pendingSweetId) {
                        var sweetId = pendingSweetId;
                        pendingSweetId = null;
                        addRow(sweetId);
                    }
                });
            },
            error: function (xhr) {
                Swal.fire({ icon: 'error', title: 'خطا', text: xhr.responseText || 'خطا در انتخاب جعبه', confirmButtonText: 'باشه' });
            }
        });
    }

    function togglePanel() {
        panelCollapsed = !panelCollapsed;
        applyPanelState();
    }

    // ---------- رویدادها ----------
    $(document).on('click', '.add-to-box-btn', function () {
        var sweetId = $(this).data('sweet-id');
        if (!selectedBoxId) {
            openSelectModal('add', sweetId);
            return;
        }
        addRow(sweetId, this);
    });

    $(document).on('click', '.bx-option', function () {
        var boxId = $(this).data('box-id');
        if ($(this).hasClass('active')) {
            pickerCommitted = true;
            $('#boxSelectModal').modal('hide');
            if (modalAction === 'add' && pendingSweetId) {
                var sweetId = pendingSweetId;
                pendingSweetId = null;
                addRow(sweetId);
            }
            return;
        }
        pickBox(boxId);
    });

    $(document).on('keydown', '.bx-option', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            $(this).trigger('click');
        }
    });

    $(document).on('click', '.bx-row-remove', function () {
        var rowIndex = $(this).data('row-index');
        Swal.fire({
            icon: 'warning',
            title: 'حذف ردیف',
            text: 'این ردیف از جعبه حذف شود؟',
            showCancelButton: true,
            confirmButtonText: 'بله، حذف کن',
            cancelButtonText: 'انصراف',
            confirmButtonColor: '#e2574c'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '/Box/RemoveRow',
                type: 'POST',
                headers: { 'RequestVerificationToken': csrf() },
                data: { rowIndex: rowIndex },
                success: function () { refreshPanel(); },
                error: function () { Swal.fire({ icon: 'error', title: 'خطا', text: 'خطا در حذف ردیف', confirmButtonText: 'باشه' }); }
            });
        });
    });

    $(document).on('click', '#bxChangeBox', function () {
        openSelectModal('change');
    });

    $(document).on('click', '#bxClearBox', function () {
        Swal.fire({
            icon: 'warning',
            title: 'خالی کردن جعبه',
            text: 'همه ردیف‌ها از جعبه حذف شوند؟',
            showCancelButton: true,
            confirmButtonText: 'بله، خالی کن',
            cancelButtonText: 'انصراف',
            confirmButtonColor: '#e2574c'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '/Box/Clear',
                type: 'POST',
                headers: { 'RequestVerificationToken': csrf() },
                success: function () { refreshPanel(); },
                error: function () { Swal.fire({ icon: 'error', title: 'خطا', text: 'خطا در خالی کردن جعبه', confirmButtonText: 'باشه' }); }
            });
        });
    });

    $(document).on('click', '#bxConfirmCart', function () {
        var $btn = $(this);
        if ($btn.hasClass('bx-disabled')) return; // 🔒 جعبه ناقص هرگز به سبد خرید نمی‌رود
        $btn.prop('disabled', true).text('در حال انتقال...');
        $.ajax({
            url: '/Box/AddToCart',
            type: 'POST',
            headers: { 'RequestVerificationToken': csrf() },
            success: function () { window.location.href = '/Cart'; },
            error: function (xhr) {
                $btn.prop('disabled', false).text('🛒 تأیید و رفتن به سبد');
                Swal.fire({ icon: 'error', title: 'خطا', text: xhr.responseText || 'خطا در افزودن به سبد خرید', confirmButtonText: 'باشه' });
            }
        });
    });

    // انصراف از انتخاب جعبه داخل مودال (دکمه «انصراف و ادامه خرید»)
    $(document).on('click', '#bxCancelPicker', function () {
        cancelPicker();
    });

    // بستن مودال بدون انتخاب جعبه (X / کلیک بیرون / ESC) → افزودنِ معلق کنسل می‌شود
    $('#boxSelectModal').on('hidden.bs.modal', function () {
        if (!pickerCommitted) {
            pendingSweetId = null;
        }
        pickerCommitted = false;
    });

    // انصراف کامل از کل فرآیند جعبه (پنل شناور)
    $(document).on('click', '#bxAbandonBox', function () {
        abandonBox();
    });

    $(document).on('click', '#bxPanelToggle', function (e) {
        e.stopPropagation();
        togglePanel();
    });

    $(document).on('click', '#bxPanelHeader', function (e) {
        if ($(e.target).closest('button').length) return;
        togglePanel();
    });

    function init() {
        $.ajax({
            url: '/Box/GetCurrentBoxType',
            type: 'GET',
            success: function (data) {
                if (data && data.selectedBoxId) {
                    selectedBoxId = data.selectedBoxId;
                    refreshPanel();
                }
            }
        });
    }

    return { init: init };
})();

// ============================================================
// 📖 نمایش توضیحات محصول
// ============================================================
$(document).on('click', '.description-btn', function () {
    var desc = $(this).data('desc');
    var img = $(this).data('img');
    var title = $(this).data('title');
    if (desc && desc.trim() !== '') {
        $('#descModalTitle').text(title || 'توضیحات محصول');
        $('#descModalBody').text(desc);
        if (img && img.trim() !== '') { $('#descModalImage').attr('src', img).show(); } 
        else { $('#descModalImage').hide(); }
        $('#descModal').modal('show');
    }
});

// کلیک روی تصویر محصول
$(document).on('click', '.product-img-wrapper[data-product-id]', function(e) {
    var productId = $(this).data('product-id');
    if (productId) $('.add-to-cart-simple[data-product-id="' + productId + '"]').click();
    e.stopPropagation();
});
$(document).on('click', '.product-img-wrapper[data-sweet-id]', function(e) {
    var sweetId = $(this).data('sweet-id');
    if (sweetId) $('.add-to-box-btn[data-sweet-id="' + sweetId + '"]').click();
    e.stopPropagation();
});

@if (Model.RequiresBoxSelection)
{
    <text>
    $(function () {
        BoxFlow.init();
    });
    </text>
}
</script>
}