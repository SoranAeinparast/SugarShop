@using SugarShop.Domain.Entities.Sms
@model List<SmsLog>
@{
    ViewData["Title"] = "گزارش پیامک‌ها";
    Layout = "_AdminLayout";
    var statusNames = (Dictionary<int, string>)ViewBag.StatusNames;
    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    ViewBag.MonthCost = ViewBag.MonthCost ?? 0m;
    ViewBag.MonthSent = ViewBag.MonthSent ?? 0;
    ViewBag.QueueCount = ViewBag.QueueCount ?? 0;

    string DeliveryBadge(SmsLog l) => l.DeliveryState switch
    {
        1 => "<span class='badge bg-success'>رسیده به گوشی</span>",
        2 => "<span class='badge bg-info text-dark'>پردازش مخابرات</span>",
        3 => "<span class='badge bg-info text-dark'>رسیده مخابرات</span>",
        4 => "<span class='badge bg-danger'>نرسیده به مخابرات</span>",
        6 => "<span class='badge bg-danger' title='اعتبار کسر شد ولی پیامک به گوشی نرسید'>خطا در مخابرات</span>",
        7 => "<span class='badge bg-dark'>لیست سیاه</span>",
        null => "<span class='text-muted'>—</span>",
        _ => $"<span class='badge bg-secondary'>کد {l.DeliveryState}</span>"
    };

    string BadgeClass(int st) => st switch
    {
        (int)SmsSendStatus.Sent => "bg-success",
        (int)SmsSendStatus.Pending => "bg-info text-dark",
        (int)SmsSendStatus.Failed => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <a href="/SmsSettings" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> بازگشت به داشبورد سامانه پیامکی</a>
    <div class="d-flex gap-2">
        <a href="/SmsSettings/LiveReport" class="btn btn-outline-info btn-sm">📡 گزارش زنده پنل sms.ir</a>
        <form asp-action="SyncDelivery" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">🔄 استعلام وضعیت تحویل</button>
        </form>
    </div>
</div>
<partial name="_SmsCreditBar" />
<h2 class="mb-3">📊 گزارش پیامک‌ها <small class="text-muted fs-6">(@ViewBag.TotalCount پیامک)</small></h2>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <input type="text" name="phone" class="form-control" placeholder="جستجوی شماره..." value="@ViewBag.PhoneFilter" />
    </div>
    <div class="col-md-4">
        <select name="status" class="form-select" asp-items='new SelectList(statusNames, "Key", "Value", ViewBag.StatusFilter)'>
            <option value="">همه وضعیت‌ها</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary w-100">🔍 فیلتر</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>شماره</th>
                    <th>متن</th>
                    <th>وضعیت</th>
                    <th>تحویل</th>
                    <th>هزینه</th>
                    <th>زمان</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">هنوز پیامکی ثبت نشده است.</td></tr>
                }
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="fw-bold" dir="ltr">@l.PhoneNumber</td>
                        <td style="max-width:420px">
                            <span title="@l.MessageText">@(l.MessageText.Length > 80 ? l.MessageText[..80] + "…" : l.MessageText)</span>
                            @if (!string.IsNullOrEmpty(l.ErrorMessage))
                            {
                                <small class="text-danger d-block">@l.ErrorMessage</small>
                            }
                        </td>
                        <td><span class="badge @BadgeClass((int)l.Status)">@statusNames.GetValueOrDefault((int)l.Status, l.Status.ToString())</span></td>
                        <td class="small">@DeliveryBadge(l)</td>
                        <td>@l.Cost.ToString("N0")</td>
                        <td class="text-muted small">@l.SentAt.AddHours(3.5).ToString("yyyy/MM/dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = Math.Max(1, page - 3); i <= Math.Min(totalPages, page + 3); i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="Logs" asp-route-page="@i"
                       asp-route-status="@ViewBag.StatusFilter" asp-route-phone="@ViewBag.PhoneFilter">@i</a>
                </li>
            }
        </ul>
    </nav>
}
