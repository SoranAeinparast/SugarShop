@using SugarShop.Domain.Entities.Sms
@model SmsCampaign
@{
    ViewData["Title"] = "کمپین جدید";
    Layout = "_AdminLayout";
    var audiences = (SelectList)ViewBag.Audiences;
}

<a href="/SmsSettings" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-right"></i> بازگشت به داشبورد سامانه پیامکی</a>
<h2 class="mb-3">📣 کمپین پیامکی جدید</h2>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="CreateCampaign" method="post" id="campForm">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">عنوان کمپین (فقط برای شما)</label>
                        <input type="text" name="title" class="form-control" placeholder="مثال: جشنواره نوروزی" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">به چه کسانی ارسال شود؟</label>
                        <select name="audience" class="form-select" asp-items="audiences"></select>
                        <small class="text-muted">
                            💡 توصیه: برای پیامک تبلیغاتی گزینه «خرید کرده در ۳ ماه گذشته» بهترین نتیجه را می‌دهد.
                        </small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold">متن پیام</label>
                        <textarea name="message" class="form-control" rows="5" required maxlength="600"
                                  placeholder="مثال: جشنواره نوروزی شیرینی سرا! تا ۲۰٪ تخفیف روی همه محصولات..." dir="rtl"></textarea>
                        <small class="text-muted">
                            کاراکتر: <span id="charCount">۰</span> — هر ۶۰ کاراکتر = ۱ پیامک
                            (متغیر {CustomerName} به نام کوچک هر مشتری تبدیل می‌شود)
                        </small>
                    </div>
                    <div class="alert alert-light border py-2 mb-0" id="previewBox" dir="rtl"></div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg" id="sendBtn">🚀 ارسال به صف پیامک</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    var ta = document.querySelector('textarea[name=message]');
    var cnt = document.getElementById('charCount');
    var preview = document.getElementById('previewBox');
    function faNum(n) { return String(n).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]); }
    function update() {
        cnt.textContent = faNum(ta.value.length);
        preview.textContent = ta.value.replaceAll('{CustomerName}', 'علی').replace('{SiteName}', 'شیرینی سرا');
    }
    ta.addEventListener('input', update);
    update();
    document.getElementById('campForm').addEventListener('submit', function () {
        var b = document.getElementById('sendBtn');
        b.disabled = true;
        b.textContent = 'در حال قرار دادن در صف...';
    });
</script>
}
