@using SugarShop.Web.Services
@using MD.PersianDateTime
@model SmsLinkReportModel
@{
    ViewData["Title"] = "اثر پیامک‌های لینک‌دار";
    Layout = "_AdminLayout";

    string Fa(object? v) => (v?.ToString() ?? "").Replace("0", "۰").Replace("1", "۱").Replace("2", "۲")
        .Replace("3", "۳").Replace("4", "۴").Replace("5", "۵").Replace("6", "۶").Replace("7", "۷")
        .Replace("8", "۸").Replace("9", "۹");
    string Pct(double v) => Fa(v.ToString("N1")) + "٪";
    string Num(int v) => Fa(v.ToString("N0"));

    string TimeText(double? minutes)
    {
        if (!minutes.HasValue) return "—";
        var m = minutes.Value;
        if (m < 1) return "کمتر از یک دقیقه";
        if (m < 60) return Fa(Math.Round(m) + " دقیقه");
        if (m < 60 * 24) return Fa(Math.Round(m / 60) + " ساعت");
        return Fa(Math.Round(m / 1440) + " روز");
    }

    var waiting = Model.WaitingPayment;
    var statement = Model.Statement;
    var maxDaily = Model.Daily.Count > 0 ? Math.Max(Model.Daily.Max(d => d.Sent), 1) : 1;
    var totalSent = Model.Rows.Sum(r => r.Sent);
    var totalOpened = Model.Rows.Sum(r => r.Opened);
    var totalPaid = Model.Rows.Sum(r => r.Paid);
    var overallOpenRate = totalSent == 0 ? 0 : Math.Round(totalOpened * 100.0 / totalSent, 1);
    var overallPayRate = totalSent == 0 ? 0 : Math.Round(totalPaid * 100.0 / totalSent, 1);
}

<partial name="_SmsCreditBar" />

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">🎯 اثر پیامک‌های لینک‌دار</h2>
        <p class="text-muted mb-0">
            از سفارش‌هایی که پیامک لینک‌دار گرفتند، چند درصد لینک را باز کردند و چند نفر پرداخت کردند.
        </p>
    </div>
    <div class="btn-group">
        <a asp-action="Effect" asp-route-days="7" class="btn @(Model.Days == 7 ? "btn-dark" : "btn-outline-dark")">۷ روز</a>
        <a asp-action="Effect" asp-route-days="30" class="btn @(Model.Days == 30 ? "btn-dark" : "btn-outline-dark")">۳۰ روز</a>
        <a asp-action="Effect" asp-route-days="90" class="btn @(Model.Days == 90 ? "btn-dark" : "btn-outline-dark")">۹۰ روز</a>
    </div>
</div>

<div class="alert alert-info">
    این آمار از <strong>زمان فعال شدن اثرسنجی</strong> جمع می‌شود؛ پیامک‌هایی که پیش از آن ارسال شده‌اند
    فقط در صورت باز شدن (و بدون متناظر ارسال) شمرده می‌شوند و در درصدها نمی‌آیند.
    بازه‌ی فعلی: از <strong>@ViewBag.FromText</strong> به بعد.
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">📤</div>
                <h3 class="mb-0">@Num(totalSent)</h3>
                <small class="text-muted">پیامک لینک‌دار (سفارش)</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">👀</div>
                <h3 class="mb-0">@Pct(overallOpenRate)</h3>
                <small class="text-muted">لینک را باز کردند (@Num(totalOpened))</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">💳</div>
                <h3 class="mb-0">@Pct(overallPayRate)</h3>
                <small class="text-muted">بعد از پیامک پرداخت کردند (@Num(totalPaid))</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">🕒</div>
                <h3 class="mb-0">@TimeText(waiting?.AvgMinutesToOpen)</h3>
                <small class="text-muted">میانگین فاصله تا اولین بازدید</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold">تفکیک بر اساس نوع لینک</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>نوع پیامک</th>
                    <th class="text-center">ارسال‌شده</th>
                    <th class="text-center">باز شده</th>
                    <th class="text-center" style="min-width:140px;">نرخ باز شدن</th>
                    <th class="text-center">کل بازدید</th>
                    <th class="text-center">بازدید هر لینک</th>
                    <th class="text-center">پرداخت پس از پیامک</th>
                    <th class="text-center" style="min-width:140px;">نرخ پرداخت (از ارسال‌شده‌ها)</th>
                    <th class="text-center" style="min-width:140px;">نرخ پرداخت (از بازکرده‌ها)</th>
                    <th class="text-center">فاصله تا اولین بازدید</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var bar = row.OpenRate >= 50 ? "bg-success" : row.OpenRate >= 20 ? "bg-warning" : "bg-danger";
                    <tr>
                        <td>
                            <div class="fw-bold">@row.Title</div>
                            <small class="text-muted">@row.Description</small>
                        </td>
                        <td class="text-center">@Num(row.Sent)</td>
                        <td class="text-center">@Num(row.Opened)</td>
                        <td>
                            <div class="progress" style="height:18px;">
                                <div class="progress-bar @bar" style="width:@row.OpenRate.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;">
                                    @Pct(row.OpenRate)
                                </div>
                            </div>
                        </td>
                        <td class="text-center">@Num(row.OpenCount)</td>
                        <td class="text-center">@Fa(row.OpensPerLink.ToString("N2"))</td>
                        <td class="text-center">@Num(row.Paid)</td>
                        <td class="text-center @(row.PayRateOfSent >= 20 ? "text-success fw-bold" : "")">@Pct(row.PayRateOfSent)</td>
                        <td class="text-center">@Pct(row.PayRateOfOpened)</td>
                        <td class="text-center">@TimeText(row.AvgMinutesToOpen)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white text-muted small">
        «نرخ پرداخت از بازکرده‌ها» به این معناست: از میان مشتری‌هایی که لینک را باز کردند، چند درصد
        بعد از همین پیامک پرداخت موفق داشتند. سفارش‌های مرحله‌ای ممکن است چند پیامک لینک‌دار داشته باشند؛
        هر پیامک جداگانه شمرده می‌شود.
        @if (Model.UnattributedOpens > 0)
        {
            <span class="d-block mt-1">
                ℹ️ @Num(Model.UnattributedOpens) بازدید مربوط به پیامک‌هایی است که ارسالشان ثبت نشده
                (پیش از فعال شدن اثرسنجی) و در درصدها حساب نشده است.
            </span>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">📈 ۳۰ روز اخیر — پیامک لینک‌دار در برابر بازشده</span>
        <span class="text-muted small">هر ستون: یک روز (به وقت ایران)</span>
    </div>
    <div class="card-body">
        @if (Model.Daily.Count == 0)
        {
            <p class="text-muted mb-0">در ۳۰ روز اخیر پیامک لینک‌داری ثبت نشده است.</p>
        }
        else
        {
            <div class="d-flex align-items-end gap-1" style="height:180px;overflow-x:auto;">
                @foreach (var day in Model.Daily)
                {
                    var h = (int)Math.Round(day.Sent * 150.0 / maxDaily);
                    var oh = day.Sent == 0 ? 0 : (int)Math.Round(day.Opened * 150.0 / maxDaily);
                    var label = new PersianDateTime(day.Day).ToString("MM/dd");
                    <div class="text-center" style="min-width:26px;" title="@Fa(label): @Num(day.Sent) ارسال، @Num(day.Opened) باز شده">
                        <div class="d-flex align-items-end justify-content-center" style="height:150px;gap:2px;">
                            <div class="bg-secondary" style="width:9px;height:@h.ToString(System.Globalization.CultureInfo.InvariantCulture)px;border-radius:3px 3px 0 0;"></div>
                            <div class="bg-success" style="width:9px;height:@oh.ToString(System.Globalization.CultureInfo.InvariantCulture)px;border-radius:3px 3px 0 0;"></div>
                        </div>
                        <div class="text-muted" style="font-size:9px;white-space:nowrap;">@Fa(label)</div>
                    </div>
                }
            </div>
            <div class="mt-2 small">
                <span class="badge bg-secondary">■</span> ارسال‌شده
                <span class="badge bg-success ms-2">■</span> لینک باز شده
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">📱 بازگشت به داشبورد پیامک</a>
    <a asp-action="Logs" class="btn btn-outline-secondary">📊 گزارش ارسال‌ها</a>
</div>
