@using SugarShop.Domain.Entities.Sms
@model SmsSystemSetting
@{
    ViewData["Title"] = "تنظیمات سامانه پیامکی";
    Layout = "_AdminLayout";
    string Fa(object v) => v?.ToString() ?? "";
}

<partial name="_SmsCreditBar" model="Model" />

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">📱 سامانه پیامکی</h2>
        <p class="text-muted mb-0">مدیریت کامل پیامک‌های فروشگاه — ارسال خودکار، گزارش و تنظیمات</p>
    </div>
    <div class="text-left">
        @if (Model.SandboxMode)
        {
            <span class="badge bg-warning text-dark p-2">⚠️ حالت آزمایشی — پیامکی واقعاً ارسال نمی‌شود</span>
        }
        else if (Model.IsEnabled)
        {
            <span class="badge bg-success p-2">✅ فعال و متصل</span>
        }
        else
        {
            <span class="badge bg-secondary p-2">⛔ غیرفعال</span>
        }
    </div>
</div>

@if (Model.SandboxMode)
{
    <div class="alert alert-warning">
        <strong>راهنمای راه‌اندازی:</strong>
        برای فعال‌سازی ارسال واقعی، از منوی «اتصال به درگاه» کلید API و شماره خط را ثبت و دکمه «تست اتصال» را بزنید.
        تا قبل از تست موفق، هیچ پیامکی واقعاً ارسال نمی‌شود و همه ارسال‌ها فقط در گزارش ثبت می‌شوند.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">📨</div>
                <h3 class="mb-0">@ViewBag.MonthSent</h3>
                <small class="text-muted">ارسال موفق این ماه</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">❌</div>
                <h3 class="mb-0">@ViewBag.MonthFailed</h3>
                <small class="text-muted">ناموفق این ماه</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">💰</div>
                <h3 class="mb-0">@Fa(ViewBag.MonthCost)</h3>
                <small class="text-muted">مصرف این ماه (تعداد پیامک)</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">⏳</div>
                <h3 class="mb-0">@ViewBag.QueueCount</h3>
                <small class="text-muted">در صف ارسال</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="fs-2">📡</div>
                <h3 class="mb-0">@ViewBag.DeliveryFailed</h3>
                <small class="text-muted">خطای تحویل این ماه</small>
                <a href="/SmsSettings/LiveReport" class="small d-block mt-1">گزارش زنده پنل ←</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <a href="@Url.Action("Connection")" class="text-decoration-none">
            <div class="card h-100 shadow-sm sms-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-1">🔌</div>
                    <div>
                        <h5 class="mb-1 text-dark">اتصال به درگاه</h5>
                        <small class="text-muted">کلید API، شماره خط و تست اتصال به sms.ir</small>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("Templates")" class="text-decoration-none">
            <div class="card h-100 shadow-sm sms-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-1">📝</div>
                    <div>
                        <h5 class="mb-1 text-dark">مدیریت قالب‌ها</h5>
                        <small class="text-muted">متن پیامک هر رویداد + فعال/غیرفعال کردن</small>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("Advanced")" class="text-decoration-none">
            <div class="card h-100 shadow-sm sms-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-1">⚙️</div>
                    <div>
                        <h5 class="mb-1 text-dark">تنظیمات پیشرفته</h5>
                        <small class="text-muted">ساعات مجاز، سقف‌ها، اطلاع‌رسانی کارکنان، تخفیف خودکار</small>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("Campaigns")" class="text-decoration-none">
            <div class="card h-100 shadow-sm sms-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-1">📣</div>
                    <div>
                        <h5 class="mb-1 text-dark">ارسال انبوه تفکیک‌شده</h5>
                        <small class="text-muted">تبلیغات به تفکیک مشتریان (VIP، فعال، راکد و...)</small>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("Logs")" class="text-decoration-none">
            <div class="card h-100 shadow-sm sms-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-1">📊</div>
                    <div>
                        <h5 class="mb-1 text-dark">گزارش ارسال‌ها</h5>
                        <small class="text-muted">لاگ کامل پیامک‌ها (موفق/ناموفق) و هزینه‌ها</small>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("Effect")" class="text-decoration-none">
            <div class="card h-100 shadow-sm sms-tile border-success">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-1">🎯</div>
                    <div>
                        <h5 class="mb-1 text-dark">اثر پیامک‌های لینک‌دار</h5>
                        <small class="text-muted">چند درصد مشتری‌ها لینک پرداخت/صورت‌حساب را باز کردند و چند نفر پرداخت کردند</small>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<style>
    .sms-tile { transition: all .2s; }
    .sms-tile:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important; }
</style>
