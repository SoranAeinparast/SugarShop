@model SugarShop.Domain.Entities.Sales.WalletSettings
@{
    ViewData["Title"] = "تنظیمات کیف پول";
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-header">
        <h4>⚙️ تنظیمات سیستم کیف پول</h4>
    </div>
    <div class="card-body">
        <form asp-action="Settings" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" asp-for="IsEnabled" />
                        <label class="form-check-label" asp-for="IsEnabled">فعال بودن سیستم کیف پول</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" asp-for="AllowDirectRecharge" />
                        <label class="form-check-label" asp-for="AllowDirectRecharge">اجازه شارژ مستقیم توسط مشتری</label>
                    </div>
                </div>
            </div>
            <h5 class="mt-3">💸 بازگشت وجه از خرید (کش‌بک)</h5>
            <div class="row">
                <div class="col-md-4">
                    <label asp-for="ReturnType">نوع بازگشت</label>
                    <select asp-for="ReturnType" class="form-control">
                        <option value="Percentage">درصدی</option>
                        <option value="Fixed">مبلغ ثابت</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="ReturnValue">مقدار بازگشت</label>
                    <input asp-for="ReturnValue" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="MinimumOrderAmount">حداقل مبلغ سفارش (تومان)</label>
                    <input asp-for="MinimumOrderAmount" class="form-control" />
                </div>
            </div>
            <h5 class="mt-3">💳 شارژ مستقیم</h5>
            <div class="row">
                <div class="col-md-4">
                    <label asp-for="DirectRechargeMinAmount">حداقل مبلغ شارژ</label>
                    <input asp-for="DirectRechargeMinAmount" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="DirectRechargeMaxAmount">حداکثر مبلغ شارژ (0 = نامحدود)</label>
                    <input asp-for="DirectRechargeMaxAmount" class="form-control" />
                </div>
            </div>
            <h5 class="mt-3">🔒 محدودیت‌ها</h5>
            <div class="row">
                <div class="col-md-6">
                    <label asp-for="MaxWalletBalance">سقف موجودی کیف پول (0 = نامحدود)</label>
                    <input asp-for="MaxWalletBalance" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ExpiryDays">انقضای اعتبار (تعداد روز، 0 = بدون انقضا)</label>
                    <input asp-for="ExpiryDays" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">💾 ذخیره تنظیمات</button>
        </form>
    </div>
</div>
