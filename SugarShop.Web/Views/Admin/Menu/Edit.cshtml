@{
    ViewData["Title"] = "ویرایش آیتم منو";
    Layout = "_AdminLayout";
}
@model SugarShop.Domain.Entities.MenuItem
<div class="card">
    <div class="card-header">
        <h4>✏️ ویرایش آیتم منو</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Location" />
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">عنوان منو</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">آدرس (URL)</label>
                        <input asp-for="Url" class="form-control" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input asp-for="Order" type="number" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">آیکون (اختیاری)</label>
                        <input asp-for="Icon" class="form-control" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label">فعال</label>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">💾 ذخیره تغییرات</button>
                <a href="@Url.Action("Index", new { location = Model.Location })" class="btn btn-secondary">↩️ انصراف</a>
            </div>
        </form>
    </div>
</div>
