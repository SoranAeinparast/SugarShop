@using SugarShop.Domain.Entities.Sales
@using SugarShop.Web.Extensions
@model List<Order>
@{
    ViewData["Title"] = "بررسی پرداخت‌ها";
    var total = ViewBag.TotalPaymentReviews is int count ? count : Model.Count;
    var currentPage = ViewBag.CurrentPage is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var firstRow = total == 0 ? 0 : ((currentPage - 1) * 50) + 1;
    var lastRow = Math.Min(currentPage * 50, total);
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">بررسی پرداخت‌های بانکی</h2>
            <div class="text-muted">این فهرست شامل سفارش‌های عادی و شارژهای داخلی کیف پول است.</div>
        </div>
        <a asp-action="Orders" class="btn btn-outline-secondary">بازگشت به سفارش‌ها</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="alert alert-warning">نمایش @firstRow تا @lastRow از @total مورد باز.</div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>کد</th>
                    <th>نوع</th>
                    <th>مشتری</th>
                    <th>مبلغ</th>
                    <th>پرداخت‌های نیازمند بررسی</th>
                    <th>آخرین تغییر</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">موردی برای بررسی وجود ندارد.</td></tr>
                }
                @foreach (var order in Model)
                {
                    var pendingPayments = order.Payments.Where(p => p.PaymentStatus == PaymentStatus.RefundRequired).ToList();
                    <tr>
                        <td>@order.OrderCode</td>
                        <td>@(order.IsInternal ? "شارژ/سفارش داخلی" : "سفارش فروشگاه")</td>
                        <td>@order.CustomerName<br /><small dir="ltr">@order.CustomerPhone</small></td>
                        <td>@((order.FinalTotalAmount ?? order.TotalAmountSnapshot).ToString("N0").ToPersianNumber()) تومان</td>
                        <td>
                            @if (pendingPayments.Count == 0)
                            {
                                <span>بررسی سفارش</span>
                            }
                            @foreach (var payment in pendingPayments)
                            {
                                <div dir="ltr">@payment.TransactionCode · @payment.Amount.ToString("N0").ToPersianNumber()</div>
                            }
                        </td>
                        <td>@order.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-primary">باز کردن</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <nav aria-label="صفحه‌بندی بررسی پرداخت‌ها">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="PaymentReviews" asp-route-page="@(currentPage - 1)">قبلی</a>
                </li>
                <li class="page-item disabled"><span class="page-link">صفحه @currentPage از @totalPages</span></li>
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="PaymentReviews" asp-route-page="@(currentPage + 1)">بعدی</a>
                </li>
            </ul>
        </nav>
    }
</div>
