@using SugarShop.Domain.Entities.Sales
@using MD.PersianDateTime
@using SugarShop.Web.Extensions
@model CustomCakeOrder
@{
    ViewData["Title"] = $"جزئیات سفارش کیک #{Model.Id}";
    Layout = "_AdminLayout";
    var createdDate = new PersianDateTime(Model.CreatedAt);
    var createdStr = createdDate.ToString("yyyy/MM/dd HH:mm");
}
<div class="card">
    <div class="card-header">
        <h4>🎂 جزئیات سفارش کیک #@Model.Id</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>مشتری:</strong> @Model.UserId</p>
                <p><strong>تاریخ ثبت:</strong> @createdStr.ToPersianNumber()</p>
                @if (Model.DesiredDeliveryDateTime.HasValue)
                {
                    var deliveryDate = new PersianDateTime(Model.DesiredDeliveryDateTime.Value);
                    var deliveryStr = deliveryDate.ToString("yyyy/MM/dd HH:mm");
                    <p><strong>تاریخ تحویل دلخواه:</strong> @deliveryStr.ToPersianNumber()</p>
                }
                <p><strong>روش تحویل:</strong>
                    @if (Model.DeliveryMethod == DeliveryMethod.Delivery)
                    {
                        <span class="badge bg-warning text-dark">🛵 ارسال با پیک</span>
                    }
                    else
                    {
                        <span class="badge bg-success">🏪 دریافت در محل</span>
                    }
                </p>
                @if (Model.DeliveryMethod == DeliveryMethod.Delivery)
                {
                    <p><strong>گیرنده:</strong> @(Model.ReceiverName ?? "—") | @(Model.ReceiverPhone ?? "—")</p>
                    <p><strong>آدرس:</strong> @(Model.CustomerFullAddress ?? "—")</p>
                    <p><strong>کد پستی:</strong> @(Model.CustomerPostalCode ?? "—")</p>
                    <p><strong>هزینه پیک:</strong> @(Model.DeliveryFee?.ToString("N0").ToPersianNumber() ?? "تعیین نشده") تومان</p>
                }
                <p><strong>وضعیت فعلی:</strong> <partial name="_CakeStatusBadge" model="Model.Status" /></p>
            </div>
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.SampleImagePath))
                {
                    <p><strong>تصویر نمونه:</strong></p>
                    <a href="@Model.SampleImagePath" target="_blank">
                        <img src="@Model.SampleImagePath" class="img-fluid rounded-3 border" style="max-height: 150px; object-fit: contain;" />
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.PrintImagePath))
                {
                    <p class="mt-3"><strong>تصویر برای چاپ:</strong></p>
                    <a href="@Model.PrintImagePath" target="_blank">
                        <img src="@Model.PrintImagePath" class="img-fluid rounded-3 border" style="max-height: 150px; object-fit: contain;" />
                    </a>
                }
                @if (string.IsNullOrEmpty(Model.SampleImagePath) && string.IsNullOrEmpty(Model.PrintImagePath))
                {
                    <p class="text-muted">تصویری توسط مشتری آپلود نشده است.</p>
                }
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <p><strong>وزن تقریبی:</strong> @(Model.WeightGrams?.ToString().ToPersianNumber() ?? "-") گرم</p>
                <p><strong>تعداد نفرات:</strong> @(Model.Servings?.ToString().ToPersianNumber() ?? "-")</p>
                <p><strong>طعم:</strong> @(Model.Flavor ?? "-")</p>
                <p><strong>شکل:</strong> @(Model.Shape ?? "-")</p>
                <p><strong>مواد به کار رفته:</strong> @(Model.Ingredients ?? "-")</p>
                <p><strong>نوع مراسم:</strong> @(Model.Occasion ?? "-")</p>
            </div>
            <div class="col-md-6">
                <p><strong>توضیحات اضافی:</strong> @(Model.SpecialRequests ?? "-")</p>
            </div>
        </div>
        <hr />
        <h5>تنظیم وضعیت سفارش</h5>
        <form asp-action="UpdateCustomCakeOrder" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label>وضعیت</label>
                    <select name="status" class="form-select">
                        <option value="Pending" selected="@(Model.Status == CustomCakeOrderStatus.Pending)">⏳ در انتظار بررسی</option>
                        <option value="Accepted" selected="@(Model.Status == CustomCakeOrderStatus.Accepted)">✅ تأیید شده</option>
                        <option value="InProduction" selected="@(Model.Status == CustomCakeOrderStatus.InProduction)">👨‍🍳 در حال پخت</option>
                        <option value="Ready" selected="@(Model.Status == CustomCakeOrderStatus.Ready)">🎂 آماده تحویل</option>
                        <option value="Completed" selected="@(Model.Status == CustomCakeOrderStatus.Completed)">📦 تحویل شده</option>
                        <option value="Rejected" selected="@(Model.Status == CustomCakeOrderStatus.Rejected)">❌ رد شده</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>قیمت نهایی (تومان)</label>
                    <input type="number" name="finalPrice" class="form-control" value="@Model.FinalPrice" step="1000" />
                </div>
                <div class="col-md-3">
                    <label>توضیحات مدیر</label>
                    <textarea name="adminNotes" class="form-control" rows="2">@Model.AdminNotes</textarea>
                </div>
                <div class="col-md-3">
                    <label>&nbsp;</label>
                    <button type="submit" class="btn btn-success w-100">💾 ذخیره تغییرات</button>
                </div>
                @if (Model.DeliveryMethod == DeliveryMethod.Delivery)
                {
                    <div class="col-12">
                        <label>🛵 هزینه پیک (تومان)</label>
                        <input type="number" name="deliveryFee" class="form-control" value="@Model.DeliveryFee" step="1000" min="0" style="max-width: 260px;" />
                        <small class="form-text text-muted">مبلغ پیک به قیمت نهایی اضافه شده و هنگام پرداخت از مشتری دریافت می‌شود.</small>
                    </div>
                }
            </div>
            <div class="mt-3 d-flex gap-2">
                <a asp-action="CustomCakeOrders" class="btn btn-secondary">🔙 بازگشت به لیست</a>
            </div>
        </form>
    </div>
</div>