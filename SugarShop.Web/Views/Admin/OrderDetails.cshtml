@using SugarShop.Domain.Entities.Sales
@using System.Linq
@using MD.PersianDateTime
@model Order
@{
    ViewData["Title"] = $"جزئیات سفارش {Model.OrderCode}";
    var productItems = Model.Items.Where(x => x.ItemType == OrderItemType.Product).ToList();
    var boxGroups = Model.Items
        .Where(x => x.ItemType == OrderItemType.SweetItem && !string.IsNullOrEmpty(x.BoxTitle))
        .GroupBy(x => x.BoxTitle)
        .ToList();
    var sweetNames = ViewBag.SweetNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var productNames = ViewBag.ProductNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var boxInfos = ViewBag.BoxInfos as Dictionary<string, BoxFinalInfo> ?? new Dictionary<string, BoxFinalInfo>();
    string ToPersianNumber(string input) => input.ToPersianNumber();
    string orderStatusClass = Model.OrderStatus switch
    {
        OrderStatus.AwaitingReview => "secondary",
        OrderStatus.PendingPayment => "warning",
        OrderStatus.Paid => "info",
        OrderStatus.Preparing => "primary",
        OrderStatus.Shipped => "dark",
        OrderStatus.Delivered => "success",
        OrderStatus.Cancelled => "danger",
        _ => "secondary"
    };
    string paymentStatusClass = Model.PaymentStatus == PaymentStatus.Succeeded ? "success" : "warning";
    string orderStatusText = Model.OrderStatus switch
    {
        OrderStatus.AwaitingReview => "در انتظار بررسی",
        OrderStatus.PendingPayment => "در انتظار پرداخت",
        OrderStatus.Paid => "پرداخت شده",
        OrderStatus.Preparing => "در حال آماده‌سازی",
        OrderStatus.Shipped => "ارسال شده",
        OrderStatus.Delivered => "تحویل شده",
        OrderStatus.Cancelled => "لغو شده",
        _ => "نامشخص"
    };
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">📦 سفارش @Model.OrderCode</h2>
        <a asp-action="Orders" class="btn btn-secondary">بازگشت</a>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header"><h5 class="mb-0">اطلاعات مشتری</h5></div>
                <div class="card-body">
                    <p><strong>نام:</strong> @Model.CustomerName</p>
                    <p><strong>تلفن:</strong> @Model.CustomerPhone</p>
                    <p><strong>آدرس:</strong> @Model.CustomerFullAddress</p>
                    <p><strong>کد پستی:</strong> @Model.CustomerPostalCode</p>
                    @if (Model.DeliveryDate.HasValue) { <p><strong>تاریخ تحویل:</strong> @Model.DeliveryDate.Value.ToString("yyyy/MM/dd").ToPersianNumber()</p> }
                    @if (Model.DeliveryTime.HasValue) { <p><strong>ساعت تحویل:</strong> @Model.DeliveryTime.Value.ToString(@"hh\:mm").ToPersianNumber()</p> }
                    @if (!string.IsNullOrEmpty(Model.Notes)) { <p><strong>توضیحات:</strong> @Model.Notes</p> }
                    <hr />
                    <div class="mb-2">
                        <strong> روش تحویل:</strong>
                        <span class="badge @(Model.DeliveryMethod == DeliveryMethod.Pickup ? "bg-success" : "bg-warning")">
                            @(Model.DeliveryMethod == DeliveryMethod.Pickup ? "🏪 دریافت در محل" : "🛵 ارسال با پیک")
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header"><h5 class="mb-0">اطلاعات مالی</h5></div>
                <div class="card-body">
                    @{
                        var deliveryFee = Model.DeliveryFeeSnapshot;
                        var hasDeliveryFee = deliveryFee > 0;
                        var anyBoxPendingForFinancial = boxGroups.Any(bg => !boxInfos.ContainsKey(bg.Key));
                    }
                    @if (!productItems.Any() && !boxGroups.Any())
                    {
                        @if (hasDeliveryFee)
                        {
                            <p><strong>هزینه پیک:</strong> <span class="text-info fw-bold">@deliveryFee.ToString("N0").ToPersianNumber() تومان</span></p>
                            <hr />
                            <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-success fs-5 fw-bold">@deliveryFee.ToString("N0").ToPersianNumber() تومان</span></p>
                        }
                        else
                        {
                            <p class="text-muted">هیچ آیتمی در این سفارش وجود ندارد.</p>
                        }
                    }
                    else if (productItems.Any() && !boxGroups.Any())
                    {
                        var productTotal = productItems.Sum(p => p.TotalPriceSnapshot);
                        <p><strong>جمع محصولات:</strong> <span>@productTotal.ToString("N0").ToPersianNumber() تومان</span></p>
                        @if (hasDeliveryFee)
                        {
                            <p><strong>هزینه پیک:</strong> <span class="text-info fw-bold">@deliveryFee.ToString("N0").ToPersianNumber() تومان</span></p>
                            <hr />
                            <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-success fs-5 fw-bold">@((productTotal + deliveryFee).ToString("N0").ToPersianNumber()) تومان</span></p>
                        }
                        else
                        {
                            <hr />
                            <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-success fs-5 fw-bold">@productTotal.ToString("N0").ToPersianNumber() تومان</span></p>
                        }
                    }
                    else if (!productItems.Any() && boxGroups.Any())
                    {
                        @if (anyBoxPendingForFinancial)
                        {
                            <p><strong>جمع جعبه‌ها:</strong> <span class="text-muted">بعد از وزن‌کشی اعلام خواهد شد.</span></p>
                            @if (hasDeliveryFee)
                            {
                                <p><strong>هزینه پیک:</strong> <span class="text-info fw-bold">@deliveryFee.ToString("N0").ToPersianNumber() تومان</span></p>
                            }
                            <hr />
                            <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-muted fs-5">پس از اعلام قیمت جعبه محاسبه می‌شود.</span></p>
                        }
                        else
                        {
                            var boxTotal = boxInfos.Values.Sum(b => b.FinalPrice);
                            <p><strong>جمع جعبه‌ها:</strong> <span>@boxTotal.ToString("N0").ToPersianNumber() تومان</span></p>
                            @if (hasDeliveryFee)
                            {
                                <p><strong>هزینه پیک:</strong> <span class="text-info fw-bold">@deliveryFee.ToString("N0").ToPersianNumber() تومان</span></p>
                                <hr />
                                <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-success fs-5 fw-bold">@((boxTotal + deliveryFee).ToString("N0").ToPersianNumber()) تومان</span></p>
                            }
                            else
                            {
                                <hr />
                                <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-success fs-5 fw-bold">@boxTotal.ToString("N0").ToPersianNumber() تومان</span></p>
                            }
                        }
                    }
                    else if (productItems.Any() && boxGroups.Any())
                    {
                        var productTotal = productItems.Sum(p => p.TotalPriceSnapshot);
                        @if (anyBoxPendingForFinancial)
                        {
                            <p><strong>جمع محصولات:</strong> <span>@productTotal.ToString("N0").ToPersianNumber() تومان</span></p>
                            <p><strong>جمع جعبه‌ها:</strong> <span class="text-muted">بعد از وزن‌کشی اعلام خواهد شد.</span></p>
                            @if (hasDeliveryFee)
                            {
                                <p><strong>هزینه پیک:</strong> <span class="text-info fw-bold">@deliveryFee.ToString("N0").ToPersianNumber() تومان</span></p>
                            }
                            <hr />
                            <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-muted fs-5">پس از اعلام قیمت جعبه محاسبه می‌شود.</span></p>
                        }
                        else
                        {
                            var boxTotal = boxInfos.Values.Sum(b => b.FinalPrice);
                            <p><strong>جمع محصولات:</strong> <span>@productTotal.ToString("N0").ToPersianNumber() تومان</span></p>
                            <p><strong>جمع جعبه‌ها:</strong> <span>@boxTotal.ToString("N0").ToPersianNumber() تومان</span></p>
                            @if (hasDeliveryFee)
                            {
                                <p><strong>هزینه پیک:</strong> <span class="text-info fw-bold">@deliveryFee.ToString("N0").ToPersianNumber() تومان</span></p>
                                <hr />
                                <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-success fs-5 fw-bold">@((productTotal + boxTotal + deliveryFee).ToString("N0").ToPersianNumber()) تومان</span></p>
                            }
                            else
                            {
                                <hr />
                                <p><strong>💰 مبلغ قابل پرداخت:</strong> <span class="text-success fs-5 fw-bold">@((productTotal + boxTotal).ToString("N0").ToPersianNumber()) تومان</span></p>
                            }
                        }
                    }
                    <hr />
                    <p><strong>وضعیت سفارش:</strong>
                        <span class="badge bg-@orderStatusClass">@orderStatusText</span>
                    </p>
                    <p><strong>وضعیت پرداخت:</strong>
                        <span class="badge bg-@paymentStatusClass">@(Model.PaymentStatus switch {
                            PaymentStatus.Unpaid => "پرداخت نشده",
                            PaymentStatus.Initiated => "در حال پرداخت",
                            PaymentStatus.Succeeded => "پرداخت موفق",
                            PaymentStatus.Failed => "پرداخت ناموفق",
                            _ => "نامشخص"
                        })</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════════════
       ✅ کارت ورود هزینه پیک توسط ادمین (فقط اگر روش تحویل = پیک)
       ═══════════════════════════════════════════════════════════════ *@
    @if (Model.DeliveryMethod == DeliveryMethod.Delivery)
    {
        <div class="card mb-3 border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">🛵 هزینه ارسال با پیک</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    هزینه پیک ثبت‌شده فعلی: 
                    <strong class="text-info">@(Model.DeliveryFeeSnapshot > 0 ? Model.DeliveryFeeSnapshot.ToString("N0").ToPersianNumber() + " تومان" : "هنوز تعیین نشده")</strong>
                </p>
                <form asp-action="UpdateDeliveryFee" method="post" class="row g-3">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <div class="col-md-6">
                        <label class="form-label fw-bold">هزینه پیک (تومان)</label>
                        <input type="number" name="deliveryFee" class="form-control" 
                               value="@Model.DeliveryFeeSnapshot" min="0" step="1000" required />
                        <small class="text-muted">این مبلغ به قیمت نهایی سفارش اضافه می‌شود و مشتری در هنگام پرداخت آن را مشاهده می‌کند.</small>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label d-block">&nbsp;</label>
                        <button type="submit" class="btn btn-warning w-100">💾 ذخیره هزینه پیک</button>
                    </div>
                    @if (Model.DeliveryFeeSnapshot > 0)
                    {
                        <div class="col-12">
                            <div class="alert alert-info mb-0 mt-2">
                                <i class="bi bi-info-circle"></i> 
                                هزینه پیک ثبت شده: <strong>@Model.DeliveryFeeSnapshot.ToString("N0").ToPersianNumber() تومان</strong>
                                <br />
                                <small>این مبلغ به قیمت نهایی سفارش اضافه خواهد شد و مشتری در هنگام پرداخت آن را مشاهده می‌کند.</small>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">🔄 تغییر وضعیت سفارش</h5></div>
        <div class="card-body">
            <form asp-action="UpdateOrderStatus" method="post" class="row g-3">
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="col-md-6">
                    <select name="status" class="form-select">
                        <option value="1" selected="@(Model.OrderStatus == OrderStatus.AwaitingReview)">در انتظار بررسی</option>
                        <option value="2" selected="@(Model.OrderStatus == OrderStatus.PendingPayment)">در انتظار پرداخت</option>
                        <option value="3" selected="@(Model.OrderStatus == OrderStatus.Paid)">پرداخت شده</option>
                        <option value="4" selected="@(Model.OrderStatus == OrderStatus.Preparing)">در حال آماده‌سازی</option>
                        <option value="5" selected="@(Model.OrderStatus == OrderStatus.Shipped)">ارسال شده</option>
                        <option value="6" selected="@(Model.OrderStatus == OrderStatus.Delivered)">تحویل شده</option>
                        <option value="7" selected="@(Model.OrderStatus == OrderStatus.Cancelled)">لغو شده</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-warning w-100">تغییر وضعیت</button>
                </div>
            </form>
        </div>

        <div class="card mb-3 border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">📄 صدور فاکتور فروش</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">با کلیک روی دکمه زیر، فاکتور فروش رسمی برای این سفارش صادر می‌شود.</p>
                <form asp-action="GenerateInvoice" method="post">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <button type="submit" class="btn btn-success">
                        📄 صدور فاکتور
                    </button>
                </form>
            </div>
        </div>


    </div>
    @if (productItems.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-info text-white"><h5 class="mb-0">️ محصولات عادی (قیمت ثابت)</h5></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>محصول</th>
                                <th class="text-center">تعداد</th>
                                <th class="text-center">قیمت واحد</th>
                                <th class="text-center">جمع</th>
                                <th class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var productItem in productItems)
                            {
                                var productName = productItem.ProductId.HasValue && productNames.ContainsKey(productItem.ProductId.Value)
                                    ? productNames[productItem.ProductId.Value]
                                    : "محصول نامشخص";
                                <tr>
                                    <td class="align-middle">@productName</td>
                                    <td class="align-middle text-center">@productItem.Quantity</td>
                                    <td class="align-middle text-center">@productItem.UnitPriceSnapshot.ToString("N0").ToPersianNumber() تومان</td>
                                    <td class="align-middle text-center">@productItem.TotalPriceSnapshot.ToString("N0").ToPersianNumber() تومان</td>
                                    <td class="align-middle text-center">
                                        <form asp-action="DeleteProductItem" method="post" onsubmit="return confirm('آیا از حذف این محصول اطمینان دارید؟');">
                                            <input type="hidden" name="itemId" value="@productItem.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">️ حذف</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="4" class="text-end"><strong>جمع محصولات:</strong></td>
                                <td class="text-center"><strong>@productItems.Sum(p => p.TotalPriceSnapshot).ToString("N0").ToPersianNumber() تومان</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    @if (boxGroups.Any())
    {
        <h4 class="mt-4">📦 جعبه‌های شیرینی</h4>
        foreach (var boxGroup in boxGroups)
        {
            var boxTitle = boxGroup.Key;
            var sweetGroups = boxGroup.GroupBy(x => x.SweetItemId).ToList();
            var boxInfo = boxInfos.ContainsKey(boxTitle) ? boxInfos[boxTitle] : null;
            <div class="card mb-4 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📦 @boxTitle</h5>
                    <form asp-action="DeleteBox" method="post" onsubmit="return confirm('آیا از حذف کل این جعبه اطمینان دارید؟');">
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="boxTitle" value="@boxTitle" />
                        <button type="submit" class="btn btn-sm btn-danger">🗑️ حذف کل جعبه</button>
                    </form>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>🍪 شیرینی</th>
                                    <th class="text-center">🔢 تعداد ردیف</th>
                                    <th class="text-center">⚙️ عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sweetGroup in sweetGroups)
                                {
                                    var first = sweetGroup.First();
                                    var sweetName = first.SweetItemId.HasValue && sweetNames.ContainsKey(first.SweetItemId.Value)
                                        ? sweetNames[first.SweetItemId.Value]
                                        : $"شیرینی (شناسه {first.SweetItemId})";
                                    var rowCount = sweetGroup.Count();
                                    <tr>
                                        <td class="align-middle"><strong>@sweetName</strong></td>
                                        <td class="align-middle text-center">@rowCount.ToPersianNumber() ردیف</td>
                                        <td class="align-middle text-center">
                                            <a href="@Url.Action("EditOrderItem", "Admin", new { itemId = first.Id })" class="btn btn-sm btn-warning">✏️ ویرایش</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-secondary">
                                <tr>
                                    <td class="text-end align-middle"><strong>نوع شیرینی‌های انتخابی:</strong></td>
                                    <td class="text-center align-middle" colspan="2"><strong>@sweetGroups.Count().ToPersianNumber() نوع شیرینی</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="card mt-3">
                        <div class="card-header bg-primary text-white"><h5 class="mb-0">⚖️ ثبت وزن دقیق و قیمت نهایی جعبه @boxTitle</h5></div>
                        <div class="card-body">
                            @if (boxInfo != null)
                            {
                                <div class="alert alert-info">
                                    <strong>اطلاعات ثبت شده قبلی:</strong><br />
                                    وزن: @boxInfo.FinalWeightGrams.ToPersianNumber() گرم | قیمت: @boxInfo.FinalPrice.ToString("N0").ToPersianNumber() تومان<br />
                                    @if (!string.IsNullOrEmpty(boxInfo.AdminNotes)) { <span>یادداشت: @boxInfo.AdminNotes</span> }
                                </div>
                            }
                            <form asp-action="UpdateBoxWeight" method="post">
                                <input type="hidden" name="orderId" value="@Model.Id" />
                                <input type="hidden" name="boxTitle" value="@boxTitle" />
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label">وزن نهایی (گرم)</label>
                                        <input type="number" name="finalWeightGrams" class="form-control" required value="@(boxInfo?.FinalWeightGrams ?? 0)" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">قیمت نهایی (تومان)</label>
                                        <input type="number" name="finalPrice" class="form-control" required value="@(boxInfo?.FinalPrice ?? 0)" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">یادداشت (اختیاری)</label>
                                        <input type="text" name="adminNotes" class="form-control" value="@(boxInfo?.AdminNotes ?? "")" />
                                    </div>
                                    <div class="col-md-12 mt-3">
                                        <button type="submit" class="btn btn-success">✅ ثبت و فعال کردن دکمه پرداخت</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    <div class="mt-3 d-flex gap-2">
        <a href="/Box/Status?returnToOrder=@Model.Id" class="btn btn-success">➕ اضافه کردن جعبه جدید</a>
        <form asp-action="DeleteOrder" method="post" onsubmit="return confirm('آیا از حذف کل این سفارش اطمینان دارید؟');">
            <input type="hidden" name="orderId" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">️ حذف کل سفارش</button>
        </form>
    </div>
</div>
<div class="modal fade" id="selectSweetModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">🍪 انتخاب شیرینی جدید</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="sweetModalBody">
                <div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2">در حال بارگذاری...</p></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var sweetCategories = @Html.Raw(ViewBag.SweetListJson ?? "[]");
        var currentItemId = null;
        function escapeHtml(str) { if (!str) return ''; return str.replace(/[&<>]/g, function(m) { if (m === '&') return '&amp;'; if (m === '<') return '&lt;'; if (m === '>') return '&gt;'; return m; }); }
        function renderSweetModal() {
            var $body = $('#sweetModalBody');
            if ($body.data('rendered')) return;
            if (!sweetCategories || sweetCategories.length === 0) { $body.html('<div class="alert alert-warning">هیچ شیرینی فعالی یافت نشد.</div>'); return; }
            var html = '';
            for (var cat of sweetCategories) {
                html += '<div class="col-12 mb-3"><div class="card"><div class="card-header bg-light"><strong>📁 ' + escapeHtml(cat.category) + '</strong></div><div class="card-body"><div class="row">';
                for (var item of cat.items) {
                    html += '<div class="col-md-4 col-sm-6 mb-2"><button type="button" class="btn btn-outline-secondary w-100 text-start select-sweet-item" data-id="' + item.id + '" data-name="' + escapeHtml(item.titleFa) + '">' +
                        '<div><strong>🍪 ' + escapeHtml(item.titleFa) + '</strong></div>' +
                        '<div class="small text-muted">وزن: ~' + item.approxWeightGrams + ' گرم | قیمت: ' + item.pricePerKg.toLocaleString() + ' تومان/کیلو</div>' +
                        '</button></div>';
                }
                html += '</div></div></div></div>';
            }
            $body.html(html);
            $body.data('rendered', true);
        }
        function openEditModal(itemId) { currentItemId = itemId; renderSweetModal(); $('#selectSweetModal').modal('show'); }
        $(document).on('click', '.edit-row-btn', function() { openEditModal($(this).data('item-id')); });
        $(document).on('click', '.select-sweet-item', function() {
            var newSweetId = $(this).data('id');
            var sweetName = $(this).data('name');
            if (!confirm('آیا می‌خواهید شیرینی "' + sweetName + '" را جایگزین کنید؟')) return;
            $.ajax({
                url: '/Admin/UpdateOrderItem',
                type: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
                data: { itemId: currentItemId, newSweetItemId: newSweetId, newQuantity: 1 }
            })
                .done(function() { $('#selectSweetModal').modal('hide'); location.reload(); })
                .fail(function(xhr) { alert('خطا در ویرایش: ' + (xhr.responseText || 'خطای ناشناخته')); });
        });
    </script>
}