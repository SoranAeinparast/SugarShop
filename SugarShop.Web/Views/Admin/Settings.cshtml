@{
    ViewData["Title"] = "تنظیمات فروشگاه";
    decimal freeDeliveryThreshold = ViewBag.FreeDeliveryThreshold ?? 0m;
    decimal walletCashbackPercent = ViewBag.WalletCashbackPercent ?? 0m;
    string walletCashbackMode = ViewBag.WalletCashbackMode as string ?? "Percentage";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>⚙️ تنظیمات فروشگاه</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card">
        <div class="card-body">
            <form asp-action="Settings" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">آستانه ارسال رایگان (تومان)</label>
                    <input type="number" name="freeDeliveryThreshold" class="form-control" min="0" step="1000"
                           value="@freeDeliveryThreshold.ToString("0")" />
                    <div class="form-text">
                        اگر جمع کالاهای یک سفارش به این مبلغ برسد، هزینه پیک در محاسبه مبلغ سفارش صفر میشود.
                        مقدار صفر یعنی این سیاست غیرفعال است.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">درصد بازگشت وجه کیف پول (کش‌بک)</label>
                    <input type="number" name="walletCashbackPercent" class="form-control" min="0" max="100" step="0.5"
                           value="@walletCashbackPercent.ToString("0.##")" />
                    <div class="form-text">
                        هنگام «تحویل شد» شدن سفارش پرداخت‌شده، این درصد از مبلغ پرداخت‌شده به کیف پول مشتری برمی‌گردد.
                        همین مقدار در صفحه «تنظیمات کیف پول» هم قابل ویرایش است.
                        @if (walletCashbackMode != "Percentage")
                        {
                            <span class="text-warning">
                                توجه: حالت فعلی کش‌بک «@walletCashbackMode» است؛ ذخیره این فرم آن را به «درصدی» تغییر می‌دهد.
                            </span>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">💾 ذخیره تنظیمات</button>
            </form>
        </div>
    </div>
</div>
