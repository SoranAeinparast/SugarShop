@model SugarShop.Domain.Entities.GalleryItem
@{
    ViewData["Title"] = "ویرایش آیتم گالری";
}

<style>
    .gallery-management-header {
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 60px 0 40px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .gallery-management-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 10px;
    }
    .preview-container {
        border: 2px dashed #dee2e6;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        background: #f8f9fa;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .preview-container img, .preview-container video {
        max-width: 100%;
        max-height: 300px;
        border-radius: 8px;
    }
</style>

<!-- هدر یکپارچه -->
<div class="gallery-management-header">
    <div class="container">
        <div class="text-center">
            <h1>️ ویرایش آیتم گالری</h1>
            <p>اطلاعات اثر هنری را به‌روزرسانی کنید</p>
        </div>
    </div>
</div>

<div class="container">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">عنوان <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" required />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">دسته‌بندی</label>
                            <input asp-for="Category" class="form-control" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">توضیحات</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">ترتیب نمایش</label>
                            <input asp-for="SortOrder" type="number" class="form-control" />
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label class="form-check-label fw-bold">نمایش در گالری (فعال)</label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">فایل فعلی</label>
                            <div id="filePreviewContainer" class="preview-container mb-3">
                                @if (Model.MediaType == "Image")
                                {
                                    <img src="@Model.FilePath" alt="فایل فعلی" />
                                }
                                else
                                {
                                    <video src="@Model.FilePath" controls></video>
                                }
                            </div>
                            
                            <div class="input-group">
                                <input type="text" name="FilePath" id="filePathInput" class="form-control" readonly value="@Model.FilePath" required />
                                <button type="button" class="btn btn-outline-primary open-media-picker" 
                                        data-target="#filePathInput" 
                                        data-preview="#filePreviewContainer">
                                    <i class="bi bi-folder2-open"></i> انتخاب از کتابخانه
                                </button>
                            </div>
                            <small class="text-muted">برای جایگزینی، فایل جدید انتخاب کنید</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">تصویر بندانگشتی فعلی</label>
                            <div id="thumbPreviewContainer" class="preview-container mb-3" style="min-height: 120px;">
                                @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
                                {
                                    <img src="@Model.ThumbnailPath" alt="بندانگشتی" style="max-height: 100px;" />
                                }
                                else
                                {
                                    <span class="text-muted">ندارد</span>
                                }
                            </div>
                            
                            <div class="input-group">
                                <input type="text" name="ThumbnailPath" id="thumbPathInput" class="form-control" readonly value="@Model.ThumbnailPath" />
                                <button type="button" class="btn btn-outline-primary open-media-picker" 
                                        data-target="#thumbPathInput" 
                                        data-preview="#thumbPreviewContainer">
                                    <i class="bi bi-folder2-open"></i> انتخاب از کتابخانه
                                </button>
                            </div>
                            <small class="text-muted">برای جایگزینی، تصویر جدید انتخاب کنید</small>
                        </div>
                    </div>
                </div>
                
                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="bi bi-check-circle"></i> ذخیره تغییرات
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-circle"></i> انصراف
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.open-media-picker').forEach(btn => {
            btn.addEventListener('click', function() {
                const targetSelector = this.getAttribute('data-target');
                const previewSelector = this.getAttribute('data-preview');
                this.dataset.previewTarget = previewSelector;
            });
        });
    });
</script>
}