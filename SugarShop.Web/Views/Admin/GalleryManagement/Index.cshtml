@model IEnumerable<SugarShop.Domain.Entities.GalleryItem>
@{
    ViewData["Title"] = "مدیریت گالری";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2>📸 مدیریت گالری</h2>
        <div class="d-flex gap-2">
            <a asp-action="HeaderSettings" class="btn btn-info">
                <i class="bi bi-palette"></i> تنظیمات هدر گالری
            </a>
            <a asp-action="Create" class="btn btn-success">
                ➕ افزودن آیتم جدید
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>تصویر/ویدئو</th>
                    <th>عنوان</th>
                    <th>دسته</th>
                    <th>نوع</th>
                    <th>ترتیب</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.MediaType == "Image")
                            {
                                <img src="@item.FilePath" style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <video src="@item.FilePath" style="width: 60px; height: 60px; object-fit: cover;" controls></video>
                            }
                        </td>
                        <td>@item.Title</td>
                        <td>@item.Category</td>
                        <td>@item.MediaType</td>
                        <td>@item.SortOrder</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غیرفعال</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline-block;" onsubmit="return confirm('آیا از حذف اطمینان دارید؟');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
                            </form>
                            <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" style="display:inline-block;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")">
                                    @(item.IsActive ? "⛔ غیرفعال" : "✅ فعال")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>