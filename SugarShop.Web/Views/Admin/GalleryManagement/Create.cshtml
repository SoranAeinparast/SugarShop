@model SugarShop.Domain.Entities.GalleryItem
@{
    ViewData["Title"] = "افزودن آیتم جدید به گالری";
}

<style>
    .gallery-management-header {
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 60px 0 40px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .gallery-management-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 10px;
    }
    .gallery-management-header p {
        font-size: 1.05rem;
        opacity: 0.95;
    }
    .preview-container {
        border: 2px dashed #dee2e6;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        background: #f8f9fa;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .preview-container img, .preview-container video {
        max-width: 100%;
        max-height: 300px;
        border-radius: 8px;
    }
</style>

<!-- هدر یکپارچه -->
<div class="gallery-management-header">
    <div class="container">
        <div class="text-center">
            <h1> افزودن آیتم جدید به گالری</h1>
            <p>یک اثر هنری جدید به مجموعه گالری اضافه کنید</p>
        </div>
    </div>
</div>

<div class="container">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">عنوان <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" required placeholder="مثال: کیک تولد خاص" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">دسته‌بندی</label>
                            <input asp-for="Category" class="form-control" placeholder="مثال: تولد، عروسی، آموزش" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">توضیحات</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="توضیحات کامل اثر..."></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">ترتیب نمایش</label>
                            <input asp-for="SortOrder" type="number" class="form-control" value="0" />
                            <small class="text-muted">عدد کوچک‌تر = نمایش زودتر</small>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" checked />
                                <label class="form-check-label fw-bold">نمایش در گالری (فعال)</label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">فایل اصلی (تصویر یا ویدئو) <span class="text-danger">*</span></label>
                            
                            <div id="filePreviewContainer" class="preview-container mb-3">
                                <div class="text-muted">
                                    <i class="bi bi-image" style="font-size: 3rem;"></i>
                                    <p class="mt-2 mb-0">هنوز فایلی انتخاب نشده است</p>
                                </div>
                            </div>
                            
                            <div class="input-group">
                                <input type="text" name="FilePath" id="filePathInput" class="form-control" readonly placeholder="مسیر فایل..." required />
                                <button type="button" class="btn btn-outline-primary open-media-picker" 
                                        data-target="#filePathInput" 
                                        data-preview="#filePreviewContainer">
                                    <i class="bi bi-folder2-open"></i> انتخاب از کتابخانه
                                </button>
                            </div>
                            <small class="text-muted">برای انتخاب فایل، روی دکمه بالا کلیک کنید</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">تصویر بندانگشتی (برای ویدئوها)</label>
                            
                            <div id="thumbPreviewContainer" class="preview-container mb-3" style="min-height: 120px;">
                                <div class="text-muted">
                                    <i class="bi bi-image" style="font-size: 2rem;"></i>
                                    <p class="mt-2 mb-0 small">هنوز تصویری انتخاب نشده</p>
                                </div>
                            </div>
                            
                            <div class="input-group">
                                <input type="text" name="ThumbnailPath" id="thumbPathInput" class="form-control" readonly placeholder="مسیر تصویر..." />
                                <button type="button" class="btn btn-outline-primary open-media-picker" 
                                        data-target="#thumbPathInput" 
                                        data-preview="#thumbPreviewContainer">
                                    <i class="bi bi-folder2-open"></i> انتخاب از کتابخانه
                                </button>
                            </div>
                            <small class="text-muted">اختیاری - برای ویدئوها پیشنهاد می‌شود</small>
                        </div>
                    </div>
                </div>
                
                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="bi bi-check-circle"></i> ذخیره آیتم
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-circle"></i> انصراف
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // پیش‌نمایش فایل انتخاب‌شده از Media Picker
    document.addEventListener('DOMContentLoaded', function() {
        // وقتی فایل از Media Picker انتخاب شد، پیش‌نمایش را به‌روز کن
        document.querySelectorAll('.open-media-picker').forEach(btn => {
            btn.addEventListener('click', function() {
                const targetSelector = this.getAttribute('data-target');
                const previewSelector = this.getAttribute('data-preview');
                
                // ذخیره مرجع برای استفاده در انتخاب فایل
                this.dataset.previewTarget = previewSelector;
            });
        });
        
        // وقتی مدال بسته شد و فایلی انتخاب شده بود، پیش‌نمایش را به‌روز کن
        $('#mediaPickerModal').on('hidden.bs.modal', function() {
            // این رویداد توسط کد اصلی Media Picker مدیریت می‌شود
        });
    });
</script>
}