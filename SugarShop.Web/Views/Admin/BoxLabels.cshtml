@using SugarShop.Web.Extensions
@model SugarShop.Web.ViewModels.BoxLabelViewModel
@{
    Layout = null;
    string Grams(int g) => g.ToString("N0").ToPersianNumber() + " گرم";
    string Toman(decimal t) => t.ToString("N0").ToPersianNumber() + " تومان";

    // هر برچسب روی یک صفحه A4 چاپ می‌شود (یک برچسب در هر صفحه) تا ریز وزن‌ها خوانا بماند.
    // جعبه‌های با بیش از ۱۲ ردیف، فشرده‌تر چاپ می‌شوند تا همه ردیف‌ها در همان صفحه جا شوند.
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>برچسب وزن‌کشی سفارش @Model.OrderCode</title>
    <style>
        @@font-face {
            font-family: 'Vazir';
            src: url('/fonts/Vazir/Vazir.woff2') format('woff2');
            font-weight: 100 900;
            font-display: swap;
        }

        * { box-sizing: border-box; }

        body {
            font-family: "Vazir", Tahoma, sans-serif;
            direction: rtl;
            background: #f4f4f4;
            color: #000;
            margin: 0;
            padding: 16px;
            font-size: 13px;
        }

        .toolbar {
            max-width: 210mm;
            margin: 0 auto 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 10px 14px;
        }

        .toolbar button, .toolbar a {
            font-family: inherit;
            font-size: 13px;
            padding: 7px 14px;
            border-radius: 8px;
            border: 1px solid #ccc;
            background: #fff;
            color: #222;
            text-decoration: none;
            cursor: pointer;
        }

        .toolbar button.primary { background: #1e9e50; border-color: #1e9e50; color: #fff; font-weight: 700; }

        /* ── خود برچسب ── */
        .label {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 18px;
            background: #fff;
            border: 2px solid #000;
            padding: 8mm 7mm;
            display: flex;
            flex-direction: column;
            gap: 4mm;
        }

        .label-head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #000; padding-bottom: 4mm; }
        .brand { font-size: 19px; font-weight: 700; }
        .doc-type { font-size: 13px; color: #333; margin-top: 2px; }
        .order-badge { border: 2px solid #000; padding: 3mm 4mm; text-align: center; }
        .order-badge .code { font-size: 17px; font-weight: 700; letter-spacing: 1px; }
        .order-badge .caption { font-size: 11px; color: #444; }

        .meta { display: flex; flex-wrap: wrap; gap: 3mm 6mm; font-size: 12.5px; line-height: 1.8; }
        .meta div span { color: #555; }

        .box-title-row { display: flex; justify-content: space-between; align-items: center; background: #eee; border: 1px solid #000; padding: 2.5mm 3mm; }
        .box-title-row .box-name { font-size: 15px; font-weight: 700; }
        .tag { font-size: 11px; border: 1px solid #000; border-radius: 20px; padding: 1px 9px; }
        .tag.ok { background: #dff5e6; }
        .tag.warn { background: #fff3cd; }

        table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
        th, td { border: 1px solid #000; padding: 2.2mm 2mm; text-align: center; }
        th { background: #e8e8e8; font-weight: 700; }
        td.name { text-align: right; }
        td.approx { color: #7a5b00; }

        tfoot td { background: #f6f6f6; font-weight: 700; }

        .final { border: 2px solid #000; }
        .final-row { display: flex; }
        .final-cell { flex: 1; padding: 3.5mm 3mm; text-align: center; border-left: 1px solid #000; }
        .final-cell:last-child { border-left: none; }
        .final-cell .caption { font-size: 11.5px; color: #444; }
        .final-cell .value { font-size: 20px; font-weight: 700; margin-top: 1mm; }
        .final-cell .value.small { font-size: 15px; }

        /* جعبه‌های پرردیف: فشرده‌تر چاپ می‌شوند تا همه ردیف‌ها در یک صفحه جا شوند */
        .dense { font-size: 11.5px; gap: 3mm; }
        .dense th, .dense td { padding: 1.4mm 1.5mm; font-size: 11px; }
        .dense .brand { font-size: 16px; }
        .dense .box-title-row .box-name { font-size: 13px; }
        .dense .final-cell .value { font-size: 17px; }
        .dense .final-cell .value.small { font-size: 13.5px; }

        .note { border: 1px dashed #000; padding: 2.5mm 3mm; font-size: 12px; }
        .warn-text { font-size: 11.5px; color: #8a5a00; }

        .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 5mm; margin-top: auto; }
        .foot .qr { text-align: center; }
        .foot .qr img { width: 26mm; height: 26mm; display: block; }
        .foot .qr .hint { font-size: 10px; color: #555; margin-top: 1mm; }
        .sign { flex: 1; font-size: 12px; line-height: 2.1; }
        .sign .line { border-bottom: 1px dotted #000; display: inline-block; min-width: 45mm; }

        @@page { size: A4 portrait; margin: 0; }

        /* روی نمایشگرهای باریک (تبلت/موبایل) برچسب با عرض صفحه هم‌اندازه می‌شود */
        @@media screen and (max-width: 820px) {
            .label { width: 100%; min-height: auto; }
        }

        @@media print {
            body { background: #fff; padding: 0; font-size: 12px; }
            .no-print { display: none !important; }
            .label {
                width: 100%;
                min-height: auto;
                margin: 0;
                border: none;
                padding: 8mm 7mm;
                page-break-after: always;
                break-after: page;
            }
            .label:last-child { page-break-after: auto; break-after: auto; }
        }
    </style>
</head>
<body>
    <div class="toolbar no-print">
        <div>
            <strong>🏷️ برچسب وزن‌کشی سفارش @Model.OrderCode</strong>
            <span style="color:#666;font-size:12px;">
                — @Model.Boxes.Count.ToPersianNumber() برچسب، هر برچسب روی یک صفحه A4
            </span>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="button" class="primary" onclick="window.print()">🖨️ چاپ برچسب‌ها</button>
            <a href="@Url.Action("OrderDetails", "Admin", new { id = Model.OrderId })">🔙 بازگشت به سفارش</a>
        </div>
    </div>

    @foreach (var box in Model.Boxes)
    {
        <div class="label @(box.Rows.Count > 12 ? "dense" : "")">
            <div class="label-head">
                <div>
                    <div class="brand">@Model.StoreName</div>
                    <div class="doc-type">برچسب وزن‌کشی جعبه — وزن و قیمت این جعبه</div>
                </div>
                <div class="order-badge">
                    <div class="caption">شماره سفارش</div>
                    <div class="code">@Model.OrderCode.ToPersianNumber()</div>
                </div>
            </div>

            <div class="meta">
                <div><span>گیرنده:</span> @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "-" : Model.CustomerName)</div>
                <div><span>تلفن:</span> @(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "-" : Model.CustomerPhone.ToPersianNumber())</div>
                <div><span>تاریخ سفارش:</span> @Model.OrderDate.ToPersianNumber()</div>
                <div><span>تاریخ چاپ:</span> @Model.PrintDate.ToPersianNumber()</div>
            </div>

            <div class="box-title-row">
                <div class="box-name">📦 @box.BoxTitle — جعبه @box.BoxNumber.ToPersianNumber() از @box.BoxCount.ToPersianNumber()</div>
                @if (box.IsFinalized)
                {
                    <span class="tag ok">وزن‌کشی ثبت شد</span>
                }
                else
                {
                    <span class="tag warn">وزن‌کشی نهایی نشده</span>
                }
            </div>

            <table>
                <thead>
                    <tr>
                        <th style="width:10%;">ردیف</th>
                        <th>🍪 شیرینی</th>
                        <th style="width:12%;">تعداد</th>
                        <th style="width:22%;">⚖️ وزن ردیف (گرم)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowIndex = 1; }
                    @foreach (var row in box.Rows)
                    {
                        <tr>
                            <td>@rowIndex.ToPersianNumber()</td>
                            <td class="name">@row.Name</td>
                            <td>@row.Quantity.ToPersianNumber()</td>
                            <td class="@(row.IsApproximate ? "approx" : "")">
                                @row.WeightGrams.ToPersianNumber()@(row.IsApproximate ? " (تقریبی)" : "")
                            </td>
                        </tr>
                        rowIndex++;
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" style="text-align:right;">جمع وزن ردیف‌های این جعبه</td>
                        <td>@Grams(box.RowsWeightGrams)</td>
                    </tr>
                </tfoot>
            </table>

            <div class="final">
                <div class="final-row">
                    <div class="final-cell">
                        <div class="caption">⚖️ وزن نهایی این جعبه</div>
                        <div class="value">@Grams(box.FinalWeightGrams)</div>
                    </div>
                    <div class="final-cell">
                        <div class="caption">💰 قیمت نهایی این جعبه</div>
                        <div class="value small">@Toman(box.FinalPrice)</div>
                    </div>
                </div>
            </div>

            @if (box.RowsWeightGrams != box.FinalWeightGrams)
            {
                <div class="warn-text">
                    توجه: جمع وزن ردیف‌ها (@Grams(box.RowsWeightGrams)) با وزن نهایی اعلام‌شده جعبه (@Grams(box.FinalWeightGrams)) تفاوت دارد؛
                    مبنای قیمت‌گذاری وزن نهایی جعبه است.
                </div>
            }
            @if (!box.IsFinalized)
            {
                <div class="warn-text">این جعبه هنوز در پنل «ثبت» نشده؛ اعداد بالا با وزن تقریبی محاسبه شده‌اند و پس از وزن‌کشی باید برچسب جدید چاپ شود.</div>
            }

            @if (!string.IsNullOrWhiteSpace(box.Notes))
            {
                <div class="note"><strong>یادداشت:</strong> @box.Notes</div>
            }

            <div class="foot">
                <div class="sign">
                    <div>وزن‌کننده / بسته‌بند: <span class="line"></span></div>
                    <div>تاریخ و امضا: <span class="line"></span></div>
                </div>
                <div class="qr">
                    <img src="@Url.Action("BoxLabelQr", "Admin", new { orderId = Model.OrderId, title = box.BoxTitle, weight = box.FinalWeightGrams })"
                         alt="QR سفارش @Model.OrderCode" title="@box.QrPayload" />
                    <div class="hint">اسکن: کد سفارش | جعبه | وزن</div>
                </div>
            </div>
        </div>
    }
</body>
</html>
