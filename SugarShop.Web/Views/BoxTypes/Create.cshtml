@{
    ViewData["Title"] = "افزودن جعبه جدید";
    Layout = "_AdminLayout";
}
@model SugarShop.Domain.Entities.BoxType
<div class="card">
    <div class="card-header">
        <h4>➕ افزودن جعبه جدید</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">عنوان جعبه (مثال: نیم کیلویی)</label>
                        <input asp-for="TitleFa" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ظرفیت (گرم)</label>
                        <input asp-for="CapacityGrams" type="number" class="form-control" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">حداکثر تعداد ردیف</label>
                        <input asp-for="MaxRows" type="number" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input asp-for="SortOrder" type="number" class="form-control" value="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">فعال</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">فعال</option>
                            <option value="false">غیرفعال</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">ذخیره</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">انصراف</a>
            </div>
        </form>
    </div>
</div>
