@{
    ViewData["Title"] = "افزودن اسلایدر جدید";
    Layout = "_AdminLayout";
}
@model SugarShop.Domain.Entities.Slider
<div class="card">
    <div class="card-header">
        <h4>➕ افزودن اسلایدر جدید</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">عنوان</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">زیرنویس</label>
                        <input asp-for="Subtitle" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">متن دکمه</label>
                        <input asp-for="ButtonText" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">لینک دکمه</label>
                        <input asp-for="ButtonUrl" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input asp-for="SortOrder" type="number" class="form-control" value="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">فعال</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">فعال</option>
                            <option value="false">غیرفعال</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاریخ شروع (اختیاری)</label>
                        <input asp-for="StartAt" type="date" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاریخ پایان (اختیاری)</label>
                        <input asp-for="EndAt" type="date" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">فایل (تصویر یا ویدیو)</label>
                <input type="hidden" name="ImagePath" id="ImagePath" value="" />
                        <img id="imagePreview" src="" class="img-thumbnail mb-2" style="max-height:150px; display:none;" />
                        <button type="button" class="btn btn-outline-primary open-media-picker" data-target="#ImagePath" data-preview="#imagePreview"><i class="bi bi-image"></i> انتخاب از کتابخانه رسانه</button>
                <small class="text-muted">فرمت‌های مجاز: JPG, PNG, GIF, WEBM, MP4 (حداکثر ۱۰ مگابایت) - انتخاب فایل الزامی است</small>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">✅ ذخیره</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ انصراف</a>
            </div>
        </form>
    </div>
</div>
