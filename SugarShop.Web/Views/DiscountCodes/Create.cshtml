@using SugarShop.Domain.Entities.Sales
@{
    ViewData["Title"] = "افزودن کد تخفیف جدید";
    Layout = "_AdminLayout";
}
@model DiscountCode

@section Styles {
    <link href="~/lib/persian-datepicker/css/persian-datepicker.css" rel="stylesheet" />
}
<div class="card">
    <div class="card-header">
        <h4>➕ افزودن کد تخفیف جدید</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">کد تخفیف</label>
                        <input asp-for="Code" class="form-control" required />
                        <small class="text-muted">فقط حروف لاتین، اعداد و خط تیره مجاز است</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات (اختیاری)</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">نوع تخفیف</label>
                        <select asp-for="DiscountType" class="form-select" id="DiscountType">
                            <option value="1">درصدی (%)</option>
                            <option value="2">مبلغ ثابت (تومان)</option>
                        </select>
                    </div>
                    <div class="mb-3" id="DiscountValueDiv">
                        <label class="form-label" id="DiscountValueLabel">مقدار تخفیف (درصد)</label>
                        <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حداقل مبلغ سفارش (تومان)</label>
                        <input asp-for="MinimumOrderAmount" type="number" class="form-control" />
                        <small class="text-muted">اختیاری - اگر خالی باشد، محدودیتی ندارد</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">تاریخ شروع (شمسی)</label>
                        <persian-date asp-for="StartDate" required></persian-date>
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاریخ پایان (شمسی)</label>
                        <persian-date asp-for="EndDate" required></persian-date>
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حداکثر تعداد استفاده</label>
                        <input asp-for="UsageLimit" type="number" class="form-control" min="1" />
                        <small class="text-muted">خالی = نامحدود | این عدد کل دفعات استفاده از کد را محدود می‌کند</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">فعال</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">فعال</option>
                            <option value="false">غیرفعال</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">✅ ذخیره</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ انصراف</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $("#StartDate").persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                initialValue: false,
                observer: true,
                calendar: { persian: { locale: 'fa' } }
            });
            $("#EndDate").persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                initialValue: false,
                observer: true,
                calendar: { persian: { locale: 'fa' } }
            });
            $('#DiscountType').on('change', function () {
                var label = $('#DiscountValueLabel');
                label.text($(this).val() == '1' ? 'مقدار تخفیف (درصد)' : 'مقدار تخفیف (تومان)');
            }).trigger('change');
        });
    </script>
}