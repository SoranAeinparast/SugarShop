@using SugarShop.Domain.Entities.Sales
@{
    ViewData["Title"] = "ویرایش کد تخفیف";
    Layout = "_AdminLayout";
}
@model DiscountCode
@section Styles {
    <link href="~/lib/persian-datepicker/css/persian-datepicker.css" rel="stylesheet" />
}
<div class="card">
    <div class="card-header">
        <h4>✏️ ویرایش کد تخفیف</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">کد تخفیف</label>
                        <input asp-for="Code" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات (اختیاری)</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">نوع تخفیف</label>
                        <select asp-for="DiscountType" class="form-select" id="DiscountType">
                            <option value="1" selected="@(Model.DiscountType == DiscountType.Percentage)">درصدی (%)</option>
                            <option value="2" selected="@(Model.DiscountType == DiscountType.FixedAmount)">مبلغ ثابت (تومان)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" id="DiscountValueLabel">مقدار تخفیف</label>
                        <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حداقل مبلغ سفارش (تومان)</label>
                        <input asp-for="MinimumOrderAmount" type="number" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">تاریخ شروع</label>
                        <div class="input-group">
                            <input type="text" 
                                   id="StartDatePicker" 
                                   name="StartDate" 
                                   class="form-control persian-date-input" 
                                   value="@Model.StartDate.ToString("yyyy/MM/dd")" 
                                   autocomplete="off" 
                                   required />
                            <span class="input-group-text">
                                <i class="bi bi-calendar-event"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاریخ پایان</label>
                        <div class="input-group">
                            <input type="text" 
                                   id="EndDatePicker" 
                                   name="EndDate" 
                                   class="form-control persian-date-input" 
                                   value="@Model.EndDate.ToString("yyyy/MM/dd")" 
                                   autocomplete="off" 
                                   required />
                            <span class="input-group-text">
                                <i class="bi bi-calendar-event"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حداکثر تعداد استفاده</label>
                        <input asp-for="UsageLimit" type="number" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تعداد استفاده شده</label>
                        <input asp-for="UsedCount" type="number" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">فعال</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true" selected="@Model.IsActive">فعال</option>
                            <option value="false" selected="@(!Model.IsActive)">غیرفعال</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">💾 ذخیره تغییرات</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ انصراف</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/persian-date/persian-date.js"></script>
    <script src="~/lib/persian-datepicker/js/persian-datepicker.js"></script>
    <script>
        $(document).ready(function () {
            $("#StartDatePicker").pDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                initialValue: true,
                calendar: {
                    persian: {
                        locale: 'fa'
                    }
                }
            });

            $("#EndDatePicker").pDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                initialValue: true,
                calendar: {
                    persian: {
                        locale: 'fa'
                    }
                }
            });
            document.getElementById('DiscountType').addEventListener('change', function() {
                var label = document.getElementById('DiscountValueLabel');
                if (this.value == '1') {
                    label.innerText = 'مقدار تخفیف (درصد)';
                } else {
                    label.innerText = 'مقدار تخفیف (تومان)';
                }
            });
            document.getElementById('DiscountType').dispatchEvent(new Event('change'));
        });
    </script>
}