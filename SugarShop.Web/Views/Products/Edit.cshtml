@using SugarShop.Domain.Entities
@{
    ViewData["Title"] = "ویرایش محصول";
    Layout = "_AdminLayout";
}
@model Product
<div class="card">
    <div class="card-header">
        <h4>✏️ ویرایش محصول</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">نام محصول</label>
                        <input asp-for="TitleFa" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Slug</label>
                        <input asp-for="Slug" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">دسته‌بندی</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">انتخاب کنید</option>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.TitleFa</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">قیمت (تومان)</label>
                        <input asp-for="Price" type="number" step="1000" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">وزن (گرم) - اختیاری</label>
                        <input asp-for="WeightGrams" type="number" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">موجودی</label>
                        <input asp-for="Inventory" type="number" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input asp-for="SortOrder" type="number" class="form-control" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label">فعال</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تصویر محصول</label>
                        <input type="hidden" name="ImagePath" id="ImagePath" value="@Model.ImagePath" />
                        <img id="imagePreview" src="@Model.ImagePath" class="img-thumbnail mb-2" style="max-height:150px; @(string.IsNullOrEmpty(Model.ImagePath) ? "display:none;" : "")" />
                        <button type="button" class="btn btn-outline-primary open-media-picker" data-target="#ImagePath" data-preview="#imagePreview"><i class="bi bi-image"></i> انتخاب از کتابخانه رسانه</button>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات (اختیاری)</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">💾 ذخیره تغییرات</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ انصراف</a>
            </div>
        </form>
    </div>
</div>
