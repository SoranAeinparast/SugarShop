@model IEnumerable<SugarShop.Domain.Entities.GalleryItem>
@{
    ViewData["Title"] = "گالری تصاویر و ویدئوها";
    
    // ✅ خواندن تنظیمات هدر از ViewBag
    var headerSettings = ViewBag.HeaderSettings as SugarShop.Domain.Entities.GalleryHeaderSetting;
}

<style>
    html, body, .container, .gallery-grid, .gallery-card, .gallery-img, 
    .overlay-title, .overlay-desc, .glightbox-container, .glightbox-item, * {
        font-family: 'Vazirmatn', 'Vazir', Tahoma, sans-serif !important;
    }
    
    /* ✅ هدر داینامیک با پشتیبانی از تصویر پس‌زمینه */
    .gallery-header {
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        position: relative;
        overflow: hidden;
        min-height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 50px;
    }
    
    .gallery-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-size: cover;
        background-position: center;
        z-index: 0;
    }
    
    .gallery-header-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 1;
    }
    
    .gallery-header-content {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 60px 20px;
    }
    
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.8rem;
        margin-bottom: 3rem;
    }
    .gallery-card {
        position: relative;
        border-radius: 1.2rem;
        overflow: hidden;
        background: #f8f9fa;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        transition: 0.3s;
        cursor: pointer;
    }
    .gallery-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 30px rgba(0,0,0,0.15);
    }
    .gallery-img {
        width: 100%;
        height: 260px;
        object-fit: cover;
        transition: transform 0.5s;
        display: block;
    }
    .gallery-card:hover .gallery-img {
        transform: scale(1.03);
    }
    .gallery-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0));
        color: white;
        padding: 1.2rem;
        opacity: 0;
        transition: opacity 0.3s;
        border-radius: 0 0 1.2rem 1.2rem;
    }
    .gallery-card:hover .gallery-overlay {
        opacity: 1;
    }
    .overlay-title {
        font-size: 1.1rem;
        font-weight: bold;
        margin-bottom: 0.3rem;
    }
    .overlay-desc {
        font-size: 0.8rem;
        opacity: 0.9;
    }
    .video-play-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.8;
        transition: 0.3s;
        pointer-events: none;
    }
    .video-play-icon i {
        font-size: 4rem;
        color: white;
        filter: drop-shadow(0 2px 5px rgba(0,0,0,0.3));
    }
    .gallery-card:hover .video-play-icon {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1.05);
    }
    .glightbox-container {
        font-family: 'Vazirmatn', 'Vazir', Tahoma, sans-serif !important;
    }
    .glightbox-container .gslide-description {
        background: rgba(0,0,0,0.65) !important;
        border-radius: 0.8rem !important;
        padding: 1rem 1.5rem !important;
        backdrop-filter: blur(8px) !important;
        direction: rtl !important;
        text-align: right !important;
    }
    .glightbox-container .gslide-title {
        font-family: inherit !important;
        font-size: 1.4rem !important;
        font-weight: bold !important;
        color: #ffffff !important;
        margin-bottom: 0.5rem !important;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5) !important;
    }
    .glightbox-container .gslide-desc {
        font-family: inherit !important;
        font-size: 0.95rem !important;
        line-height: 1.6 !important;
        color: #f5f5f5 !important;
        text-shadow: 0 1px 2px rgba(0,0,0,0.4) !important;
    }
    .glightbox-container .gclose,
    .glightbox-container .gprev,
    .glightbox-container .gnext {
        background-color: rgba(0,0,0,0.5) !important;
        backdrop-filter: blur(8px);
        border-radius: 50% !important;
        transition: all 0.2s ease;
    }
    .glightbox-container .gclose:hover,
    .glightbox-container .gprev:hover,
    .glightbox-container .gnext:hover {
        background-color: rgba(0,0,0,0.8) !important;
        transform: scale(1.05);
    }
    
    @@media (max-width: 768px) {
        .gallery-header {
            min-height: 250px;
        }
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
        }
        .gallery-img {
            height: 220px;
        }
        .video-play-icon i {
            font-size: 3rem;
        }
        .glightbox-container .gslide-title {
            font-size: 1.1rem !important;
        }
        .glightbox-container .gslide-desc {
            font-size: 0.85rem !important;
        }
        .glightbox-container .gslide-description {
            padding: 0.8rem 1rem !important;
        }
    }
</style>

@* ✅ هدر داینامیک با پشتیبانی از تصویر پس‌زمینه *@
@if (headerSettings != null && headerSettings.IsEnabled)
{
    <div class="gallery-header" style="min-height: @(headerSettings.Height)px;">
        @if (!string.IsNullOrEmpty(headerSettings.BackgroundImagePath))
        {
            <div class="gallery-header-bg" style="background-image: url('@headerSettings.BackgroundImagePath');"></div>
            <div class="gallery-header-overlay"></div>
        }
        else
        {
            <div class="gallery-header-bg" style="background: @headerSettings.BackgroundColor;"></div>
        }
        
        <div class="gallery-header-content" style="color: @headerSettings.TextColor;">
            <h1 class="display-4 fw-bold mb-3">@headerSettings.Title</h1>
            <p class="lead mb-0" style="font-size: 1.2rem; opacity: 0.95;">@headerSettings.Subtitle</p>
        </div>
    </div>
}
else
{
    @* هدر پیش‌فرض اگر تنظیمات وجود نداشت *@
    <div class="gallery-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="gallery-header-content" style="color: white;">
            <h1 class="display-4 fw-bold mb-3"> گالری تصاویر و ویدئوها</h1>
            <p class="lead mb-0" style="font-size: 1.2rem; opacity: 0.95;">نمونه‌ای از آثار هنری و شیرینی‌های خاص ما</p>
        </div>
    </div>
}

<div class="container my-5">
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-5 rounded-4">
            <h5>هنوز محتوایی در گالری ثبت نشده است.</h5>
        </div>
    }
    else
    {
        <div class="gallery-grid">
            @foreach (var item in Model)
            {
                <div class="gallery-card">
                    @if (item.MediaType == "Image")
                    {
                        <a href="@item.FilePath" class="glightbox-item" data-gallery="sugarshop-gallery" data-title="@item.Title" data-description="@item.Description">
                            <img src="@item.FilePath" alt="@item.Title" class="gallery-img" loading="lazy" />
                            <div class="gallery-overlay">
                                <div class="overlay-content">
                                    <h5 class="overlay-title">@item.Title</h5>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="overlay-desc">@item.Description</p>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                    else
                    {
                        <a href="@item.FilePath" class="glightbox-item" data-gallery="sugarshop-gallery" data-type="video" data-title="@item.Title" data-description="@item.Description">
                            <img src="@(item.ThumbnailPath ?? "/images/video-placeholder.jpg")" alt="@item.Title" class="gallery-img" loading="lazy" />
                            <div class="video-play-icon">
                                <i class="bi bi-play-circle-fill"></i>
                            </div>
                            <div class="gallery-overlay">
                                <div class="overlay-content">
                                    <h5 class="overlay-title">@item.Title</h5>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="overlay-desc">@item.Description</p>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    }
</div>

<link rel="stylesheet" href="~/lib/glightbox/css/glightbox.min.css" asp-append-version="true" />
<script src="~/lib/glightbox/js/glightbox.min.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof GLightbox !== 'undefined') {
            const lightbox = GLightbox({
                touchNavigation: true,
                loop: true,
                autoplayVideos: true,
                zoomable: true,
                draggable: true,
                slideEffect: 'fade',
                moreLength: 0,
                selector: '.glightbox-item'
            });
            console.log('✅ GLightbox initialized successfully from local files');
        } else {
            console.error('❌ GLightbox library not loaded. Check file paths in wwwroot/lib/glightbox/');
        }
    });
</script>