@using SugarShop.Domain.Entities.Sales
@using SugarShop.Web.ViewModels
@model List<OrderListItemViewModel>
@using MD.PersianDateTime
@{
    ViewData["Title"] = "سفارشات من";
}
<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">📋 سفارشات من</h2>
        <a href="@Url.Action("Index", "Profile")" class="btn btn-secondary">🔙 بازگشت به داشبورد کاربری</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-4 shadow-sm p-5 text-center">
            <div class="alert alert-info border-0 mb-0">شما هنوز سفارشی ثبت نکرده‌اید.</div>
            <a href="/Home/Index" class="btn btn-primary mt-3">شروع خرید</a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-4 shadow-sm p-4">
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>کد سفارش</th>
                            <th>قیمت نهایی</th>
                            <th>وضعیت سفارش</th>
                            <th>وضعیت پرداخت</th>
                            <th>تاریخ</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="align-middle">@order.OrderCode</td>
                                <td class="align-middle">
                                    @if (order.TotalFinalPrice > 0)
                                    {
                                        <span class="text-success">@order.TotalFinalPrice.ToString("N0").ToPersianNumber() تومان</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">اعلام نشده</span>
                                    }
                                </td>
                                <td class="align-middle">@order.OrderStatus.ToFarsi()</td>
                                <td class="align-middle">@order.PaymentStatus.ToFarsi()</td>
                                <td>
                                    @{
                                        var persianDate = new PersianDateTime(@order.CreatedAt);
                                        var dateString = persianDate.ToString("yyyy/MM/dd");
                                    }
                                    @dateString.ToPersianNumber()
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex gap-2 flex-wrap align-items-center">
                                        <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-primary d-inline-flex align-items-center justify-content-center" style="height: 31px;">جزئیات</a>
                                        @if (order.IsPaymentEnabled && order.PaymentStatus == PaymentStatus.Unpaid)
                                        {
                                            <form asp-action="PayOrder" method="post" class="d-inline-flex m-0 p-0" style="height: 31px;">
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <button type="submit" class="btn btn-sm btn-success d-inline-flex align-items-center justify-content-center w-100 h-100">💳 پرداخت</button>
                                            </form>
                                        }
                                        @if (order.IsDeletable)
                                        {
                                            <form asp-action="DeleteOrder" method="post" class="d-inline-flex m-0 p-0" onsubmit="return confirm('آیا از حذف این سفارش اطمینان دارید؟');" style="height: 31px;">
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger d-inline-flex align-items-center justify-content-center w-100 h-100">🗑️ حذف</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>