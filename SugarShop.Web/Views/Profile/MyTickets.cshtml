@using SugarShop.Domain.Entities
@model List<Ticket>
@{
    ViewData["Title"] = "پیام‌های من";
}
<div class="container mt-4">
        <h2>📋 پیام‌های من</h2>
        <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="@Url.Action("Ticket")" class="btn btn-primary mb-3">➕ پیام جدید</a>
    <a href="@Url.Action("Index", "Profile")" class="btn btn-secondary mb-3">🔙 بازگشت به داشبورد کاربری</a>    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>موضوع</th>
                    <th>وضعیت</th>
                    <th>تاریخ</th>
                    <th style="min-width: 200px;">پاسخ مدیر</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model)
                {
                    <tr>
                        <td>@ticket.Subject</td>
                        <td>
                            @if (ticket.Status == TicketStatus.Open)
                            {
                                <span class="badge bg-danger">باز</span>
                            }
                            else if (ticket.Status == TicketStatus.Answered)
                            {
                                <span class="badge bg-success">پاسخ داده شده</span>
                            }
                            else if (ticket.Status == TicketStatus.Closed)
                            {
                                <span class="badge bg-secondary">بسته</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">در حال بررسی</span>
                            }
                        </td>
                        <td>@ticket.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(ticket.AdminResponse))
                            {
                                <div class="alert alert-info mb-0 p-2">
                                    @ticket.AdminResponse
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">در انتظار پاسخ</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

