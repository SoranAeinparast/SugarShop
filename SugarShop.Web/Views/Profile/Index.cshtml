@using SugarShop.Domain.Entities
@using SugarShop.Domain.Entities.Sales
@using SugarShop.Web.ViewModels
@using SugarShop.Web.Extensions
@using MD.PersianDateTime
@model DashboardViewModel
@{
    ViewData["Title"] = "داشبورد کاربری";
    string ToPersianNumber(string input) => input.ToPersianNumber();
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-4">📋 داشبورد کاربری</h2>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">🔙 خروج از داشبورد کاربری</a>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">👤 پروفایل من</h5>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.AvatarPath))
                        {
                            <img src="@Model.AvatarPath" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                <span style="font-size: 3rem;">👤</span>
                            </div>
                        }
                    </div>
                    <h5>@Model.FullName</h5>
                    <p class="text-muted">@Model.Email</p>
                    <p>📞 @(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber.ToPersianNumber() : "ثبت نشده")</p>
                    @if (Model.BirthDate.HasValue)
                    {
                        var persianBirth = new PersianDateTime(Model.BirthDate.Value);
                        <p>🎂 @persianBirth.ToString("yyyy/MM/dd").ToPersianNumber()</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Gender))
                    {
                        <p>⚥ @(Model.Gender == "Male" ? "مرد" : (Model.Gender == "Female" ? "زن" : "سایر"))</p>
                    }
                    @if (Model.DefaultAddress != null)
                    {
                        <hr />
                        <p class="mb-0"><strong>آدرس پیش‌فرض:</strong></p>
                        <p class="small">@Model.DefaultAddress.FullAddress</p>
                        <p class="small">کد پستی: @Model.DefaultAddress.PostalCode.ToPersianNumber()</p>
                    }
                    else
                    {
                        <hr />
                        <p class="text-muted">آدرس پیش‌فرض ثبت نشده است.</p>
                    }
                    <div class="mt-3">
                        <a asp-action="EditProfile" class="btn btn-sm btn-outline-secondary">✏️ ویرایش پروفایل</a>
                        <a asp-controller="Address" asp-action="Index" class="btn btn-sm btn-outline-secondary">📍 آدرس‌ها</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="row g-4">
                <div class="col-sm-6">
                    <div class="card text-white bg-primary h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-title text-white-50">سفارشات</h6>
                                    <h3 class="mb-0">@Model.TotalOrders.ToPersianNumber()</h3>
                                </div>
                                <span style="font-size: 2rem;">🛒</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-2">
                            <div class="row text-center small">
                                <div class="col-6 border-end">
                                    <span class="text-white-50">در انتظار پرداخت</span><br />
                                    <strong>@Model.PendingPaymentOrders.ToPersianNumber()</strong>
                                </div>
                                <div class="col-6">
                                    <span class="text-white-50">تحویل شده</span><br />
                                    <strong>@Model.DeliveredOrders.ToPersianNumber()</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card text-white bg-success h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-title text-white-50">کیف پول</h6>
                                    <h3 class="mb-0">@Model.WalletBalance.ToString("N0").ToPersianNumber()</h3>
                                    <small>تومان</small>
                                </div>
                                <span style="font-size: 2rem;">💰</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-center p-2 d-flex justify-content-around">
                            <a asp-action="Wallet" class="btn btn-sm btn-outline-light">مدیریت کیف پول</a>
                            <a asp-controller="Wallet" asp-action="Recharge" class="btn btn-sm btn-outline-light">💳 شارژ کیف پول</a>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card text-white bg-warning h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-title text-dark">پیام‌ها</h6>
                                    <h3 class="mb-0 text-dark">@Model.OpenTickets.ToPersianNumber()</h3>
                                    <small class="text-dark">پیام باز</small>
                                </div>
                                <span style="font-size: 2rem;">🎫</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-center p-2">
                            <a asp-action="MyTickets" class="btn btn-sm btn-outline-dark">مشاهده پیام‌ها</a>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card text-dark bg-light h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-title">آخرین سفارش</h6>
                                    @if (Model.LastOrder != null)
                                    {
                                        <p class="mb-0"><strong>@Model.LastOrder.OrderCode</strong></p>
                                        <small>@{
                                            var lastOrderDate = new PersianDateTime(Model.LastOrder.CreatedAt);
                                            @lastOrderDate.ToString("yyyy/MM/dd").ToPersianNumber()
                                        }</small>
                                        <div>
                                            <span class="badge bg-@(Model.LastOrder.OrderStatus switch {
                                                OrderStatus.PendingPayment => "warning",
                                                OrderStatus.Paid => "info",
                                                OrderStatus.Preparing => "primary",
                                                OrderStatus.Delivered => "success",
                                                OrderStatus.Cancelled => "danger",
                                                _ => "secondary"
                                            })">@Model.LastOrder.OrderStatus</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">هیچ سفارشی ثبت نکرده‌اید.</p>
                                    }
                                </div>
                                <span style="font-size: 2rem;">📄</span>
                            </div>
                        </div>
                        @if (Model.LastOrder != null)
                        {
                            <div class="card-footer bg-transparent border-0 text-center p-2">
                                <a asp-action="OrderDetails" asp-route-id="@Model.LastOrder.Id" class="btn btn-sm btn-outline-secondary">مشاهده جزئیات</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
<div class="card shadow-sm mt-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">دسترسی سریع</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-6 col-md-3">
                <a asp-action="Orders" class="btn btn-outline-secondary w-100 py-3">
                    📋 سفارشات من
                </a>
            </div>
            <div class="col-sm-6 col-md-3">
                <a asp-action="Wallet" class="btn btn-outline-success w-100 py-3">
                    💰 کیف پول
                </a>
            </div>
            <div class="col-sm-6 col-md-3">
                <a asp-action="MyTickets" class="btn btn-outline-warning w-100 py-3">
                    🎫 پیام‌های من
                </a>
            </div>
            <div class="col-sm-6 col-md-3">
                <a asp-controller="Birthday" asp-action="Index" class="btn btn-outline-info w-100 py-3">
                    🎉 ثبت سالگردهای تولد
                </a>
            </div>
            <div class="col-sm-6 col-md-6">
                <a asp-action="CustomCakeOrders" class="btn btn-outline-danger w-100 py-3">
                    🎂 سفارش کیکهای دلخواه
                </a>
            </div>
        </div>
    </div>
</div>
        </div>
    </div>
</div>
