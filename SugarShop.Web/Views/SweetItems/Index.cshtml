@{
    ViewData["Title"] = "مدیریت شیرینی‌ها";
    Layout = "_AdminLayout";
}
@model List<SugarShop.Domain.Entities.SweetItem>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4>🍪 لیست شیرینی‌ها</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary">➕ افزودن جدید</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>تصویر</th>
                        <th>نام</th>
                        <th>دسته</th>
                        <th>وزن تقریبی</th>
                        <th>قیمت کیلویی</th>
                        <th>موجودی</th>
                        <th>فعال</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" width="50" height="50" style="object-fit: cover; border-radius: 8px;" loading="lazy" />
                                }
                                else
                                {
                                    <span style="font-size: 1.5rem;">🍪</span>
                                }
                            </td>
                            <td class="align-middle">@item.TitleFa</td>
                            <td class="align-middle">@(item.Category?.TitleFa ?? "-")</td>
                            <td class="align-middle">@item.ApproxWeightGrams گرم</td>
                            <td class="align-middle">@item.PricePerKg.ToString("N0") تومان</td>
                            <td class="align-middle">@item.InventoryCount</td>
                            <td class="align-middle">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">غیرفعال</span>
                                }
                            </td>
                            <td class="align-middle">
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-warning">✏️ ویرایش</a>
                                <form asp-action="Delete" method="post" style="display:inline-block;" onsubmit="return confirm('حذف شود؟')">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">🗑️ حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </table>
                @if (ViewBag.TotalPages > 1)
                {
                    <nav><ul class="pagination">...</ul></nav>
                }
        </div>
    </div>
</div>
