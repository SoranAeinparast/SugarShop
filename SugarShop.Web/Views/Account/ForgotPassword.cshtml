@{ ViewData["Title"] = "فراموشی رمز عبور"; Layout = "_Layout"; }
<style>
    .auth-page { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; }
    .auth-card { background: white; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); max-width: 450px; width: 100%; overflow: hidden; }
    .auth-header { background: linear-gradient(135deg, #d4a056 0%, #b8860b 100%); padding: 30px 20px; text-align: center; color: white; }
    .form-content { padding: 30px; }
    .form-group { margin-bottom: 20px; }
    .form-label { font-weight: 600; color: #495057; margin-bottom: 8px; display: block; }
    .input-wrapper { position: relative; }
    .input-wrapper i.input-icon { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: #d4a056; }
    .form-control { width: 100%; padding: 12px 45px 12px 15px; border: 2px solid #e9ecef; border-radius: 10px; }
    .form-control:focus { border-color: #d4a056; box-shadow: 0 0 0 3px rgba(212, 160, 86, 0.1); outline: none; }
    .btn-auth { width: 100%; padding: 14px; background: linear-gradient(135deg, #d4a056 0%, #b8860b 100%); color: white; border: none; border-radius: 10px; font-size: 1rem; font-weight: 700; cursor: pointer; }
    .btn-auth:hover { transform: translateY(-2px); }
    .btn-auth:disabled { opacity: 0.7; cursor: not-allowed; }
    .back-link { display: block; text-align: center; margin-top: 20px; color: #d4a056; text-decoration: none; font-weight: 600; }
    .info-box { background: #fff3cd; border-right: 4px solid #d4a056; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-size: 0.9rem; color: #856404; }
    .spinner { display: inline-block; width: 20px; height: 20px; border: 3px solid rgba(255,255,255,0.3); border-radius: 50%; border-top-color: white; animation: spin 1s infinite; margin-left: 8px; vertical-align: middle; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header"><h2>🔐 فراموشی رمز عبور</h2><p>نگران نباشید! لینک بازیابی برایتان ارسال می‌شود</p></div>
        <div class="form-content">
            <div class="info-box"><i class="bi bi-info-circle"></i> ایمیلی که هنگام ثبت‌نام وارد کرده‌اید را وارد کنید.</div>
            <form id="forgotPasswordForm">
                <div class="form-group">
                    <label class="form-label">ایمیل <span style="color: #dc3545;">*</span></label>
                    <div class="input-wrapper">
                        <i class="bi bi-envelope input-icon"></i>
                        <input type="email" name="Email" class="form-control" placeholder="example@email.com" required />
                    </div>
                </div>
                <button type="submit" class="btn-auth" id="forgotBtn"><i class="bi bi-send"></i> ارسال لینک بازیابی</button>
            </form>
            <a href="@Url.Action("Login")" class="back-link"><i class="bi bi-arrow-right"></i> بازگشت به صفحه ورود</a>
        </div>
    </div>
</div>
@section Scripts {
<script>
    $(function() {
        $('#forgotPasswordForm').submit(function(e) {
            e.preventDefault();
            var $btn = $('#forgotBtn');
            var originalText = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner"></span> در حال ارسال...');
            $.ajax({
                url: '/Account/ForgotPassword', type: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                data: $(this).serialize(),
                success: function(response) {
                    Swal.fire({ icon: response.type || 'info', title: response.type === 'success' ? 'ارسال شد' : 'توجه', text: response.message, confirmButtonColor: '#d4a056' })
                        .then(() => { if (response.success) window.location.href = '@Url.Action("Login")'; });
                },
                error: function() { Swal.fire({ icon: 'error', title: 'خطا', text: 'خطا در ارتباط با سرور.', confirmButtonColor: '#dc3545' }); },
                complete: function() { $btn.prop('disabled', false).html(originalText); }
            });
        });
    });
</script>
}