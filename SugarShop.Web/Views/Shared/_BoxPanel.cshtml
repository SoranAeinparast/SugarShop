@using SugarShop.Web.SessionModels
@using SugarShop.Web.Extensions
@model BoxSessionState
@{
    var selectedBox = ViewBag.SelectedBoxType as SugarShop.Domain.Entities.BoxType;
    var boxTypes = ViewBag.BoxTypes as List<SugarShop.Domain.Entities.BoxType>;
}
<div class="box-panel-wrapper">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-gradient-primary text-white border-0 py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-box-seam"></i> 📦 جعبه شیرینی
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-cake2 fs-5 text-warning"></i>
                        <h6 class="fw-bold mb-0">انتخاب جعبه</h6>
                    </div>
                    <div class="box-type-list">
                        @foreach (var box in boxTypes!)
                        {
                            <div class="box-card @(selectedBox?.Id == box.Id ? "active" : "")" data-box-id="@box.Id">
                                <div class="box-card-icon">
                                    <i class="bi bi-gift-fill"></i>
                                </div>
                                <div class="box-card-info">
                                    <div class="box-card-title">@box.TitleFa</div>
                                    <div class="box-card-meta">
                                        <span><i class="bi bi-egg-fried"></i> @box.CapacityGrams.ToPersianNumber() گرم</span>
                                        <span class="mx-1">•</span>
                                        <span><i class="bi bi-layout-three-columns"></i> @box.MaxRows.ToPersianNumber() ردیف</span>
                                    </div>
                                </div>
                                <div class="box-card-action">
                                    @if (selectedBox?.Id != box.Id)
                                    {
                                        <button class="btn-select-box btn btn-sm btn-warning rounded-pill px-3" data-box-id="@box.Id">
                                            <i class="bi bi-check-lg"></i> انتخاب
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill"></i> انتخاب شده
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-list-ul fs-5 text-warning"></i>
                        <h6 class="fw-bold mb-0">محتویات جعبه</h6>
                    </div>
                    <div id="boxItemsList" class="box-items-container">
                        @if (Model.Items.Count == 0)
                        {
                            <div class="empty-box-message text-center py-5">
                                <i class="bi bi-box-seam display-4 text-muted"></i>
                                <p class="text-muted mt-2 mb-0">جعبه خالی است. از شیرینی‌های زیر اضافه کنید.</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group rounded-3 overflow-hidden">
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    var item = Model.Items[i];
                                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 py-3 px-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <i class="bi bi-cup-straw fs-4 text-secondary"></i>
                                            <div>
                                                <div class="fw-semibold">@item.TitleFaSnapshot</div>
                                            </div>
                                        </div>
                                        <button class="remove-row btn btn-sm btn-outline-danger rounded-pill" data-row-index="@i">
                                            <i class="bi bi-trash3"></i> حذف
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="row mt-3 g-2">
                        <div class="col-6">
                            <div class="stat-card">
                                <i class="bi bi-layout-three-columns"></i>
                                <div>
                                    <small class="text-muted">ردیف‌ها</small>
                                    <div class="fw-bold">@Model.TotalRowsUsed.ToPersianNumber() / @(selectedBox?.MaxRows.ToPersianNumber() ?? "۰")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card">
                                <i class="bi bi-egg-fried"></i>
                                <div>
                                    <small class="text-muted">وزن تقریبی</small>
                                    <div class="fw-bold">@Model.TotalApproxWeightGrams.ToPersianNumber() / @(selectedBox?.CapacityGrams.ToPersianNumber() ?? "۰") گرم</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button id="clearBoxBtn" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-trash"></i> خالی کردن جعبه
                        </button>
                        <button id="changeBoxBtn" class="btn btn-outline-warning rounded-pill px-4">
                            <i class="bi bi-arrow-repeat"></i> تغییر جعبه
                        </button>
                        <button id="addToCartFromBox" class="btn btn-success rounded-pill px-4 ms-auto">
                            <i class="bi bi-cart-plus"></i> افزودن به سبد خرید
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

