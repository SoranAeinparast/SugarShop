@model SugarShop.Domain.Entities.EducationalContent
@* ============================================================
   ویرایشگر متن بصری (WYSIWYG) - کاملاً داخلی و بدون وابستگی خارجی
   محتوای نهایی به فیلد پنهان BodyHtml منتقل می‌شود و سمت سرور
   پاک‌سازی امنیتی می‌شود.
   ============================================================ *@
<div class="rich-editor" id="richEditor">
    <input type="hidden" id="richEditorDraft" />

    <div class="rich-toolbar" role="toolbar" aria-label="نوار ابزار ویرایشگر متن">
        <select id="richBlockSel" class="rich-block-select form-select form-select-sm" title="قالب متن" aria-label="قالب متن">
            <option value="p">متن ساده</option>
            <option value="h2">عنوان بخش</option>
            <option value="h3">عنوان فرعی</option>
        </select>

        <span class="rich-sep"></span>

        <button type="button" class="rich-btn" data-cmd="bold" title="ضخیم"><i class="bi bi-type-bold"></i></button>
        <button type="button" class="rich-btn" data-cmd="italic" title="کج"><i class="bi bi-type-italic"></i></button>
        <button type="button" class="rich-btn" data-cmd="underline" title="زیرخط"><i class="bi bi-type-underline"></i></button>
        <button type="button" class="rich-btn" data-cmd="strikeThrough" title="خط‌خورده"><i class="bi bi-type-strikethrough"></i></button>

        <span class="rich-sep"></span>

        <button type="button" class="rich-btn" data-cmd="insertUnorderedList" title="لیست نقطه‌ای"><i class="bi bi-list-ul"></i></button>
        <button type="button" class="rich-btn" data-cmd="insertOrderedList" title="لیست شماره‌دار"><i class="bi bi-list-ol"></i></button>
        <button type="button" class="rich-btn" data-cmd="formatBlock" data-value="blockquote" title="نقل‌قول / نکته"><i class="bi bi-quote"></i></button>
        <button type="button" class="rich-btn" data-cmd="insertHorizontalRule" title="خط جداکننده"><i class="bi bi-dash-lg"></i></button>

        <span class="rich-sep"></span>

        <button type="button" class="rich-btn" id="richLinkBtn" title="افزودن لینک"><i class="bi bi-link-45deg"></i></button>
        <button type="button" class="rich-btn open-media-picker" id="richImageBtn" data-target="#richEditorDraft" data-preview="" title="افزودن تصویر از کتابخانه رسانه"><i class="bi bi-image"></i></button>

        <span class="rich-sep"></span>

        <button type="button" class="rich-btn" data-cmd="removeFormat" title="پاک‌سازی قالب"><i class="bi bi-eraser"></i></button>
        <button type="button" class="rich-btn" data-cmd="undo" title="بازگردانی"><i class="bi bi-arrow-counterclockwise"></i></button>
        <button type="button" class="rich-btn" data-cmd="redo" title="ازنو"><i class="bi bi-arrow-clockwise"></i></button>

        <span class="rich-sep"></span>

        <button type="button" class="rich-btn" id="richHtmlBtn" title="ویرایش کد HTML"><i class="bi bi-code-slash"></i></button>
    </div>

    <div class="rich-link-panel d-none" id="richLinkPanel">
        <div class="d-flex gap-1 align-items-center">
            <input type="text" id="richLinkUrl" class="form-control form-control-sm" dir="ltr" placeholder="https://example.com  یا  /Admin/…" />
            <button type="button" id="richLinkApply" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-check-lg"></i> اعمال</button>
            <button type="button" id="richLinkUnlink" class="btn btn-sm btn-outline-danger" title="حذف لینک"><i class="bi bi-unlink"></i></button>
            <button type="button" id="richLinkClose" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i></button>
        </div>
    </div>

    <div id="richEditorBody" class="rich-article" contenteditable="true" dir="rtl" lang="fa"
         data-placeholder="متن مقاله را اینجا بنویسید… (برای تصویر، دکمه تصویر را بزنید و از کتابخانه رسانه انتخاب کنید)">@Html.Raw(Model.BodyHtml)</div>

    <textarea id="richEditorSource" class="rich-source form-control d-none" dir="ltr" rows="16" spellcheck="false" aria-label="کد HTML محتوا"></textarea>

    @* فیلد واقعی فرم که مقدار نهایی به آن منتقل می‌شود *@
    <textarea asp-for="BodyHtml" id="BodyHtml" class="d-none" tabindex="-1" aria-hidden="true"></textarea>
</div>

<style>
    .rich-editor { width: 100%; direction: rtl; }
    .rich-toolbar {
        display: flex; flex-wrap: wrap; gap: 4px; align-items: center;
        padding: 8px; background: #f8f9fa; border: 1px solid #d5dbe1;
        border-bottom: none; border-radius: 10px 10px 0 0;
    }
    .rich-block-select { width: 120px; padding: 3px 6px !important; font-size: 0.85rem !important; }
    .rich-sep { width: 1px; height: 22px; background: #dee2e6; margin: 0 3px; flex: 0 0 auto; }
    .rich-btn {
        width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid #dee2e6; background: #fff; color: #495057; border-radius: 6px;
        cursor: pointer; transition: background .15s, color .15s, border-color .15s; padding: 0;
    }
    .rich-btn:hover { background: #e9ecef; color: #0d6efd; }
    .rich-btn.active { background: #0d6efd !important; border-color: #0d6efd !important; color: #fff !important; }
    .rich-btn:disabled { opacity: .35; cursor: not-allowed; }
    .rich-btn i { font-size: 1rem; line-height: 1; }

    .rich-article {
        min-height: 300px; max-height: 620px; overflow-y: auto;
        background: #fff; border: 1px solid #d5dbe1; border-radius: 0 0 10px 10px;
        padding: 18px 20px; font-size: 1rem; line-height: 1.9; color: #2c3e50;
        outline: none; word-break: break-word;
    }
    .rich-article:focus { border-color: #86b7fe; box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .12); }
    .rich-article:empty:before { content: attr(data-placeholder); color: #a7b0b8; pointer-events: none; }

    .rich-link-panel {
        padding: 8px; background: #fff; border: 1px solid #d5dbe1; border-top: none;
    }
    .rich-link-panel input { min-width: 260px; }

    .rich-source {
        border-radius: 0 0 10px 10px !important; font-family: Consolas, 'Courier New', monospace;
        font-size: 0.85rem; direction: ltr; text-align: left; min-height: 300px;
    }

    /* پیش‌نمایش وفادار به استایل صفحه عمومی مقاله */
    .rich-article h2 {
        color: #c8903c; border-right: 4px solid #d4a056; padding-right: 14px;
        margin: 1.6rem 0 0.9rem; font-weight: 700; font-size: 1.45rem; line-height: 1.5;
    }
    .rich-article h3 { color: #c8903c; margin: 1.3rem 0 0.7rem; font-weight: 700; font-size: 1.2rem; }
    .rich-article h4 { font-weight: 700; margin: 1rem 0 0.5rem; }
    .rich-article p { margin-bottom: 1rem; }
    .rich-article ul, .rich-article ol { padding-right: 1.6rem; margin-bottom: 1rem; }
    .rich-article li { margin-bottom: .35rem; }
    .rich-article blockquote {
        border-right: 4px solid #d4a056; background: #fff8ec; padding: 10px 16px;
        border-radius: 8px; color: #6b4e16; margin: 1rem 0;
    }
    .rich-article img { max-width: 100%; height: auto; border-radius: 8px; }
    .rich-article a { color: #0d6efd; }
    .rich-article hr { border: 0; border-top: 1px dashed #ced4da; margin: 1.4rem 0; }
    .rich-article table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    .rich-article table th, .rich-article table td { border: 1px solid #dee2e6; padding: 6px 10px; }
    .rich-article pre, .rich-article code { background: #f1f3f5; border-radius: 6px; }
    .rich-article code { padding: 2px 6px; }
    .rich-article pre { padding: 10px; overflow-x: auto; direction: ltr; text-align: left; }
</style>

<script>
(function () {
    'use strict';
    var root = document.getElementById('richEditor');
    if (!root) return;
    var body = document.getElementById('richEditorBody');
    var source = document.getElementById('richEditorSource');
    var hidden = document.getElementById('BodyHtml');
    var draft = document.getElementById('richEditorDraft');
    var blockSel = document.getElementById('richBlockSel');
    var htmlBtn = document.getElementById('richHtmlBtn');
    var linkPanel = document.getElementById('richLinkPanel');
    var linkUrl = document.getElementById('richLinkUrl');
    var sourceMode = false;
    var savedRange = null;

    function insideEditor(node) { return node && body && (node === body || body.contains(node)); }

    function saveSelection() {
        try {
            var sel = window.getSelection();
            if (sel && sel.rangeCount && sel.rangeCount > 0) {
                var r = sel.getRangeAt(0);
                if (insideEditor(r.commonAncestorContainer)) savedRange = r.cloneRange();
            }
        } catch (e) { }
    }
    document.addEventListener('selectionchange', saveSelection);
    body.addEventListener('keyup', saveSelection);
    body.addEventListener('mouseup', saveSelection);

    function focusBody() {
        body.focus();
        if (savedRange) {
            try {
                if (insideEditor(savedRange.commonAncestorContainer)) {
                    var s = window.getSelection();
                    s.removeAllRanges();
                    s.addRange(savedRange);
                }
            } catch (e) { }
        }
    }

    function currentBlockTag() {
        try {
            var sel = window.getSelection();
            if (!sel.rangeCount) return 'p';
            var n = sel.getRangeAt(0).commonAncestorContainer;
            if (n.nodeType === 3) n = n.parentNode;
            while (n && n !== body) {
                if (n.nodeName && /^(P|H1|H2|H3|H4|H5|H6|BLOCKQUOTE|LI|DIV)$/i.test(n.nodeName)) {
                    return n.nodeName.toLowerCase();
                }
                n = n.parentNode;
            }
        } catch (e) { }
        return 'p';
    }

    /* نگاشت بلاک فعلی به گزینه‌های قابل انتخاب نوار (p/h2/h3) */
    function mapToSelect(raw) {
        if (raw === 'h1' || raw === 'h2') return 'h2';
        if (raw === 'h3' || raw === 'h4' || raw === 'h5' || raw === 'h6') return 'h3';
        return 'p';
    }

    function refreshToolbar() {
        if (sourceMode || !body) return;
        var states = { bold: 'bold', italic: 'italic', underline: 'underline', strikeThrough: 'strikeThrough' };
        root.querySelectorAll('button[data-cmd]').forEach(function (btn) {
            var cmd = btn.getAttribute('data-cmd');
            var active = false;
            if (states[cmd]) {
                try { active = document.queryCommandState(cmd); } catch (e) { }
            } else if (cmd === 'insertUnorderedList' || cmd === 'insertOrderedList') {
                try { active = document.queryCommandState(cmd); } catch (e) { }
            } else if (cmd === 'formatBlock' && btn.dataset.value === 'blockquote') {
                try { active = currentBlockTag() === 'blockquote'; } catch (e) { }
            }
            btn.classList.toggle('active', !!active);
        });
        if (blockSel) blockSel.value = mapToSelect(currentBlockTag());
    }
    body.addEventListener('keyup', refreshToolbar);
    body.addEventListener('mouseup', refreshToolbar);
    body.addEventListener('input', refreshToolbar);
    document.addEventListener('selectionchange', refreshToolbar);

    function execCmd(cmd, value) {
        if (sourceMode) return;
        focusBody();
        try { document.execCommand(cmd, false, value || null); } catch (e) { }
        body.focus();
        refreshToolbar();
    }

    root.querySelectorAll('button[data-cmd]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var cmd = btn.getAttribute('data-cmd');
            var val = btn.getAttribute('data-value') || undefined;
            if (cmd === 'formatBlock' && val) {
                execCmd('formatBlock', '<' + val + '>');
            } else {
                execCmd(cmd, val);
            }
            hideLinkPanel();
        });
    });

    if (blockSel) {
        blockSel.addEventListener('change', function () {
            execCmd('formatBlock', '<' + blockSel.value + '>');
            body.focus();
        });
    }

    function getContent() {
        if (sourceMode) return source.value;
        var h = body.innerHTML || '';
        if (h && !body.querySelector('img') && !(body.innerText || '').trim()) return '';
        return h;
    }
    function syncHidden() { if (hidden) hidden.value = getContent(); }

    function setSourceMode(on) {
        sourceMode = on;
        if (on) {
            source.value = body.innerHTML;
            body.classList.add('d-none');
            source.classList.remove('d-none');
            htmlBtn.classList.add('active');
            htmlBtn.title = 'بازگشت به ویرایشگر بصری';
        } else {
            body.innerHTML = source.value;
            source.classList.add('d-none');
            body.classList.remove('d-none');
            htmlBtn.classList.remove('active');
            htmlBtn.title = 'ویرایش کد HTML';
            refreshToolbar();
        }
        root.querySelectorAll('.rich-btn[data-cmd], #richBlockSel, #richLinkBtn, #richImageBtn').forEach(function (el) {
            if (el !== htmlBtn) el.disabled = on;
        });
        if (on) hideLinkPanel();
    }

    if (htmlBtn) htmlBtn.addEventListener('click', function () { setSourceMode(!sourceMode); syncHidden(); });

    var form = root.closest('form');
    if (form) form.addEventListener('submit', function () { syncHidden(); });
    window.addEventListener('beforeunload', syncHidden);

    /* ---------- لینک ---------- */
    function normalizeUrl(v) {
        v = (v || '').trim();
        if (!v) return '';
        if (/^(https?:|mailto:|tel:|#|\/)/i.test(v)) return v;
        return 'https://' + v;
    }
    function showLinkPanel() {
        if (sourceMode) return;
        saveSelection();
        linkPanel.classList.remove('d-none');
        linkUrl.value = '';
        linkUrl.focus();
    }
    function hideLinkPanel() {
        if (linkPanel) linkPanel.classList.add('d-none');
    }
    document.getElementById('richLinkBtn').addEventListener('click', function (e) {
        e.preventDefault();
        if (linkPanel.classList.contains('d-none')) showLinkPanel(); else hideLinkPanel();
    });
    document.getElementById('richLinkClose').addEventListener('click', hideLinkPanel);
    document.getElementById('richLinkApply').addEventListener('click', function () {
        var url = normalizeUrl(linkUrl.value);
        if (!url) { linkUrl.focus(); return; }
        execCmd('createLink', url);
        hideLinkPanel();
        syncHidden();
    });
    document.getElementById('richLinkUnlink').addEventListener('click', function () {
        execCmd('unlink');
        hideLinkPanel();
    });
    linkUrl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') document.getElementById('richLinkApply').click();
        if (e.key === 'Escape') hideLinkPanel();
    });

    /* ---------- تصویر از کتابخانه رسانه ---------- */
    document.getElementById('richImageBtn').addEventListener('click', function () {
        saveSelection();
        /* اگر جایی از سند انتخاب نبود، مکان‌نما به انتهای متن برود */
        if (!savedRange) {
            body.focus();
            var sel = window.getSelection();
            var r = document.createRange();
            r.selectNodeContents(body);
            r.collapse(false);
            sel.removeAllRanges();
            sel.addRange(r);
            savedRange = r.cloneRange();
        }
    });
    function onDraftPicked() {
        var url = draft ? (draft.value || '').trim() : '';
        if (draft) draft.value = '';
        if (!url || sourceMode) return;
        focusBody();
        try { document.execCommand('insertImage', false, url); } catch (e) { }
        body.focus();
        refreshToolbar();
        syncHidden();
    }
    if (draft) {
        draft.addEventListener('input', onDraftPicked);
        draft.addEventListener('change', onDraftPicked);
    }

    /* ---------- چسباندن امن ---------- */
    function blockImagePaste(e) {
        var items = (e.clipboardData && e.clipboardData.items) || [];
        var hasImage = Array.prototype.some.call(items, function (it) {
            return it.type && it.type.indexOf('image') === 0;
        });
        if (!hasImage) return false;
        e.preventDefault();
        if (window.Swal) {
            Swal.fire({ icon: 'warning', title: 'چسباندن تصویر', text: 'برای افزودن تصویر به مقاله از دکمه «تصویر» در نوار ابزار و کتابخانه رسانه استفاده کنید.' });
        }
        return true;
    }
    body.addEventListener('paste', function (e) {
        if (blockImagePaste(e)) return;
        var html = e.clipboardData && e.clipboardData.getData('text/html');
        var plain = e.clipboardData && e.clipboardData.getData('text/plain');
        if (!html || !plain) return; /* متن ساده: رفتار پیش‌فرض */
        if (!/<\/?(p|div|h[1-6]|ul|ol|li|strong|b|em|i|u|s|br|img|blockquote|table|tr|td|th|a)\b/i.test(html)) return;

        e.preventDefault();
        /* پاک‌سازی سبک سمت کلاینت: حذف تگ‌ها و ویژگی‌های خطرناک */
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        tmp.querySelectorAll('script,style,iframe,object,embed,link,meta,form,input,button').forEach(function (n) { n.remove(); });
        tmp.querySelectorAll('*').forEach(function (n) {
            [].slice.call(n.attributes || []).forEach(function (a) {
                var an = a.name.toLowerCase();
                if (an.indexOf('on') === 0 || an === 'style' || an === 'class' || an === 'id') n.removeAttribute(a.name);
            });
        });
        focusBody();
        try { document.execCommand('insertHTML', false, tmp.innerHTML); } catch (e) { }
        syncHidden();
    });

    /* جلوگیری از انداختن تصویر روی ویرایشگر */
    body.addEventListener('dragover', function (e) { e.preventDefault(); });
    body.addEventListener('drop', function (e) {
        var hasFile = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0;
        if (hasFile) { e.preventDefault(); blockImagePaste(e); }
    });

    /* مقدار اولیه فیلد پنهان = همان محتوای نمایشی */
    if (hidden && !hidden.value) hidden.value = body.innerHTML;
})();
</script>
