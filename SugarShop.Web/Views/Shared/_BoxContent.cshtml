@using SugarShop.Web.SessionModels
@using SugarShop.Web.Extensions
@model BoxSessionState
@{
    var selectedBox = ViewBag.SelectedBoxType as SugarShop.Domain.Entities.BoxType;
    var boxTypes = ViewBag.BoxTypes as List<SugarShop.Domain.Entities.BoxType>;
    var sweetItems = ViewBag.SweetItems as List<SugarShop.Domain.Entities.SweetItem>;
    var maxRows = selectedBox?.MaxRows ?? 0;
    var capacity = selectedBox?.CapacityGrams ?? 0;
    var totalRows = Model.TotalRowsUsed;
    var totalWeight = Model.TotalApproxWeightGrams;
}
<div class="box-panel-wrapper">
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-gradient-primary text-white border-0 py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-box-seam"></i> 📦 جعبه شیرینی
            </h5>
        </div>
        <div class="card-body p-3 p-md-4">
            <div class="row g-4">
                <div class="col-12 col-md-5">
                    <h6 class="fw-bold mb-3"><i class="bi bi-cake2 text-warning"></i> انتخاب جعبه</h6>
                    @if (boxTypes != null && boxTypes.Any())
                    {
                        foreach (var box in boxTypes)
                        {
                            var isActive = selectedBox?.Id == box.Id;
                            <div class="d-flex align-items-center p-3 mb-2 border rounded-3 @(isActive ? "bg-warning bg-opacity-10 border-warning" : "bg-white")">
                                <div class="flex-shrink-0 me-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:48px; height:48px; background:#fef0db;">
                                        <i class="bi bi-gift-fill text-warning" style="font-size:1.5rem;"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">@box.TitleFa</div>
                                    <div class="text-secondary small">
                                        <span><i class="bi bi-egg-fried"></i> @box.CapacityGrams.ToPersianNumber() گرم</span>
                                        <span class="mx-1">•</span>
                                        <span><i class="bi bi-layout-three-columns"></i> @box.MaxRows.ToPersianNumber() ردیف</span>
                                    </div>
                                </div>
                                <div class="ms-2">
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill"></i> انتخاب شده
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-warning rounded-pill px-3 btn-select-box" data-box-id="@box.Id">
                                            <i class="bi bi-check-lg"></i> انتخاب
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">هیچ جعبه‌ای تعریف نشده است.</div>
                    }
                </div>
                <div class="col-12 col-md-7">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-grid-3x3-gap-fill fs-5 text-warning"></i>
                        <h6 class="fw-bold mb-0">محتویات جعبه</h6>
                        <span class="badge bg-secondary rounded-pill ms-auto">@totalRows از @maxRows ردیف</span>
                    </div>
                    <div class="bg-light p-3 rounded-4 border border-warning border-opacity-25" style="min-height:200px; background:#fef9f2;">
                        @if (maxRows > 0)
                        {
                            for (int i = 0; i < maxRows; i++)
                            {
                                var isFilled = i < Model.Items.Count;
                                var item = isFilled ? Model.Items[i] : null;
                                var sweetItem = isFilled ? sweetItems?.FirstOrDefault(s => s.Id == item.SweetItemId) : null;
                                var imagePath = sweetItem?.ImagePath ?? "/images/sweets/default.png";
                                <div class="d-flex align-items-center p-2 mb-2 rounded-3 @(isFilled ? "bg-white border border-warning" : "bg-white border border-dashed border-secondary")">
                                    @if (isFilled && item != null)
                                    {
                                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                                            <img src="@imagePath" alt="@item.TitleFaSnapshot" class="rounded-circle" style="width:36px; height:36px; object-fit:cover; border:2px solid #d4a056;" />
                                            <span class="fw-semibold text-truncate" style="font-size:0.9rem;">@item.TitleFaSnapshot</span>
                                        </div>
                                        <div class="d-flex gap-1">
                                            @for (int j = 0; j < 3; j++)
                                            {
                                                <img src="@imagePath" alt="" class="rounded-circle" style="width:24px; height:24px; object-fit:cover; border:1px solid #d4a056; opacity:0.8;" />
                                            }
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill ms-2 remove-row" data-row-index="@i">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted w-100 text-center">ردیف خالی</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                لطفاً ابتدا یک جعبه انتخاب کنید.
                            </div>
                        }
                    </div>
                    <div class="row mt-3 g-2">
                        <div class="col-6">
                            <div class="d-flex align-items-center p-2 bg-white rounded-3 border shadow-sm">
                                <div class="text-warning me-2" style="font-size:1.8rem;"><i class="bi bi-layout-three-columns"></i></div>
                                <div class="flex-grow-1">
                                    <small class="text-secondary">ردیف‌ها</small>
                                    <div class="fw-bold fs-5">@totalRows <span class="text-secondary">/ @maxRows</span></div>
                                    <div class="progress" style="height:4px;">
                                        <div class="progress-bar bg-warning" style="width: @(maxRows > 0 ? (totalRows * 100 / maxRows) : 0)%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center p-2 bg-white rounded-3 border shadow-sm">
                                <div class="text-warning me-2" style="font-size:1.8rem;"><i class="bi bi-egg-fried"></i></div>
                                <div class="flex-grow-1">
                                    <small class="text-secondary">وزن تقریبی</small>
                                    <div class="fw-bold fs-5">@totalWeight <span class="text-secondary">/ @capacity گرم</span></div>
                                    <div class="progress" style="height:4px;">
                                        <div class="progress-bar bg-success" style="width: @(capacity > 0 ? (totalWeight * 100 / capacity) : 0)%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button id="clearBoxBtn" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-trash"></i> خالی کردن
                        </button>
                        <button id="changeBoxBtn" class="btn btn-outline-warning rounded-pill px-4">
                            <i class="bi bi-arrow-repeat"></i> تغییر جعبه
                        </button>
                        <button id="addToCartFromBox" class="btn btn-success rounded-pill px-4 ms-md-auto">
                            <i class="bi bi-cart-plus"></i> افزودن به سبد خرید
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
