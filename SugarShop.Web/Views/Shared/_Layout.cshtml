<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/lib/persian-date/persian-date.js"></script>
<script src="~/lib/persian-datepicker/js/persian-datepicker.js"></script>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
<script>
    function updateCartBadge() {
        $.get('/Cart/GetCartState', function(data) {
            if (data.totalItems > 0) {
                $('#cartBadge').text(data.totalItems).show();
            } else {
                $('#cartBadge').hide();
            }
        });
    }
    setInterval(updateCartBadge, 5000);
    updateCartBadge();
    function adjustLayout() {
        var header = document.querySelector('.navbar');
        var footer = document.querySelector('footer');
        @if (applyTransparentOverlay)
        {
            <text>
            // در صفحه اصلی با هدر شفاف، padding-top را صفر نگه می‌داریم
            document.body.style.paddingTop = '0';
            </text>
        }
        else
        {
            <text>
            if (header && (getComputedStyle(header).position === 'fixed' || getComputedStyle(header).position === 'sticky')) {
                var newPadding = header.offsetHeight + 'px';
                if (document.body.style.paddingTop !== newPadding) {
                    document.body.style.paddingTop = newPadding;
                }
            } else {
                if (document.body.style.paddingTop !== '0') {
                    document.body.style.paddingTop = '0';
                }
            }
            </text>
        }
        if (footer && (getComputedStyle(footer).position === 'fixed' || getComputedStyle(footer).position === 'sticky')) {
            document.body.style.paddingBottom = footer.offsetHeight + 'px';
        } else {
            document.body.style.paddingBottom = '0';
        }
    }
    // اجرای اولیه بلافاصله بعد از بارگذاری هدر (درون اسکریپت بالایی انجام شد)
    // اما در صورت تغییر سایز پنجره، دوباره اجرا کن
    window.addEventListener('resize', adjustLayout);
    // همچنین برای اطمینان از تغییرات داینامیک (مثل لود فونت)
    window.addEventListener('load', adjustLayout);
    // فعال‌سازی Tooltip برای تمام المان‌هایی که data-bs-toggle="tooltip" دارند
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });
</script>
</body>
</html>
