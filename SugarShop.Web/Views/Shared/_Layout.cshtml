@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SugarShop.Domain.Entities
@using MD.PersianDateTime
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject SugarShop.Infrastructure.Persistence.Sales.SugarShopSalesDbContext DbContext
@using SugarShop.Web.ViewModels
@{
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = user != null && await UserManager.IsInRoleAsync(user, "Admin");
    var isOrderManager = user != null && await UserManager.IsInRoleAsync(user, "OrderManager");
    var isChef = user != null && await UserManager.IsInRoleAsync(user, "Chef");
    var isNormalUser = user != null && !isAdmin && !isOrderManager && !isChef;
    var siteSettings = await DbContext.SiteSettings.FirstOrDefaultAsync();
    if (siteSettings != null)
    {
        ViewData["Title"] = string.IsNullOrEmpty(siteSettings.SiteTitle) ? "SugarShop" : siteSettings.SiteTitle;
        ViewData["Description"] = siteSettings.SiteDescription;
        if (!string.IsNullOrEmpty(siteSettings.FaviconPath))
        {
            <link rel="icon" type="image/x-icon" href="@siteSettings.FaviconPath">
        }
    }
    var theme = await DbContext.ThemeSettings.OrderByDescending(t => t.Id).FirstOrDefaultAsync() ?? new ThemeSetting();
    var isHeaderTransparent = theme.HeaderTransparency < 100; 
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isHomePage = currentController == "Home" && currentAction == "Index";
    bool applyTransparentOverlay = isHeaderTransparent && isHomePage;
    var headerMenu = await DbContext.MenuItems
        .Where(m => m.Location == "header" && m.IsActive)
        .OrderBy(m => m.Order)
        .ToListAsync();
    var footerMenu = await DbContext.MenuItems
        .Where(m => m.Location == "footer" && m.IsActive)
        .OrderBy(m => m.Order)
        .ToListAsync();
}
@functions {
    private string HexToRgb(string hex)
    {
        if (string.IsNullOrEmpty(hex)) return "255,255,255";
        hex = hex.TrimStart('#');
        if (hex.Length == 3)
        {
            hex = new string(new char[] { hex[0], hex[0], hex[1], hex[1], hex[2], hex[2] });
        }
        if (hex.Length != 6) return "255,255,255";
        int r = Convert.ToInt32(hex.Substring(0, 2), 16);
        int g = Convert.ToInt32(hex.Substring(2, 2), 16);
        int b = Convert.ToInt32(hex.Substring(4, 2), 16);
        return $"{r},{g},{b}";
    }
}
