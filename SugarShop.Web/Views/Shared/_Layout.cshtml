<body class="@(theme.BodyDotPatternEnabled ? "dot-grid-bg" : "")" style="background-color: @theme.BodyBgColor; color: @theme.BodyTextColor;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    @if (siteSettings != null && !string.IsNullOrEmpty(siteSettings.LogoPath))
                    {
                        <img src="@siteSettings.LogoPath"
                             alt="@siteSettings.SiteTitle"
                             class="site-logo" />
                    }
                    <span class="site-title">
                        @(siteSettings?.SiteTitle ?? "SugarShop")
                    </span>
                </a>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                                @foreach (var menuItem in headerMenu)
                        {
                            var absoluteUrl = menuItem.Url.StartsWith("/") ? menuItem.Url : "/" + menuItem.Url;
                            <li class="nav-item">
                                <a class="nav-link" href="@absoluteUrl">
                                    @if (!string.IsNullOrEmpty(menuItem.Icon)) { <span class="ms-1">@menuItem.Icon</span> }
                                    @menuItem.Title
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                🛒 سبد خرید
                                <span id="cartBadge" class="badge bg-danger rounded-pill" style="display:none;">0</span>
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            <li class="nav-item">
                                <div class="user-info-wrapper">
                                    @if (!string.IsNullOrEmpty(currentUser?.AvatarPath))
                                    {
                                        <img src="@currentUser.AvatarPath" class="user-avatar" alt="آواتار" />
                                    }
                                    else
                                    {
                                        <span>👤</span>
                                    }
                                    <a asp-controller="Profile" asp-action="Index"
                                       class="user-name-link"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="bottom"
                                       title="ورود به داشبورد کاربری">
                                       @(currentUser?.FullName ?? currentUser?.UserName ?? "کاربر")
                
                                    </a>
                                    @if (isChef)
                                    {
                                        <a asp-controller="Chef" asp-action="Index"
                                           class="d-block text-center text-decoration-none small fw-bold mt-1"
                                           style="font-size: 0.78rem; color: #d97706; border: 1px solid #d97706; border-radius: 1rem; padding: 1px 10px;"
                                           title="ورود به داشبورد سرآشپز">
                                           🧑‍🍳 پنل سرآشپز
                                        </a>
                                    }
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="logout-btn">🚪 خروج</button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">ورود / ثبت‌نام</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <script>
    (function() {
        // فقط در صفحات غیر از صفحه اصلی و در صورت عدم اعمال حالت شفاف مطلق
        @if (!applyTransparentOverlay)
        {
            <text>
            var header = document.querySelector('.navbar');
            if (header) {
                var headerHeight = header.offsetHeight;
                document.body.style.paddingTop = headerHeight + 'px';
            }
            </text>
        }
    })();
</script>
