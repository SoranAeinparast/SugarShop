            <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.15); width: 100vw; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%);">
    
            <div class="footer-bottom py-3">
                <div class="container">
