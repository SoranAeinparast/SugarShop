@using SugarShop.Domain.Entities
@model SugarShop.Domain.Entities.ThemeSetting
@{
    ViewData["Title"] = "تنظیمات ظاهری و پایه سایت";
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-header">
        <h4>🎨 تنظیمات ظاهری و پایه سایت</h4>
    </div>
    <div class="card-body">
        <div id="message" class="alert" style="display:none;"></div>
        
        <!-- تب‌ها -->
        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="appearance-tab" data-bs-toggle="tab" data-bs-target="#appearance" type="button" role="tab">🎨 تنظیمات ظاهری</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab">⚙️ تنظیمات پایه</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="app-tab" data-bs-toggle="tab" data-bs-target="#app" type="button" role="tab">📱 تنظیمات اپلیکیشن</button>
            </li>
        </ul>
        
        <div class="tab-content">
            <!-- تب تنظیمات ظاهری -->
            <div class="tab-pane fade show active" id="appearance" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">رنگ اصلی</label>
                            <input type="color" id="PrimaryColor" class="form-control form-control-color" value="@Model.PrimaryColor" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رنگ ثانویه</label>
                            <input type="color" id="SecondaryColor" class="form-control form-control-color" value="@Model.SecondaryColor" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رنگ پس‌زمینه هدر</label>
                            <input type="color" id="HeaderBgColor" class="form-control form-control-color" value="@Model.HeaderBgColor" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رنگ متن هدر</label>
                            <input type="color" id="HeaderTextColor" class="form-control form-control-color" value="@Model.HeaderTextColor" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">نوع هدر</label>
                            <select id="HeaderType" class="form-select">
                                <option value="0" selected="@(Model.HeaderType == HeaderType.Normal ? "selected" : null)">Normal — معمولی (همراه صفحه اسکرول می‌شود)</option>
                                <option value="1" selected="@(Model.HeaderType == HeaderType.Sticky ? "selected" : null)">Sticky — چسبنده (هنگام اسکرول بالای صفحه می‌ماند)</option>
                                <option value="2" selected="@(Model.HeaderType == HeaderType.Fixed ? "selected" : null)">Fixed — ثابت (همیشه روی صفحه شناور است)</option>
                            </select>
                            <small class="text-muted d-block mt-1">
                                نکته: حالت شفافیت هدر در صفحه اصلی فقط با نوع «معمولی» به‌صورت شناور روی اسلایدر اعمال می‌شود؛ در حالت‌های Sticky و Fixed هدر همیشه بالای صفحه می‌ماند.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">شفافیت هدر (درصد)</label>
                            <input type="range" id="HeaderTransparency" min="0" max="100" class="form-range" value="@Model.HeaderTransparency" />
                            <span id="headerTransparencyValue">@Model.HeaderTransparency</span>%
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">رنگ پس‌زمینه فوتر</label>
                            <input type="color" id="FooterBgColor" class="form-control form-control-color" value="@Model.FooterBgColor" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رنگ متن فوتر</label>
                            <input type="color" id="FooterTextColor" class="form-control form-control-color" value="@Model.FooterTextColor" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">نوع فوتر</label>
                            <select id="FooterType" class="form-select">
                                <option value="0" selected="@(Model.FooterType == FooterType.Normal ? "selected" : null)">Normal — معمولی (در انتهای صفحه)</option>
                                <option value="1" selected="@(Model.FooterType == FooterType.Sticky ? "selected" : null)">Sticky — چسبنده (موقع اسکرول پایین صفحه دیده می‌شود)</option>
                                <option value="2" selected="@(Model.FooterType == FooterType.Fixed ? "selected" : null)">Fixed — ثابت (همیشه پایین صفحه شناور است)</option>
                            </select>
                            <small class="text-muted d-block mt-1">
                                نکته: در حالت Fixed، فوتر روی محتوای صفحه شناور می‌ماند و فضای لازم به‌صورت خودکار رزرو می‌شود.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">شفافیت فوتر (درصد)</label>
                            <input type="range" id="FooterTransparency" min="0" max="100" class="form-range" value="@Model.FooterTransparency" />
                            <span id="footerTransparencyValue">@Model.FooterTransparency</span>%
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رنگ پس‌زمینه صفحه</label>
                            <input type="color" id="BodyBgColor" class="form-control form-control-color" value="@Model.BodyBgColor" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رنگ متن اصلی</label>
                            <input type="color" id="BodyTextColor" class="form-control form-control-color" value="@Model.BodyTextColor" />
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="BodyDotPatternEnabled" @(Model.BodyDotPatternEnabled ? "checked" : "") />
                            <label class="form-check-label" for="BodyDotPatternEnabled">دارای هاشور نقطه‌ای</label>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- ✅ تب کامل تنظیمات پایه -->
            <div class="tab-pane fade" id="basic" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">عنوان سایت</label>
                            <input type="text" id="SiteTitleInput" class="form-control" value="@ViewBag.SiteTitle" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">توضیحات متای سایت (برای سئو)</label>
                            <textarea id="SiteDescriptionInput" class="form-control" rows="3">@ViewBag.SiteDescription</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">تلفن</label>
                            <input type="text" id="PhoneInput" class="form-control" value="@ViewBag.Phone" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ایمیل</label>
                            <input type="email" id="EmailInput" class="form-control" value="@ViewBag.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">آدرس</label>
                            <textarea id="AddressInput" class="form-control" rows="3">@ViewBag.Address</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ساعات کاری</label>
                            <input type="text" id="WorkingHoursInput" class="form-control" value="@ViewBag.WorkingHours" placeholder="مثال: شنبه تا پنجشنبه ۹ تا ۱" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">لوگو</label>
                            <input type="hidden" name="LogoPath" id="LogoPath" value="@ViewBag.LogoPath" />
                            <img id="logoPreview" src="@ViewBag.LogoPath" class="img-thumbnail mb-1" style="max-width:150px; @(string.IsNullOrEmpty(ViewBag.LogoPath) ? "display:none;" : "")" />
                            <button type="button" class="btn btn-sm btn-outline-primary open-media-picker" data-target="#LogoPath" data-preview="#logoPreview"><i class="bi bi-image"></i> انتخاب از کتابخانه</button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Favicon (آیکون مرورگر)</label>
                            <input type="hidden" name="FaviconPath" id="FaviconPath" value="@ViewBag.FaviconPath" />
                            <img id="faviconPreview" src="@ViewBag.FaviconPath" class="img-thumbnail mb-1" style="max-width:64px; @(string.IsNullOrEmpty(ViewBag.FaviconPath) ? "display:none;" : "")" />
                            <button type="button" class="btn btn-sm btn-outline-primary open-media-picker" data-target="#FaviconPath" data-preview="#faviconPreview"><i class="bi bi-image"></i> انتخاب از کتابخانه</button>
                        </div>
                        <hr />
                        <h6>شبکه‌های اجتماعی</h6>
                        <div class="mb-3">
                            <label class="form-label">اینستاگرام</label>
                            <input type="url" id="InstagramUrlInput" class="form-control" value="@ViewBag.InstagramUrl" placeholder="https://instagram.com/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">تلگرام</label>
                            <input type="url" id="TelegramUrlInput" class="form-control" value="@ViewBag.TelegramUrl" placeholder="https://t.me/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">واتساپ</label>
                            <input type="url" id="WhatsAppUrlInput" class="form-control" value="@ViewBag.WhatsAppUrl" placeholder="https://wa.me/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">بله</label>
                            <input type="url" id="BaleUrlInput" class="form-control" value="@ViewBag.BaleUrl" placeholder="https://bale.ai/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">روبیکا</label>
                            <input type="url" id="RubikaUrlInput" class="form-control" value="@ViewBag.RubikaUrl" placeholder="https://rubika.ir/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ایتا</label>
                            <input type="url" id="EitaaUrlInput" class="form-control" value="@ViewBag.EitaaUrl" placeholder="https://eitaa.com/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">سروش</label>
                            <input type="url" id="SoroushUrlInput" class="form-control" value="@ViewBag.SoroushUrl" placeholder="https://sapp.ir/..." />
                        </div>
                        <hr />
                        <div class="mb-3">
                            <div class="alert alert-light border d-flex align-items-center justify-content-between mb-0">
                                <div>
                                    <i class="bi bi-award text-primary me-2"></i>
                                    <span class="fw-bold">گواهینامه‌ها (نمادها)</span>
                                    <small class="d-block text-muted">مدیریت نمادها با ویرایشگر بصری و بدون کدنویسی انجام می‌شود.</small>
                                </div>
                                <a href="/SiteSettings#social" class="btn btn-sm btn-outline-primary text-nowrap">
                                    <i class="bi bi-gear"></i> مدیریت گواهینامه‌ها
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 📱 تب تنظیمات اپلیکیشن -->
            <div class="tab-pane fade" id="app" role="tabpanel">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    فعال بودن «اپلیکیشن» یعنی: بنر نصب در سایت، لینک‌های دانلود، و صفحه <b>/App/Download</b> نمایش داده می‌شوند.
                    با غیرفعال کردن، همه‌ی این‌ها به‌صورت خودکار از سایت حذف می‌شوند — بدون نیاز به انتشار مجدد.
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3 form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="AppEnabled" @(ViewBag.AppEnabled ? "checked" : "") />
                            <label class="form-check-label fw-bold" for="AppEnabled">ارائه‌ی اپلیکیشن در سایت فعال باشد</label>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="AppAndroidEnabled" @(ViewBag.AppAndroidEnabled ? "checked" : "") />
                            <label class="form-check-label" for="AppAndroidEnabled">نسخه‌ی اندروید (APK) فعال باشد</label>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="AppIosEnabled" @(ViewBag.AppIosEnabled ? "checked" : "") />
                            <label class="form-check-label" for="AppIosEnabled">راهنمای نصب روی iPhone (PWA) فعال باشد</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">نام اپلیکیشن</label>
                            <input type="text" id="AppDisplayName" class="form-control" value="@ViewBag.AppDisplayName" placeholder="خالی = همان نام سایت" />
                            <small class="text-muted d-block mt-1">اگر خالی باشد، اپلیکیشن با نام فعلی سایت (و لوگوی فعلی) شناسایی می‌شود.</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">آدرس پایه‌ی اپلیکیشن</label>
                            <input type="url" id="AppBaseUrl" class="form-control" value="@ViewBag.AppBaseUrl" placeholder="خالی = همان دامنه‌ی فعلی سایت" />
                            <small class="text-muted d-block mt-1">
                                مثال: <code>https://sweets.soransoftpro.ir</code> — صفحه‌ی دانلود، QR کد و لینک‌های اپ همیشه از
                                همین مقدار (یا دامنه‌ی جاری) ساخته می‌شوند؛ پس با تغییر دامنه چیزی از کار نمی‌افتد.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">پیش‌نمایش لینک دانلود</label>
                            <div class="form-control bg-light text-dark" id="appUrlPreview" style="font-size:.85rem"></div>
                        </div>
                        <div class="alert alert-light border">
                            <small>
                                <i class="bi bi-shield-check text-success"></i>
                                <b>نکته‌ی فنی:</b> لوگو، نام و آیکون اپ همیشه از «تنظیمات پایه» همین صفحه پیروی می‌کنند.
                                پس از تغییر لوگو، شورت‌کات‌های جدید روی گوشی به‌طور خودکار با لوگوی جدید ساخته می‌شوند.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <button id="saveBtn" class="btn btn-success mt-4">💾 ذخیره تمام تنظیمات</button>
    </div>
</div>

@section Scripts {
<script>
const headerRange = document.getElementById('HeaderTransparency');
const footerRange = document.getElementById('FooterTransparency');
const headerSpan = document.getElementById('headerTransparencyValue');
const footerSpan = document.getElementById('footerTransparencyValue');
if (headerRange) headerRange.addEventListener('input', () => headerSpan.innerText = headerRange.value);
if (footerRange) footerRange.addEventListener('input', () => footerSpan.innerText = footerRange.value);

// پیش‌نمایش زنده‌ی لینک دانلود اپ
const appBase = document.getElementById('AppBaseUrl');
const appUrlPreview = document.getElementById('appUrlPreview');
function updateAppUrlPreview() {
    if (!appBase || !appUrlPreview) return;
    let b = appBase.value.trim().replace(/\/+$/, '');
    if (b && !b.startsWith('http')) b = 'https://' + b;
    appUrlPreview.textContent = (b || window.location.origin) + '/App/Download';
}
if (appBase) { appBase.addEventListener('input', updateAppUrlPreview); updateAppUrlPreview(); }

const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
    document.querySelector('[name="__RequestVerificationToken"]')?.value;

document.getElementById('saveBtn').addEventListener('click', async function() {
    const btn = this;
    const originalText = btn.innerHTML;
    btn.innerHTML = '⏳ در حال ذخیره...';
    btn.disabled = true;
    
    const formData = new FormData();
    
    // تنظیمات ظاهری
    formData.append('PrimaryColor', document.getElementById('PrimaryColor').value);
    formData.append('SecondaryColor', document.getElementById('SecondaryColor').value);
    formData.append('HeaderBgColor', document.getElementById('HeaderBgColor').value);
    formData.append('HeaderTextColor', document.getElementById('HeaderTextColor').value);
    formData.append('FooterBgColor', document.getElementById('FooterBgColor').value);
    formData.append('FooterTextColor', document.getElementById('FooterTextColor').value);
    formData.append('BodyBgColor', document.getElementById('BodyBgColor').value);
    formData.append('BodyTextColor', document.getElementById('BodyTextColor').value);
    formData.append('HeaderTransparency', parseInt(headerRange?.value || 100));
    formData.append('FooterTransparency', parseInt(footerRange?.value || 100));
    formData.append('HeaderType', parseInt(document.getElementById('HeaderType').value));
    formData.append('FooterType', parseInt(document.getElementById('FooterType').value));
    formData.append('BodyDotPatternEnabled', document.getElementById('BodyDotPatternEnabled').checked);
    
    // ✅ تنظیمات پایه کامل
    formData.append('SiteTitle', document.getElementById('SiteTitleInput').value);
    formData.append('SiteDescription', document.getElementById('SiteDescriptionInput').value);
    formData.append('Phone', document.getElementById('PhoneInput').value);
    formData.append('Email', document.getElementById('EmailInput').value);
    formData.append('Address', document.getElementById('AddressInput').value);
    formData.append('WorkingHours', document.getElementById('WorkingHoursInput').value);
    
    const logoPath = document.getElementById('LogoPath');
    if (logoPath && logoPath.value) formData.append('LogoPath', logoPath.value);
    
    const faviconPath = document.getElementById('FaviconPath');
    if (faviconPath && faviconPath.value) formData.append('FaviconPath', faviconPath.value);
    
    // شبکه‌های اجتماعی
    formData.append('InstagramUrl', document.getElementById('InstagramUrlInput').value);
    formData.append('TelegramUrl', document.getElementById('TelegramUrlInput').value);
    formData.append('WhatsAppUrl', document.getElementById('WhatsAppUrlInput').value);
    formData.append('BaleUrl', document.getElementById('BaleUrlInput').value);
    formData.append('RubikaUrl', document.getElementById('RubikaUrlInput').value);
    formData.append('EitaaUrl', document.getElementById('EitaaUrlInput').value);
    formData.append('SoroushUrl', document.getElementById('SoroushUrlInput').value);
    
    // تنظیمات اپلیکیشن
    formData.append('AppEnabled', document.getElementById('AppEnabled').checked);
    formData.append('AppDisplayName', document.getElementById('AppDisplayName').value);
    formData.append('AppBaseUrl', document.getElementById('AppBaseUrl').value);
    formData.append('AppAndroidEnabled', document.getElementById('AppAndroidEnabled').checked);
    formData.append('AppIosEnabled', document.getElementById('AppIosEnabled').checked);
    
    // گواهینامه‌ها دیگر از این صفحه ارسال نمی‌شوند؛ مدیریت آن‌ها در «تنظیمات سایت» انجام می‌شود
    // تا ذخیره تنظیمات ظاهری، تصادفاً نمادهای ویرایش‌شده را بازنویسی نکند.
    
    try {
        const response = await fetch('/Admin/Theme/SaveJson', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        let result;
        const contentType = response.headers.get("content-type");
        if (contentType && contentType.indexOf("application/json") !== -1) {
            result = await response.json();
        } else {
            result = { success: response.ok, message: await response.text() };
        }
        
        const msgDiv = document.getElementById('message');
        msgDiv.style.display = 'block';
        if (result.success) {
            msgDiv.className = 'alert alert-success';
            msgDiv.innerText = result.message || 'تنظیمات با موفقیت ذخیره شد.';
            setTimeout(() => location.reload(), 1500);
        } else {
            msgDiv.className = 'alert alert-danger';
            msgDiv.innerText = result.message || 'خطا در ذخیره تنظیمات.';
        }
    } catch (err) {
        console.error(err);
        const msgDiv = document.getElementById('message');
        msgDiv.style.display = 'block';
        msgDiv.className = 'alert alert-danger';
        msgDiv.innerText = 'خطا در ارتباط با سرور';
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
});
</script>
}