@using SugarShop.Domain.Entities
@model SugarShop.Web.ViewModels.SiteSettingsViewModel
@{
    ViewData["Title"] = "تنظیمات سایت";
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-header">
        <h4>⚙️ تنظیمات جامع سایت</h4>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        <form method="post" asp-area="Admin" asp-controller="SiteSettings" asp-action="Index">
            @Html.AntiForgeryToken()
            <ul class="nav nav-tabs" id="settingsTab" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#general">عمومی</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#appearance">ظاهری (تم)</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#footerContent">فوتر و محتوا</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#socialCert">شبکه‌های اجتماعی و گواهینامه‌ها</button></li>
            </ul>
            <div class="tab-content mt-3">
                <div class="tab-pane fade show active" id="general">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">عنوان سایت</label>
                                <input asp-for="SiteSetting.SiteTitle" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">توضیحات متا</label>
                                <textarea asp-for="SiteSetting.SiteDescription" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">مسیر لوگو</label>
                                <input asp-for="SiteSetting.LogoPath" class="form-control" placeholder="/images/logo.png" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">مسیر Favicon</label>
                                <input asp-for="SiteSetting.FaviconPath" class="form-control" placeholder="/favicon.ico" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">تلفن</label>
                                <input asp-for="SiteSetting.Phone" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ایمیل</label>
                                <input asp-for="SiteSetting.Email" class="form-control" type="email" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">آدرس</label>
                                <input asp-for="SiteSetting.Address" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ساعات کاری</label>
                                <input asp-for="SiteSetting.WorkingHours" class="form-control" placeholder="شنبه تا پنجشنبه ۹ تا ۱۸" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="appearance">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">رنگ اصلی</label>
                                <input asp-for="ThemeSetting.PrimaryColor" type="color" class="form-control form-control-color" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">رنگ ثانویه</label>
                                <input asp-for="ThemeSetting.SecondaryColor" type="color" class="form-control form-control-color" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">رنگ پس‌زمینه هدر</label>
                                <input asp-for="ThemeSetting.HeaderBgColor" type="color" class="form-control form-control-color" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">رنگ متن هدر</label>
                                <input asp-for="ThemeSetting.HeaderTextColor" type="color" class="form-control form-control-color" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">رنگ پس‌زمینه فوتر</label>
                                <input asp-for="ThemeSetting.FooterBgColor" type="color" class="form-control form-control-color" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">رنگ متن فوتر</label>
                                <input asp-for="ThemeSetting.FooterTextColor" type="color" class="form-control form-control-color" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">نوع هدر</label>
                                <select asp-for="ThemeSetting.HeaderType" class="form-select">
                                    <option value="0">Sticky (چسبنده در بالای صفحه)</option>
                                    <option value="1">Fixed (همیشه ثابت در بالا)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">نوع فوتر</label>
                                <select asp-for="ThemeSetting.FooterType" class="form-select">
                                    <option value="0">Normal (معمولی – انتهای صفحه)</option>
                                    <option value="1">Sticky (چسبنده در پایین ویوپورت)</option>
                                    <option value="2">Fixed (همیشه ثابت در پایین)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">شفافیت هدر (درصد)</label>
                                <input asp-for="ThemeSetting.HeaderTransparency" type="range" min="0" max="100" class="form-range" />
                                <span>@Model.ThemeSetting.HeaderTransparency%</span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">شفافیت فوتر (درصد)</label>
                                <input asp-for="ThemeSetting.FooterTransparency" type="range" min="0" max="100" class="form-range" />
                                <span>@Model.ThemeSetting.FooterTransparency%</span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">رنگ پس‌زمینه صفحه</label>
                                <input asp-for="ThemeSetting.BodyBgColor" type="color" class="form-control form-control-color" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">رنگ متن اصلی صفحه</label>
                                <input asp-for="ThemeSetting.BodyTextColor" type="color" class="form-control form-control-color" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="footerContent">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">متن کوتاه درباره فروشگاه (برای فوتر)</label>
                                <textarea asp-for="SiteSetting.AboutShortText" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">لینک‌های سریع (JSON)</label>
                                <textarea asp-for="SiteSetting.QuickLinksJson" class="form-control" rows="4" placeholder='[{"Title":"خانه","Url":"/Home"},{"Title":"محصولات","Url":"/Products"}]'></textarea>
                                <small class="text-muted">فرمت: آرایه‌ای از اشیاء با Title و Url</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">متن کپی‌رایت فوتر</label>
                                <input asp-for="SiteSetting.FooterCopyrightText" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">فرم خبرنامه (به طور خودکار در فوتر نمایش داده می‌شود)</label>
                                <p class="text-muted">این فرم قبلاً در قالب فوتر تعبیه شده و نیازی به تنظیم جداگانه ندارد.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="socialCert">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>شبکه‌های اجتماعی</h5>
                            <div class="mb-3">
                                <label class="form-label">اینستاگرام</label>
                                <input asp-for="SiteSetting.InstagramUrl" class="form-control" placeholder="https://instagram.com/..." />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">تلگرام</label>
                                <input asp-for="SiteSetting.TelegramUrl" class="form-control" placeholder="https://t.me/..." />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">واتساپ</label>
                                <input asp-for="SiteSetting.WhatsAppUrl" class="form-control" placeholder="https://wa.me/..." />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">بله</label>
                                <input asp-for="SiteSetting.baleUrl" class="form-control" placeholder="https://bale.ai/..." />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">روبیکا</label>
                                <input asp-for="SiteSetting.rubikaUrl" class="form-control" placeholder="https://rubika.ir/..." />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ایتا</label>
                                <input asp-for="SiteSetting.eitaaUrl" class="form-control" placeholder="https://eitaa.com/..." />
                            </div><div class="mb-3">
                                <label class="form-label">سروش</label>
                                <input asp-for="SiteSetting.soroushUrl" class="form-control" placeholder="https://sapp.ir/..." />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h5>گواهینامه‌ها (نمادها)</h5>
                            <div class="mb-3">
                                <label class="form-label">گواهینامه‌ها (JSON)</label>
                                <textarea asp-for="SiteSetting.CertificationsJson" class="form-control" rows="5" placeholder='[{"Title":"نماد اعتماد","ImagePath":"/images/eNamad.png","Link":"https://...","Alt":"enamad"}]'></textarea>
                                <small class="text-muted">فرمت: آرایه‌ای از اشیاء با Title, ImagePath, Link (اختیاری), Alt</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-success">💾 ذخیره تمام تنظیمات</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script>
        const headerRange = document.querySelector('input[name="ThemeSetting.HeaderTransparency"]');
        const footerRange = document.querySelector('input[name="ThemeSetting.FooterTransparency"]');
        if (headerRange) {
            headerRange.addEventListener('input', function() {
                this.nextElementSibling.innerText = this.value + '%';
            });
        }
        if (footerRange) {
            footerRange.addEventListener('input', function() {
                this.nextElementSibling.innerText = this.value + '%';
            });
        }
    </script>
}
