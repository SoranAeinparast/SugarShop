@model SugarShop.Domain.Entities.SplashSetting
@{
    ViewData["Title"] = "مدیریت اسپلش ویدئو";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="card">
    <div class="card-header">
        <h4>🎬 مدیریت اسپلش ویدئو</h4>
    </div>
    <div class="card-body">
        <div id="message" class="alert" style="display:none;"></div>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="IsEnabled" @(Model.IsEnabled ? "checked" : "") />
                    <label class="form-check-label fw-bold" for="IsEnabled">
                        @(Model.IsEnabled ? "✅ اسپلش فعال است" : "❌ اسپلش غیرفعال است")
                    </label>
                    <div class="form-text">در صورت فعال بودن، در اولین بازدید هر کاربر، ویدئو نمایش داده می‌شود.</div>
                </div>
                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="IsMuted" @(Model.IsMuted ? "checked" : "") />
                    <label class="form-check-label fw-bold" for="IsMuted">
                        <i class="bi @(Model.IsMuted ? "bi-volume-mute" : "bi-volume-up")"></i>
                        @(Model.IsMuted ? "🔇 پخش بی‌صدا" : "🔊 پخش با صدا")
                    </label>
                    <div class="form-text">
                        <span class="text-warning">⚠️ توجه:</span> مرورگرهای مدرن معمولاً پخش خودکار با صدا را مسدود می‌کنند. 
                        حالت <strong>بی‌صدا</strong> برای پخش خودکار توصیه می‌شود.
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ButtonText">عنوان دکمه</label>
                    <input type="text" id="ButtonText" class="form-control" value="@Model.ButtonText" placeholder="مثلاً: ورود به سایت" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">انتخاب ویدئو</label>
                    <input type="hidden" name="VideoPath" id="VideoPath" value="@Model.VideoPath" />
                    <button type="button" class="btn btn-outline-primary open-media-picker" data-target="#VideoPath" data-preview="#videoPreview"><i class="bi bi-collection-play"></i> انتخاب از کتابخانه رسانه</button>
                    <div class="form-text">فرمت‌های مجاز: MP4 و WEBM</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">ویدئوی فعلی</label>
                    <div class="border rounded-3 p-3 bg-light text-center">
                        @if (!string.IsNullOrEmpty(Model.VideoPath))
                        {
                            <video controls style="max-width: 100%; max-height: 200px; border-radius: 12px;">
                                <source src="@Model.VideoPath" type="video/mp4">
                                مرورگر شما از ویدئو پشتیبانی نمی‌کند.
                            </video>
                            <div class="mt-2">
                                <button id="deleteVideoBtn" class="btn btn-danger btn-sm rounded-pill">
                                    <i class="bi bi-trash"></i> حذف ویدئو
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">ویدئویی انتخاب نشده است.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button id="saveBtn" class="btn btn-success btn-lg px-5">
                <i class="bi bi-save"></i> ذخیره تنظیمات
            </button>
            <a href="/" target="_blank" class="btn btn-secondary btn-lg px-4">
                <i class="bi bi-eye"></i> پیش‌نمایش در سایت
            </a>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        (function() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const messageDiv = document.getElementById('message');
            const saveBtn = document.getElementById('saveBtn');
            const videoPathInput = document.getElementById('VideoPath');
            const deleteVideoBtn = document.getElementById('deleteVideoBtn');

            function showMessage(success, text) {
                messageDiv.style.display = 'block';
                messageDiv.className = success ? 'alert alert-success' : 'alert alert-danger';
                messageDiv.innerText = text;
                messageDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            saveBtn.addEventListener('click', async function() {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> در حال ذخیره...';
                try {
                    const data = {
                        ButtonText: document.getElementById('ButtonText').value,
                        IsEnabled: document.getElementById('IsEnabled').checked,
                        IsMuted: document.getElementById('IsMuted').checked,
                        VideoPath: videoPathInput ? videoPathInput.value : ''
                    };
                    const response = await fetch('/Admin/Splash/SaveJson', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();
                    if (result.success) {
                        showMessage(true, result.message || '✅ تنظیمات با موفقیت ذخیره شد.');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showMessage(false, result.message || '❌ خطا در ذخیره تنظیمات.');
                        saveBtn.disabled = false;
                        saveBtn.innerHTML = '<i class="bi bi-save"></i> ذخیره تنظیمات';
                    }
                } catch (err) {
                    console.error('خطا:', err);
                    showMessage(false, '❌ خطا در ارتباط با سرور. لطفاً دوباره تلاش کنید.');
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="bi bi-save"></i> ذخیره تنظیمات';
                }
            });
            if (deleteVideoBtn) {
                deleteVideoBtn.addEventListener('click', async function() {
                    if (!confirm('آیا از حذف ویدئو مطمئن هستید؟')) return;
                    deleteVideoBtn.disabled = true;
                    deleteVideoBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
                    try {
                        const response = await fetch('/Admin/Splash/DeleteVideo', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            }
                        });
                        const result = await response.json();
                        if (result.success) {
                            showMessage(true, result.message || '🗑️ ویدئو با موفقیت حذف شد.');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showMessage(false, result.message || '❌ خطا در حذف ویدئو.');
                            deleteVideoBtn.disabled = false;
                            deleteVideoBtn.innerHTML = '<i class="bi bi-trash"></i> حذف ویدئو';
                        }
                    } catch (err) {
                        console.error(err);
                        showMessage(false, '❌ خطا در حذف ویدئو.');
                        deleteVideoBtn.disabled = false;
                        deleteVideoBtn.innerHTML = '<i class="bi bi-trash"></i> حذف ویدئو';
                    }
                });
            }
            @if (TempData["Success"] != null)
            {
                <text>
                    showMessage(true, '@TempData["Success"]');
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                    showMessage(false, '@TempData["Error"]');
                </text>
            }
        })();
    </script>
}
