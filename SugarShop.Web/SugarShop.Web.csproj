<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-SugarShop.Web-cede4fcd-e1a9-4a15-ac78-9dfe6f528349</UserSecretsId>
    <!-- MD.PersianDateTime targets .NET Framework; the NU1701 restore fallback is benign on net8.0 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" Version="1.11.0" />
    <PackageReference Include="Hangfire" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="MD.PersianDateTime" Version="4.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.16" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.16" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="8.0.16" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.7" />
    <PackageReference Include="OpenAI" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Areas\Identity\Pages\Account\" />
    <Folder Include="Views\Admin\Theme\" />
    <Folder Include="Views\PaymentSettings\" />
    <Folder Include="wwwroot\fonts\Vazir\" />
    <Folder Include="wwwroot\images\avatars\default\" />
    <Folder Include="wwwroot\images\categories\" />
    <Folder Include="wwwroot\images\certifications\" />
    <Folder Include="wwwroot\images\icons\" />
    <Folder Include="wwwroot\images\products\" />
    <Folder Include="wwwroot\images\sweets\" />
    <Folder Include="wwwroot\images\sliders\" />
    <Folder Include="wwwroot\lib\aos\" />
    <Folder Include="wwwroot\lib\bootstrap-icons\fonts\" />
    <Folder Include="wwwroot\videos\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SugarShop.Application\SugarShop.Application.csproj" />
    <ProjectReference Include="..\SugarShop.Infrastructure\SugarShop.Infrastructure.csproj" />
  </ItemGroup>

</Project>
