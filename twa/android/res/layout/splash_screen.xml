<?xml version="1.0" encoding="utf-8"?>
<!-- اسپلش داخل اپ: لوگوی فروشگاه روی کرم + راهنمای لود؛ تا اولین رندر سایت می‌ماند -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="@string/splash_app_name"
        android:src="@drawable/splash_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/splash_app_name"
        android:textColor="#6D3410"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSplashHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0.65"
        android:text="@string/splash_loading"
        android:textColor="#7A6A5F"
        android:textSize="14sp" />

    <ProgressBar
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="22dp"
        android:indeterminateTint="#B8860B" />

</LinearLayout>
