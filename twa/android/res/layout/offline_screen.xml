<?xml version="1.0" encoding="utf-8"?>
<!-- صفحه‌ی آفلاین اپ — کاملاً بومی اندروید؛ هیچ تغییری در سایت ایجاد نمی‌کند -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offlineScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/offline_title"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/txtOfflineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/offline_title"
        android:textColor="#4E342E"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtOfflineMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/offline_message"
        android:textColor="#7A6A5F"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtErrorDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="#B49A8A"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:minWidth="200dp"
        android:background="@drawable/btn_retry_bg"
        android:text="@string/offline_retry"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/offline_autoretry_hint"
        android:textColor="#B49A8A"
        android:textSize="13sp" />

</LinearLayout>
